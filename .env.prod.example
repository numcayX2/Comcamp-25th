# ==============================================================================
# ComCamp #25 Production Environment (.env.prod)
# คัดลอกไฟล์นี้เป็น .env.prod บนเซิร์ฟเวอร์จริงแล้วเปลี่ยนค่าที่มีคำว่า CHANGE_ME ทั้งหมด
# แนะนำตั้งสิทธิ์ไฟล์: chmod 600 .env.prod (ห้าม commit .env.prod ขึ้น Git เด็ดขาด)
# ==============================================================================

# --- 1. ชื่อโปรเจกต์ Docker (กันชื่อ Volume/Container ชนบนเซิร์ฟเวอร์ที่ใช้ร่วมกันหลายงาน) ---
COMPOSE_PROJECT_NAME=comcamp25

# --- 2. PostgreSQL Database ---
DB_USER=cc25_prod_user
# สร้างรหัสผ่านสุ่ม >= 32 ตัวอักษร เช่น: openssl rand -base64 32
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_AT_LEAST_32_CHARS
DB_NAME=comcamp25_prod
DB_SSLMODE=disable

# --- 3. Go Backend Security & Origin ---
# ต้องมีความยาว >= 32 ตัวอักษร (สร้างด้วย: openssl rand -hex 32)
JWT_SECRET=CHANGE_ME_RANDOM_64_HEX_CHARACTERS_MINIMUM_32_CHARS_REQUIRED

# Public Origin จริงแบบไม่มีเครื่องหมาย / ปิดท้าย (ใช้ตรวจ CORS และ Turnstile Hostname)
FRONTEND_URL=https://comcampdev.csmju.com

# Subnet ของ Bridge Network ภายใน Docker Compose (เปลี่ยนได้หากชนกับวง Docker อื่นบนเครื่องภาควิชา)
APP_NET_SUBNET=172.28.0.0/24

# CIDR ของ Proxy ที่ Backend เชื่อถือในการอ่านหัวอ่าน X-Forwarded-For / X-Real-IP:
# - ต้องตรงกับ APP_NET_SUBNET ด้านบน (เพื่อให้ edge-proxy เชื่อถือได้)
# - หากมี Reverse Proxy ของภาควิชา/คณะอยู่ข้างหน้าและไม่ได้เปิด set_real_ip_from ใน deploy/nginx/edge.conf
#   ให้ใส่ CIDR ของ proxy ข้างหน้าคั่นด้วยลูกน้ำด้วย (เช่น 172.28.0.0/24,10.0.0.0/8 หรือ IP proxy จริง)
#   สำคัญมาก: ถ้าไม่ใส่ ทุกคนจะถูกนับเป็น IP เดียวกันและติด Rate Limit 8 req/min ตอนเที่ยงคืน
TRUSTED_PROXIES=172.28.0.0/24

# --- 4. Cloudflare Turnstile (ห้ามใช้ Dummy Key 1x000...AA ใน Production) ---
# ต้อง gen key จริงของโดเมนให้ตรงกับ FRONTEND_URL บน Cloudflare Dashboard ก่อนสั่ง build/up
TURNSTILE_SECRET_KEY=CHANGE_ME_REPLACE_WITH_REAL_TURNSTILE_SECRET_KEY
PUBLIC_TURNSTILE_SITE_KEY=CHANGE_ME_REPLACE_WITH_REAL_TURNSTILE_SITE_KEY

# --- 5. Frontend Build Args ---
# ใช้ /api เพื่อเรียกผ่าน edge-proxy ใน Origin เดียวกัน (หากเปลี่ยนเป็นโดเมนแยก ต้องอัปเดต CSP connect-src)
PUBLIC_API_URL=/api
# ปรับได้ถ้ามีการย้าย URL ของ Cloudflare Worker แกลเลอรี (หากเปลี่ยนโดเมน ต้องอัปเดต CSP img-src ด้วย)
PUBLIC_GALLERY_BASE_URL=https://comcamp25-gallery.sokulshop5.workers.dev/

# --- 6. Edge Proxy Host Binding ---
# เซิร์ฟเวอร์ภาควิชา (rootless Docker):
# - ใช้ EDGE_BIND_IP=0.0.0.0 (หรือ IP ของ proxy ถ้าอยู่คนละเครื่อง) / ใช้ 127.0.0.1 ถ้า host proxy อยู่เครื่องเดียวกัน
# - พอร์ตยืนยันจากอาจารย์แล้วคือ 6000 (พอร์ต > 1024 ใช้ได้ใน rootless ทันที)
EDGE_BIND_IP=0.0.0.0
EDGE_HTTP_PORT=6000

# --- 7. Confirmation Email (Optional — CS MJU Mailcow SMTP / App Password) ---
# เว้นว่าง SMTP_HOST ไว้ได้หากยังไม่พร้อมส่งเมล (ระบบจะ log no-op และรับสมัครต่อได้ตามปกติ)
# เมื่อได้ App Password จาก mail.csmju.com แล้ว ให้เติม:
#   SMTP_HOST=mail.csmju.com
# (หาก Auth ไม่ผ่านให้ลอง SMTP_USERNAME=comclub · หาก STARTTLS พอร์ต 587 มีปัญหาให้ลอง 465)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=comclub@csmju.com
SMTP_PASSWORD=
SMTP_FROM="ComCamp #25 CS MJU <comclub@csmju.com>"
