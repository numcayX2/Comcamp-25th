{
  "openapi": "3.0.3",
  "info": {
    "title": "ComCamp #25 API Documentation",
    "description": "API Specification for ComCamp #25 (25th Computer Science Camp, Maejo University)\n\nระบบรับสมัครและจัดการค่าย ComCamp 25 ประกอบด้วย:\n- Public Endpoints สำหรับหน้าบ้าน (Countdown, สมัคร, ตรวจสอบสถานะแบบปกปิดข้อมูลส่วนตัว, ยืนยันสิทธิ์, แนบสลิป)\n- Admin Protected Endpoints สำหรับผู้ดูแลระบบบทบาท `admin` (ดูรายชื่อ, ปรับสถานะ, ตรวจสอบสลิป, ตั้งค่าค่าย, ออกจากระบบ)",
    "version": "1.0.0",
    "contact": {
      "name": "ComCamp 25 Technical Team",
      "url": "https://github.com/numcayX2/Comcamp-25th"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/api",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    { "name": "System", "description": "ระบบตรวจสอบความพร้อมและเวลาของเซิร์ฟเวอร์" },
    { "name": "Public Settings", "description": "ข้อมูลการตั้งค่าค่าย กำหนดการ และการซิงค์เวลา" },
    { "name": "Applications", "description": "ระบบรับสมัคร ตรวจสอบสถานะ และยืนยันสิทธิ์" },
    { "name": "Payments", "description": "ระบบอัปโหลดและตรวจสอบสลิปโอนเงิน" },
    { "name": "Admin Auth", "description": "การเข้าสู่ระบบและออกจากระบบสำหรับผู้ดูแลระบบ (บทบาทเดียว: admin)" },
    { "name": "Admin Management", "description": "ระบบจัดการใบสมัคร อนุมัติสลิป และตั้งค่าค่าย (ต้องใช้บทบาท admin)" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health Check",
        "description": "ตรวจสอบสถานะการทำงานของ Go backend API และความพร้อมของฐานข้อมูล (ในโหมด postgres จะตรวจ Ping ฐานข้อมูล)",
        "responses": {
          "200": {
            "description": "Backend พร้อมทำงาน",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": {
                  "status": "healthy",
                  "service": "comcamp25-backend",
                  "mode": "postgres",
                  "time": "2026-11-04T12:00:00Z"
                }
              }
            }
          },
          "503": {
            "description": "ฐานข้อมูลไม่พร้อมใช้งาน (Database Ping ล้มเหลว)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "example": {
                  "status": "unhealthy",
                  "service": "comcamp25-backend",
                  "mode": "postgres",
                  "time": "2026-11-04T12:00:00Z"
                }
              }
            }
          }
        }
      }
    },
    "/settings/public": {
      "get": {
        "tags": ["Public Settings"],
        "summary": "Get Public Camp Settings & Time Sync",
        "description": "ดึงข้อมูลการตั้งค่าค่ายเพื่อซิงค์เวลาเครื่องลูกข่ายกับเวลาจริงของเซิร์ฟเวอร์ และตรวจสอบว่าระบบเปิดรับสมัครอยู่หรือไม่ (`campFee` จะเป็น `null` หากตั้งค่าน้อยกว่าหรือเท่ากับ 0)",
        "responses": {
          "200": {
            "description": "ข้อมูลการตั้งค่าปัจจุบัน",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PublicSettingsResponse" },
                "example": {
                  "serverTime": "2026-11-04T05:00:00Z",
                  "registrationOpenAt": "2026-11-16T00:00:00+07:00",
                  "isOpen": false,
                  "currentCount": 0,
                  "maxCapacity": 30,
                  "campFee": "300",
                  "isCertificateReleased": false
                }
              }
            }
          },
          "500": {
            "description": "ไม่สามารถโหลดข้อมูลการตั้งค่าค่ายได้",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/applications": {
      "post": {
        "tags": ["Applications"],
        "summary": "Submit New Application",
        "description": "ส่งแบบฟอร์มการรับสมัครใหม่ (ตรวจสอบเลขบัตร 13 หลัก, เบอร์โทร 10 หลักขึ้นต้นด้วย 0, ระดับชั้น, ไซส์เสื้อ, อีเมลเมื่อมีการระบุ, ช่วงเวลาเปิดรับสมัคร, และการสมัครซ้ำ)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ApplicationCreateRequest" },
              "example": {
                "fullName": "สมชาย ใจดี",
                "nickname": "ชาย",
                "nationalId": "1509900000000",
                "phone": "0812345678",
                "email": "somchai@example.com",
                "school": "โรงเรียนแม่โจ้วิทยาคม",
                "grade": "ม.5",
                "province": "เชียงใหม่",
                "shirtSize": "L",
                "motivation": "อยากเรียนรู้การเขียนโปรแกรม IoT และต่อวงจรฮาร์ดแวร์จริง"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "ยื่นใบสมัครสำเร็จ ได้รับรหัสใบสมัคร",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApplicationResponse" },
                "example": {
                  "id": "CC25-8A4B2C",
                  "fullName": "สมชาย ใจดี",
                  "nickname": "ชาย",
                  "nationalId": "1509900000000",
                  "phone": "0812345678",
                  "email": "somchai@example.com",
                  "school": "โรงเรียนแม่โจ้วิทยาคม",
                  "grade": "ม.5",
                  "shirtSize": "L",
                  "motivation": "อยากเรียนรู้การเขียนโปรแกรม IoT และต่อวงจรฮาร์ดแวร์จริง",
                  "province": "เชียงใหม่",
                  "status": "PENDING",
                  "attendanceConfirmed": false,
                  "createdAt": "2026-11-16T00:01:23Z"
                }
              }
            }
          },
          "400": {
            "description": "ข้อมูลไม่ถูกต้อง (เช่น เลขบัตรไม่ครบ 13 หลัก, เบอร์โทรผิด, อีเมลไม่ถูกต้อง, ระดับชั้นหรือไซส์เสื้อผิด)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "อยู่นอกช่วงเวลาเปิดรับสมัคร หรือระบบถูกปิดชั่วคราว",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "ข้อมูลซ้ำในระบบ (เลขบัตรประชาชน, เบอร์โทรศัพท์ หรืออีเมลถูกใช้สมัครแล้ว)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "413": {
            "description": "ขนาดคำขอเกิน 1MB",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "429": {
            "description": "ส่งคำขอถี่เกินกว่าอัตราที่กำหนด (Rate limit exceeded)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "เกิดข้อผิดพลาดภายในเซิร์ฟเวอร์",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/applications/status": {
      "get": {
        "tags": ["Applications"],
        "summary": "Query Application Status",
        "description": "ค้นหาใบสมัครและตรวจสอบสถานะด้วยเลขบัตรประชาชน 13 หลัก, เบอร์โทรศัพท์, หรือรหัสใบสมัคร (เช่น CC25-XXXXXX) ข้อมูลส่วนบุคคล (`nationalId`, `phone`, `email`) จะถูกปกปิดบางส่วนในคำตอบสาธารณะ",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "เลขบัตรประชาชน 13 หลัก หรือเบอร์โทร 10 หลัก หรือรหัสใบสมัคร",
            "schema": { "type": "string" },
            "example": "CC25-8A4B2C"
          }
        ],
        "responses": {
          "200": {
            "description": "พบข้อมูลใบสมัคร (ปกปิดข้อมูลส่วนบุคคลบางส่วน)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApplicationResponse" },
                "example": {
                  "id": "CC25-8A4B2C",
                  "fullName": "สมชาย ใจดี",
                  "nickname": "ชาย",
                  "nationalId": "15099******00",
                  "phone": "081****678",
                  "email": "s***@example.com",
                  "school": "โรงเรียนแม่โจ้วิทยาคม",
                  "grade": "ม.5",
                  "shirtSize": "L",
                  "motivation": "อยากเรียนรู้การเขียนโปรแกรม IoT และต่อวงจรฮาร์ดแวร์จริง",
                  "province": "เชียงใหม่",
                  "status": "PASSED",
                  "attendanceConfirmed": false,
                  "slipUrl": "/uploads/slips/CC25-8a4b2c1d2e3f4a5b6c7d8e9f00112233.jpg",
                  "slipStatus": "PENDING",
                  "slipUploadedAt": "2026-11-20T10:15:00Z",
                  "createdAt": "2026-11-16T00:01:23Z",
                  "updatedAt": "2026-11-20T10:15:00Z"
                }
              }
            }
          },
          "400": {
            "description": "ไม่ได้ระบุพารามิเตอร์ q หรือคำค้นหาไม่ถูกต้อง",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "ไม่พบข้อมูลใบสมัคร",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "429": {
            "description": "ส่งคำขอถี่เกินกว่าอัตราที่กำหนด (Rate limit exceeded)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "เกิดข้อผิดพลาดภายในเซิร์ฟเวอร์",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/applications/{id}/confirm": {
      "post": {
        "tags": ["Applications"],
        "summary": "Confirm or Decline Attendance",
        "description": "ยืนยันหรือสละสิทธิ์การเข้าร่วมค่าย (ทำได้เฉพาะผู้สมัครที่มีสถานะ PASSED)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "UUID ของใบสมัคร หรือรหัสใบสมัคร (ไม่สนตัวพิมพ์เล็ก-ใหญ่ เช่น CC25-8A4B2C)",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AttendanceConfirmRequest" },
              "example": { "confirmed": true }
            }
          }
        },
        "responses": {
          "200": {
            "description": "บันทึกการยืนยันสิทธิ์สำเร็จ",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApplicationResponse" }
              }
            }
          },
          "400": {
            "description": "JSON ไม่ถูกต้อง หรือไม่ได้ระบุฟิลด์ confirmed",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "ไม่พบข้อมูลใบสมัคร",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "ไม่สามารถยืนยันสิทธิ์ได้ (สถานะปัจจุบันไม่ใช่ PASSED)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "413": {
            "description": "ขนาดคำขอเกิน 1MB",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "429": {
            "description": "ส่งคำขอถี่เกินกว่าอัตราที่กำหนด (Rate limit exceeded)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "เกิดข้อผิดพลาดภายในเซิร์ฟเวอร์",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/applications/{id}/slip": {
      "post": {
        "tags": ["Payments"],
        "summary": "Upload Payment Slip",
        "description": "อัปโหลดรูปหลักฐานการโอนเงินสำหรับผู้สมัครที่มีสถานะ PASSED (รองรับ JPG, PNG, GIF, WebP ขนาดไม่เกิน 5MB และป้องกันสลิปซ้ำด้วย SHA-256)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "UUID ของใบสมัคร หรือรหัสใบสมัคร (ไม่สนตัวพิมพ์เล็ก-ใหญ่ เช่น CC25-8A4B2C)",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "slip": {
                    "type": "string",
                    "format": "binary",
                    "description": "ไฟล์รูปภาพสลิป (JPG, PNG, GIF, WebP สูงสุด 5MB)"
                  }
                },
                "required": ["slip"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "อัปโหลดสลิปสำเร็จ รอดำเนินการตรวจสอบ",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SlipUploadResponse" },
                "example": {
                  "id": "CC25-8A4B2C",
                  "slipUrl": "/uploads/slips/CC25-8a4b2c1d2e3f4a5b6c7d8e9f00112233.jpg",
                  "status": "PASSED",
                  "message": "อัปโหลดสลิปสำเร็จ รอดำเนินการตรวจสอบโดยเจ้าหน้าที่"
                }
              }
            }
          },
          "400": {
            "description": "ไม่พบไฟล์ในฟิลด์ slip หรือประเภทไฟล์ไม่ถูกต้อง/ไม่ใช่รูปภาพที่ถอดรหัสได้",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "ผู้สมัครถูกปฏิเสธสิทธิ์ (REJECTED)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "ไม่พบข้อมูลใบสมัคร",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "ตรวจพบการใช้รูปสลิปเดิมซ้ำ หรือสถานะผู้สมัครไม่ใช่ PASSED",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "413": {
            "description": "ขนาดไฟล์สลิปเกิน 5MB",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "429": {
            "description": "ส่งคำขอถี่เกินกว่าอัตราที่กำหนด (Rate limit exceeded)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "เกิดข้อผิดพลาดภายในเซิร์ฟเวอร์",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Admin Auth"],
        "summary": "Admin Login",
        "description": "เข้าสู่ระบบผู้ดูแลระบบ (บทบาทเดียว: `admin`) เพื่อรับ JWT Bearer Token (HS256)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": {
                "username": "<admin-username>",
                "password": "<admin-password>"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "เข้าสู่ระบบสำเร็จ ได้รับ JWT Token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" },
                "example": {
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
              }
            }
          },
          "400": {
            "description": "รูปแบบคำขอไม่ถูกต้อง",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "Username หรือ Password ไม่ถูกต้อง หรือบัญชีถูกระงับ",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "413": {
            "description": "ขนาดคำขอเกิน 1MB",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "429": {
            "description": "พยายามเข้าสู่ระบบถี่เกินไป (จำกัด 10 ครั้งต่อนาที)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "ระบบยืนยันตัวตนไม่พร้อมใช้งาน",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Admin Auth"],
        "summary": "Admin Logout",
        "description": "ออกจากระบบและเพิกถอน JWT Token ปัจจุบัน (Revoke by jti)",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "ออกจากระบบสำเร็จ",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "example": { "message": "logged out successfully" }
              }
            }
          },
          "401": {
            "description": "ไม่ได้แนบ Token, Token ไม่ถูกต้อง, หมดอายุ หรือถูกเพิกถอนแล้ว",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "ไม่มีสิทธิ์บทบาท admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/admin/applications": {
      "get": {
        "tags": ["Admin Management"],
        "summary": "Admin List Applications",
        "description": "ดูรายชื่อผู้สมัครทั้งหมดแบบไม่ปกปิด PII พร้อมข้อมูลสลิปล่าสุด (ต้องใช้บทบาท `admin`) หากไม่ระบุ `page` และ `limit` จะคืนค่าเป็นอาเรย์ของใบสมัคร แต่หากระบุ `page` หรือ `limit` จะคืนค่าเป็นอ็อบเจกต์แบ่งหน้า พร้อม header `X-Total-Count`",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "กรองตามสถานะ (PENDING, PASSED, RESERVE, CONFIRMED, REJECTED)",
            "schema": {
              "type": "string",
              "enum": ["PENDING", "PASSED", "RESERVE", "CONFIRMED", "REJECTED"]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "ค้นหาจากรหัสใบสมัคร, ชื่อ-นามสกุล, ชื่อเล่น, โรงเรียน, เลขบัตร, เบอร์โทร หรืออีเมล",
            "schema": { "type": "string" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "หมายเลขหน้า (>= 1)",
            "schema": { "type": "integer", "minimum": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "จำนวนรายการต่อหน้า (1-100, ค่าเริ่มต้น 20 เมื่อเปิดใช้การแบ่งหน้า)",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        ],
        "responses": {
          "200": {
            "description": "รายการผู้สมัคร (อาเรย์ปกติ หรือ PaginatedApplicationsResponse เมื่อระบุ page/limit)",
            "headers": {
              "X-Total-Count": {
                "description": "จำนวนรายการผู้สมัครทั้งหมดที่ตรงตามเงื่อนไข",
                "schema": { "type": "integer" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/ApplicationResponse" }
                    },
                    { "$ref": "#/components/schemas/PaginatedApplicationsResponse" }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "พารามิเตอร์ status, page หรือ limit ไม่ถูกต้อง",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "ไม่มีสิทธิ์เข้าถึง (ไม่ได้แนบ Token, Token หมดอายุ หรือถูกเพิกถอนแล้ว)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "ไม่มีสิทธิ์บทบาท admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "เกิดข้อผิดพลาดภายในเซิร์ฟเวอร์",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/admin/applications/{id}": {
      "patch": {
        "tags": ["Admin Management"],
        "summary": "Admin Update Application Status",
        "description": "ปรับเปลี่ยนสถานะใบสมัครตาม state transition ที่อนุญาต (ไม่อนุญาตให้ข้ามจาก PENDING/RESERVE/REJECTED ไปเป็น CONFIRMED หรือย้อนจาก CONFIRMED กลับเป็น PENDING/RESERVE และตรวจสอบโควตา maxCapacity เมื่อเปลี่ยนเป็น CONFIRMED)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "UUID ของใบสมัคร หรือรหัสใบสมัคร (ไม่สนตัวพิมพ์เล็ก-ใหญ่ เช่น CC25-8A4B2C)",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateStatusRequest" },
              "example": {
                "status": "PASSED",
                "reason": "ผ่านการคัดเลือกการทำแบบทดสอบและพิจารณาเหตุผลความสนใจ"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "อัปเดตสถานะสำเร็จ",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApplicationResponse" }
              }
            }
          },
          "400": {
            "description": "JSON ไม่ถูกต้อง หรือสถานะที่ระบุไม่ถูกต้อง",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "ไม่ได้แนบ Token หรือ Token ไม่ถูกต้อง",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "ไม่มีสิทธิ์บทบาท admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "ไม่พบข้อมูลใบสมัคร",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "ไม่สามารถเปลี่ยนสถานะข้ามขั้นตอนที่ไม่อนุญาต หรือจำนวนผู้ยืนยันสิทธิ์ครบโควตา maxCapacity แล้ว",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "413": {
            "description": "ขนาดคำขอเกิน 1MB",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "เกิดข้อผิดพลาดภายในเซิร์ฟเวอร์",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/admin/applications/{id}/verify-slip": {
      "patch": {
        "tags": ["Admin Management"],
        "summary": "Admin Manual Slip Verification",
        "description": "อนุมัติหรือปฏิเสธสลิปโอนเงินแบบ atomic transaction (หากอนุมัติ สถานะผู้สมัครจะเปลี่ยนเป็น CONFIRMED พร้อมยืนยันการเข้าร่วมและตรวจโควตา maxCapacity; หากปฏิเสธจะบันทึก rejectionReason และคงสถานะ PASSED)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "UUID ของใบสมัคร หรือรหัสใบสมัคร (ไม่สนตัวพิมพ์เล็ก-ใหญ่ เช่น CC25-8A4B2C)",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VerifySlipRequest" },
              "example": {
                "approved": true,
                "note": "ยอดเงินเข้าบัญชี 300 บาท ผ่านธนาคารกรุงไทย ถูกต้องครบถ้วน"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ยืนยันผลการตรวจสลิปเรียบร้อย",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MessageResponse" },
                "example": { "message": "Slip verified successfully" }
              }
            }
          },
          "400": {
            "description": "JSON ไม่ถูกต้อง หรือไม่ได้ระบุฟิลด์ approved",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "ไม่ได้แนบ Token หรือ Token ไม่ถูกต้อง",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "ไม่มีสิทธิ์บทบาท admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "ไม่พบข้อมูลใบสมัคร หรือไม่พบสลิปการชำระเงิน",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "409": {
            "description": "สลิปนี้ถูกตรวจสอบไปแล้ว หรือจำนวนผู้ยืนยันสิทธิ์ครบโควตา maxCapacity แล้ว",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "413": {
            "description": "ขนาดคำขอเกิน 1MB",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "เกิดข้อผิดพลาดภายในเซิร์ฟเวอร์",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/admin/settings": {
      "get": {
        "tags": ["Admin Management"],
        "summary": "Get Admin Settings",
        "description": "ดึงข้อมูลการตั้งค่าค่ายทั้งหมด รวมถึงเวลาเปิด-ปิด โควตา ค่าสมัคร และสถานะระบบ",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "ข้อมูลการตั้งค่าค่าย",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminSettingsResponse" }
              }
            }
          },
          "401": {
            "description": "ไม่ได้แนบ Token หรือ Token ไม่ถูกต้อง",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "ไม่มีสิทธิ์บทบาท admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "ไม่พบข้อมูลการตั้งค่า",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "เกิดข้อผิดพลาดภายในเซิร์ฟเวอร์",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      },
      "patch": {
        "tags": ["Admin Management"],
        "summary": "Update Admin Settings",
        "description": "อัปเดตการตั้งค่าค่าย เช่น ปรับเปลี่ยนโควตารับสมัคร (maxCapacity > 0), วันเปิด-ปิดรับสมัคร (RFC3339 และ registrationOpenAt < registrationCloseAt), ค่าสมัครค่าย (campFee >= 0), หรือสวิตช์ปิดระบบฉุกเฉิน",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateSettingsRequest" },
              "example": {
                "campName": "ComCamp #25",
                "maxCapacity": 50,
                "campFee": "300.00",
                "isManualClosed": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "อัปเดตการตั้งค่าสำเร็จ",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminSettingsResponse" }
              }
            }
          },
          "400": {
            "description": "ข้อมูลการตั้งค่าไม่ถูกต้อง (เช่น รูปแบบเวลาไม่ใช่ RFC3339, วันเปิด >= วันปิด, maxCapacity <= 0, campFee < 0)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "401": {
            "description": "ไม่ได้แนบ Token หรือ Token ไม่ถูกต้อง",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "403": {
            "description": "ไม่มีสิทธิ์บทบาท admin",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "404": {
            "description": "ไม่พบข้อมูลการตั้งค่า",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "413": {
            "description": "ขนาดคำขอเกิน 1MB",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          },
          "500": {
            "description": "เกิดข้อผิดพลาดภายในเซิร์ฟเวอร์",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "ใส่ JWT Bearer Token (HS256, role: admin) ที่ได้รับจาก /api/auth/login"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["healthy", "unhealthy"], "example": "healthy" },
          "service": { "type": "string", "example": "comcamp25-backend" },
          "mode": { "type": "string", "enum": ["postgres", "memory"], "example": "postgres" },
          "time": { "type": "string", "format": "date-time" }
        }
      },
      "PublicSettingsResponse": {
        "type": "object",
        "properties": {
          "serverTime": { "type": "string", "format": "date-time" },
          "registrationOpenAt": { "type": "string", "format": "date-time" },
          "isOpen": { "type": "boolean" },
          "currentCount": { "type": "integer", "example": 15 },
          "maxCapacity": { "type": "integer", "example": 30 },
          "campFee": {
            "type": "string",
            "nullable": true,
            "example": "300",
            "description": "ค่าสมัครค่าย (serialized as decimal string by shopspring/decimal; null when <= 0)"
          },
          "isCertificateReleased": { "type": "boolean", "example": false }
        }
      },
      "ApplicationCreateRequest": {
        "type": "object",
        "required": ["fullName", "nickname", "nationalId", "phone", "school", "grade", "shirtSize"],
        "properties": {
          "fullName": { "type": "string", "maxLength": 200, "example": "สมชาย ใจดี" },
          "nickname": { "type": "string", "maxLength": 50, "example": "ชาย" },
          "nationalId": { "type": "string", "example": "1509900000000", "description": "เลขบัตรประชาชน 13 หลัก" },
          "phone": { "type": "string", "example": "0812345678", "description": "เบอร์โทร 10 หลักขึ้นต้นด้วย 0" },
          "email": { "type": "string", "format": "email", "maxLength": 150, "example": "somchai@example.com", "description": "อีเมล (ไม่บังคับ หากระบุต้องมีรูปแบบถูกต้อง)" },
          "school": { "type": "string", "maxLength": 150, "example": "โรงเรียนแม่โจ้วิทยาคม" },
          "grade": { "type": "string", "enum": ["ม.4", "ม.5", "ม.6", "ปวช.1", "ปวช.2", "ปวช.3"], "example": "ม.5" },
          "shirtSize": { "type": "string", "enum": ["XS", "S", "M", "L", "XL", "2XL", "3XL"], "example": "L" },
          "motivation": { "type": "string", "maxLength": 2000, "example": "อยากเรียนรู้ IoT และเขียนโปรแกรม Arduino" },
          "province": { "type": "string", "maxLength": 100, "example": "เชียงใหม่" }
        }
      },
      "ApplicationResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "CC25-8A4B2C" },
          "fullName": { "type": "string", "example": "สมชาย ใจดี" },
          "nickname": { "type": "string", "example": "ชาย" },
          "nationalId": { "type": "string", "example": "1509900000000", "description": "ใน /applications/status จะถูกปกปิดบางส่วน เช่น 15099******00" },
          "phone": { "type": "string", "example": "0812345678", "description": "ใน /applications/status จะถูกปกปิดบางส่วน เช่น 081****678" },
          "email": { "type": "string", "example": "somchai@example.com", "description": "อาจเป็นค่าว่างเมื่อไม่ระบุอีเมล และใน /applications/status จะถูกปกปิดบางส่วน" },
          "school": { "type": "string", "example": "โรงเรียนแม่โจ้วิทยาคม" },
          "grade": { "type": "string", "example": "ม.5" },
          "shirtSize": { "type": "string", "example": "L" },
          "motivation": { "type": "string" },
          "province": { "type": "string", "example": "เชียงใหม่" },
          "status": {
            "type": "string",
            "enum": ["PENDING", "PASSED", "RESERVE", "CONFIRMED", "REJECTED"],
            "example": "PENDING"
          },
          "attendanceConfirmed": { "type": "boolean", "example": false },
          "slipUrl": { "type": "string", "nullable": true, "example": "/uploads/slips/CC25-8a4b2c1d2e3f4a5b6c7d8e9f00112233.jpg" },
          "slipStatus": {
            "type": "string",
            "nullable": true,
            "enum": ["PENDING", "APPROVED", "REJECTED"],
            "example": "PENDING"
          },
          "slipUploadedAt": { "type": "string", "format": "date-time", "nullable": true },
          "slipVerifiedBy": { "type": "string", "nullable": true, "example": "1" },
          "rejectionReason": { "type": "string", "nullable": true, "example": "ภาพสลิปไม่ชัดเจน กรุณาอัปโหลดใหม่" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "PaginatedApplicationsResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ApplicationResponse" }
          },
          "total": { "type": "integer", "example": 42 },
          "page": { "type": "integer", "example": 1 },
          "limit": { "type": "integer", "example": 20 },
          "totalPages": { "type": "integer", "example": 3 }
        }
      },
      "AttendanceConfirmRequest": {
        "type": "object",
        "required": ["confirmed"],
        "properties": {
          "confirmed": { "type": "boolean", "example": true }
        }
      },
      "SlipUploadResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "CC25-8A4B2C" },
          "slipUrl": { "type": "string", "example": "/uploads/slips/CC25-8a4b2c1d2e3f4a5b6c7d8e9f00112233.jpg" },
          "status": { "type": "string", "example": "PASSED" },
          "message": { "type": "string", "example": "อัปโหลดสลิปสำเร็จ รอดำเนินการตรวจสอบโดยเจ้าหน้าที่" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "<admin-username>" },
          "password": { "type": "string", "format": "password", "example": "<admin-password>" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
        }
      },
      "UpdateStatusRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["PENDING", "PASSED", "RESERVE", "CONFIRMED", "REJECTED"],
            "example": "PASSED"
          },
          "reason": { "type": "string", "example": "คะแนนคัดกรองผ่านเกณฑ์" }
        }
      },
      "VerifySlipRequest": {
        "type": "object",
        "required": ["approved"],
        "properties": {
          "approved": { "type": "boolean", "example": true },
          "note": { "type": "string", "example": "ตรวจสอบยอดเงิน 300 บาท เรียบร้อยแล้ว" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "invalid national ID (must be 13 digits)" }
        }
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "operation completed successfully" }
        }
      },
      "UpdateSettingsRequest": {
        "type": "object",
        "properties": {
          "campName": { "type": "string", "minLength": 1, "maxLength": 150, "example": "ComCamp #25" },
          "registrationOpenAt": { "type": "string", "format": "date-time" },
          "registrationCloseAt": { "type": "string", "format": "date-time" },
          "announcementAt": { "type": "string", "format": "date-time" },
          "paymentOpenAt": { "type": "string", "format": "date-time" },
          "paymentDeadline": { "type": "string", "format": "date-time" },
          "certificateReleaseAt": { "type": "string", "format": "date-time" },
          "maxCapacity": { "type": "integer", "minimum": 1, "example": 50 },
          "campFee": {
            "type": "string",
            "example": "300.00",
            "description": "ค่าสมัครค่าย (decimal string หรือตัวเลข ต้อง >= 0)"
          },
          "isManualClosed": { "type": "boolean", "example": false }
        }
      },
      "AdminSettingsResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "campName": { "type": "string", "example": "ComCamp #25" },
          "registrationOpenAt": { "type": "string", "format": "date-time" },
          "registrationCloseAt": { "type": "string", "format": "date-time" },
          "announcementAt": { "type": "string", "format": "date-time", "nullable": true },
          "paymentOpenAt": { "type": "string", "format": "date-time", "nullable": true },
          "paymentDeadline": { "type": "string", "format": "date-time", "nullable": true },
          "certificateReleaseAt": { "type": "string", "format": "date-time", "nullable": true },
          "maxCapacity": { "type": "integer", "example": 50 },
          "campFee": {
            "type": "string",
            "example": "300",
            "description": "ค่าสมัครค่าย (serialized as decimal string by shopspring/decimal)"
          },
          "isManualClosed": { "type": "boolean", "example": false },
          "updatedByAdminId": { "type": "integer", "format": "int64", "nullable": true, "example": 1 },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
