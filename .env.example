# Application Environment: development | production
APP_ENV=development
PORT=8000
# Set to false in production so database outages fail fast instead of using volatile memory
ALLOW_MEMORY_FALLBACK=true
# Set to false in production unless Swagger/OpenAPI docs are explicitly required
ENABLE_SWAGGER=true

# PostgreSQL Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=comcamp
# REQUIRED in production: replace with a strong random password (e.g. `openssl rand -base64 24`)
DB_PASSWORD=change_this_strong_password
DB_NAME=comcamp_db
DB_SSLMODE=disable

# Security & Auth
# REQUIRED in production: minimum 32 random bytes (e.g. `openssl rand -hex 32`).
# Never reuse example values in production; in development, leaving this empty generates an ephemeral secret.
JWT_SECRET=
# Comma-separated allowed origins for CORS (avoid * when credentials are allowed)
CORS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:3000
FRONTEND_URL=http://localhost:4321

# Initial Admin Seed (used when the admins table is empty)
# REQUIRED in production before first boot if no admin exists yet; use a strong unique password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Storage & Frontend Public URL
UPLOAD_DIR=./uploads
PUBLIC_API_URL=http://localhost:8000/api
