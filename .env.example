# Copy to .env (never commit .env). Values starting with change_this are rejected in production.

# Fail closed by default: production refuses to start without real secrets, FRONTEND_URL, a real
# TURNSTILE_SECRET_KEY and a reachable database, so a copied .env can never run an unprotected
# server by accident.
# For local testing only, change this to APP_ENV=development in your own .env: that allows the
# in-memory store when PostgreSQL is not running, a random JWT key when JWT_SECRET is empty,
# DEV_ADMIN_PASSWORD and Cloudflare's Turnstile test keys. Never deploy with development.
APP_ENV=production

DB_USER=comcamp
DB_PASSWORD=change_this_strong_password
DB_NAME=comcamp_db
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSLMODE=disable

# At least 32 random characters, e.g. `openssl rand -hex 32`. Required in production.
JWT_SECRET=change_this_to_min_32_chars_secret

# Site origin(s) allowed by CORS, comma separated. Required in production.
FRONTEND_URL=http://localhost:4321

# Reverse proxies whose X-Forwarded-For is trusted (IP or CIDR, comma separated).
# Leave empty when the API is reached directly. Behind nginx on the same host: 127.0.0.1
TRUSTED_PROXIES=

# Swagger UI is on in development and off in production unless this is true.
# ENABLE_SWAGGER=false

# Development only: seeds an admin into the in-memory store when PostgreSQL is not running.
# Rejected in production.
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=

# UPLOAD_DIR=./uploads

PUBLIC_API_URL=http://localhost:8000/api
PUBLIC_GALLERY_BASE_URL=https://comcamp25-gallery.sokulshop5.workers.dev/

# --- Cloudflare Turnstile (bot protection on POST /api/applications) --------------------------
# Dashboard: Cloudflare > Turnstile > Add widget (hostnames: your site, e.g. comcamp.example).
# TURNSTILE_SECRET_KEY is the SERVER secret: required in production (the API refuses to start
# without it, or with a placeholder / Cloudflare dummy key). Empty in development = verification is
# BYPASSED with a warning. Never put it in the frontend or commit a real value.
TURNSTILE_SECRET_KEY=
# PUBLIC_TURNSTILE_SITE_KEY is the public site key the /register widget uses (Astro inlines it at
# build time). Unset in `astro dev` = the widget is skipped with a hint; unset in a production
# build = /register refuses to submit.
PUBLIC_TURNSTILE_SITE_KEY=
#
# Cloudflare dummy keys for local testing (docs: developers.cloudflare.com/turnstile/troubleshooting/testing/)
#   site keys   1x00000000000000000000AA  always passes (visible)
#               2x00000000000000000000AB  always blocks (visible)
#               3x00000000000000000000FF  forces an interactive challenge
#   secret keys 1x0000000000000000000000000000000AA  always passes
#               2x0000000000000000000000000000000AA  always fails
#               3x0000000000000000000000000000000AA  yields "token already spent"
# Dummy secrets are rejected when APP_ENV=production. The hostname check is skipped for them.
