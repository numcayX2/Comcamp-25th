---
import {
  MAX_CAPACITY,
  REGISTRATION_OPEN_AT,
  formatBangkokTime,
  formatThaiDateDot,
  formatThaiDateNoYear,
  formatThaiDateShort,
} from '../lib/camp-facts';

interface Props {
  active?: 'home' | 'register' | 'status' | 'admin' | 'applicants' | 'guide' | 'sponsor';
  isHome?: boolean;
}

const { active = 'home', isHome = false } = Astro.props;
const openTime = formatBangkokTime(REGISTRATION_OPEN_AT);
const openNoYear = formatThaiDateNoYear(REGISTRATION_OPEN_AT);
const isAdmin = active === 'admin';
// Staff work on one page: the camp's marketing anchors, the sign-up CTA and the status lookup are noise there.
// On desktop the home-section anchors sit in one "เกี่ยวกับค่าย" disclosure; the mobile drawer lists them flat.
const sectionLinks = isAdmin ? [] : [
  { href: isHome ? '#experience' : '/#experience', label: 'หลักสูตร' },
  { href: isHome ? '#essentials' : '/#essentials', label: 'ข้อมูล' },
  { href: isHome ? '#timeline' : '/#timeline', label: 'ไทม์ไลน์' },
  { href: isHome ? '#faq' : '/#faq', label: 'คำถามที่พบบ่อย' },
  { href: isHome ? '#gallery' : '/#gallery', label: 'แกลเลอรี' },
];
const pageLinks = isAdmin ? [] : [
  { href: '/guide', label: 'คู่มือผู้สมัคร', current: active === 'guide' },
  { href: '/applicants', label: 'รายชื่อผู้สมัคร', current: active === 'applicants' },
  { href: '/sponsor', label: 'สนับสนุนค่าย', current: active === 'sponsor' },
];
---

<a class="skip-link" href="#main">ข้ามไปยังเนื้อหาหลัก</a>

<header class:list={['site-nav', (isHome || active === 'home') && 'is-home', isAdmin && 'is-admin']}>
  <div class="wrap nav-inner">
    <!-- Brand Link -->
    <a
      class="brand"
      href={isHome ? '#main' : '/'}
      aria-label="ComCamp #25 · กลับขึ้นด้านบน"
    >
      <picture>
        <source srcset="/assets/logo/comcamp25-logo-sm.webp" type="image/webp" />
        <img
          class="brand-logo"
          src="/assets/logo/comcamp25-logo-sm.png"
          alt=""
          width="420"
          height="297"
          decoding="async"
        />
      </picture>
      <span class="brand-word">ComCamp <span class="font-mono tabular-nums">#25</span></span>
      {isAdmin && <span class="brand-tag">Staff</span>}
    </a>

    <!-- Navigation Links -->
    <nav class="nav-links" id="site-menu" aria-label="ส่วนต่าง ๆ ของหน้า">
      {sectionLinks.length > 0 && (
        <div class="nav-group" data-nav-group>
          <button type="button" class="nav-group__btn" aria-expanded="false" aria-controls="nav-about-panel">
            <span>เกี่ยวกับค่าย</span>
            <svg class="nav-group__chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <div class="nav-group__panel" id="nav-about-panel">
            {sectionLinks.map((link) => (
              <a class="nav-sec" href={link.href}>{link.label}</a>
            ))}
          </div>
        </div>
      )}
      {pageLinks.map((link) => (
        <a class="nav-sec" href={link.href} aria-current={link.current ? 'page' : undefined}>{link.label}</a>
      ))}

      <!-- Mobile-only drawer items -->
      {isAdmin ? (
        <a href="/" class="nav-mobile-item">← กลับหน้าเว็บไซต์</a>
      ) : (
        <>
          <div class="nav-mobile-divider" aria-hidden="true"></div>
          <a
            href="/register"
            data-nav-register
            data-register-link
            class:list={['nav-mobile-item', active === 'register' && 'is-active']}
            aria-current={active === 'register' ? 'page' : undefined}
          >
            <span data-nav-register-label data-nav-label-style="wide">ลงทะเบียนวันที่ {formatThaiDateShort(REGISTRATION_OPEN_AT)} (<span class="font-mono tabular-nums" data-nav-open-time>{openTime}</span> น.)</span>
          </a>
          <a
            data-nav-status
            href="/status"
            class:list={['nav-mobile-item', active === 'status' && 'is-active']}
            aria-current={active === 'status' ? 'page' : undefined}
          >
            ตรวจสอบสถานะ
          </a>
        </>
      )}

      <!-- Mobile Theme Toggle row in drawer -->
      <button
        class="nav-mobile-item theme-toggle-drawer"
        type="button"
        aria-label="เปลี่ยนโหมดการแสดงผล (Light / Dark Mode)"
      >
        <span class="theme-drawer-text">โหมดการแสดงผล</span>
        <span class="theme-drawer-badge">
          <span class="theme-drawer-state">โหมดสว่าง</span>
          <svg class="theme-icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <svg class="theme-icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </span>
      </button>
      {!isAdmin && (
        <div class="nav-overlay-footer" aria-label="ข้อมูลค่าย">
          <p class="nav-overlay-label">[ ข้อมูลค่าย ]</p>
          <p class="nav-overlay-text">คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้</p>
          <p class="nav-overlay-text">ลงทะเบียนวันที่ <span class="font-mono tabular-nums" data-nav-open-dot>{formatThaiDateDot(REGISTRATION_OPEN_AT)}</span> · <span class="font-mono tabular-nums" data-nav-max-cap>{MAX_CAPACITY}</span> ที่นั่ง</p>
          <p class="nav-overlay-copy">© 2569 ComCamp #25 · CS MJU</p>
        </div>
      )}
    </nav>

    {/* Mobile Controls: registration action (home) + menu toggle.
        Theme switching lives in the drawer (.theme-toggle-drawer).
        #sticky-cta / #sticky-mini are driven by public/theme/main.js — keep the ids. */}
    <div class="nav-mobile-controls">
      {isHome && (
        <>
          <button
            id="sticky-cta"
            class="nav-quick-cta"
            type="button"
            disabled
            aria-disabled="true"
            aria-describedby="sticky-mini"
          ><span data-sticky-label>{openNoYear} <span class="font-mono tabular-nums" data-open-time>{openTime}</span> น.</span></button>
          <span id="sticky-mini" class="sr-only">กำลังโหลดสถานะ</span>
        </>
      )}

      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="เมนูนำทาง"
      >
        <span class="nav-toggle-label">เมนู</span>
        <span class="nav-toggle-icon" aria-hidden="true"></span>
      </button>
    </div>

    <!-- Right-Side Action Area (Desktop >=900px) -->
    <div class="nav-actions">
      {isAdmin ? (
        <a class="btn btn-secondary nav-cta" href="/">← กลับหน้าเว็บไซต์</a>
      ) : (
        <>
          <a
            data-nav-register
            data-register-link
            class:list={['btn btn-primary nav-cta', active === 'register' && 'is-active']}
            href="/register"
            aria-current={active === 'register' ? 'page' : undefined}
          >
            <span data-nav-register-label data-nav-label-style="compact">ลงทะเบียน {openNoYear} <span class="font-mono tabular-nums" data-nav-open-time>{openTime}</span> น.</span>
          </a>
          <a
            data-nav-status
            class:list={['btn btn-secondary nav-cta', active === 'status' && 'is-active']}
            href="/status"
            aria-current={active === 'status' ? 'page' : undefined}
          >
            ตรวจสอบสถานะ
          </a>
        </>
      )}

      <!-- Desktop Theme Toggle Button -->
      <button
        class="theme-toggle-btn theme-toggle-btn--desktop"
        type="button"
        aria-label="สลับโหมดสว่าง/มืด (Light / Dark Mode)"
        title="สลับโหมดสว่าง/มืด"
      >
        <svg class="theme-icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg class="theme-icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  /* Accessibility Skip Link */
  .skip-link {
    position: fixed;
    left: 16px;
    top: 10px;
    z-index: 200;
    padding: 10px 18px;
    border-radius: 9999px;
    background: #121316;
    color: #F9F8F4;
    font-family: 'IBM Plex Sans Thai', system-ui, -apple-system, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-220%);
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .skip-link:focus {
    transform: none;
    outline: 2px solid var(--color-tech, var(--blue-600, #1A5FE0));
    outline-offset: 2px;
  }
  /* Nav archetype: editorial masthead — a flat full-width bar with a hairline
     bottom rule once scrolled. No floating pill, no glass, no shadow. */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    max-width: 100%;
    overflow-x: clip;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.12s linear;
    font-family: 'IBM Plex Sans Thai', system-ui, -apple-system, sans-serif;
  }
  .site-nav.is-scrolled {
    background: var(--canvas-0);
    border-bottom-color: rgba(18, 19, 22, 0.14);
  }
  .site-nav.is-home {
    position: fixed !important;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 100;
    pointer-events: none;
  }
  .site-nav.is-home .nav-inner {
    pointer-events: auto;
  }
  .site-nav.is-hidden {
    transform: translateY(-100%);
    pointer-events: none;
  }
  .wrap {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }
  @media (min-width: 900px) {
    .wrap {
      width: min(1120px, calc(100% - 48px));
    }
    .site-nav.is-home .wrap {
      width: min(1240px, calc(100% - 48px));
    }
  }
  /* /admin content is a 96rem container with px-4 / sm:px-8 gutters; the bar follows it so logo and page share one left edge. */
  .site-nav.is-admin .wrap {
    width: calc(100% - 32px);
    max-width: calc(96rem - 32px);
  }
  @media (min-width: 640px) {
    .site-nav.is-admin .wrap {
      width: calc(100% - 64px);
      max-width: calc(96rem - 64px);
    }
  }
  /* Bar content row — plain flex. The hairline lives on the header so it can
     span the full viewport width. */
  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 64px;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  /* Brand Link */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1;
    color: #121316;
    text-decoration: none;
    white-space: nowrap;
    padding: 6px 0;
    flex: none;
    transition:
      color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      opacity var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      outline-offset var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
  }
  @media (hover: hover) and (pointer: fine) {
    .brand:hover {
      color: #121316;
      text-decoration: none;
    }
    .brand:hover .brand-logo {
      scale: 1.03;
    }
  }
  .brand:active .brand-logo {
    scale: 0.97;
  }
  .brand .font-mono {
    color: #4A4D55;
    font-size: 0.9375rem;
  }
  /* Ink plate: the logo's white/pastel strokes vanish on the light canvas, so it always sits on a dark square. */
  .brand-logo {
    box-sizing: content-box;
    width: 46px;
    height: 33px;
    padding: 4px 6px;
    object-fit: contain;
    flex: none;
    background: #121316;
    border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: 12px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 1px 2px rgba(18, 19, 22, 0.12);
    transition: scale var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
  }
  @media (min-width: 1120px) {
    .brand { gap: 14px; font-size: 1.125rem; }
    .brand-logo {
      width: 62px;
      height: 44px;
      padding: 5px 8px;
    }
  }
  .font-mono {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-weight: 500;
  }
  .tabular-nums {
    font-variant-numeric: tabular-nums;
  }
  /* Nav Links */
  .nav-links {
    display: none;
    align-items: center;
    gap: 20px;
    margin-left: auto;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    font-size: 0.9375rem;
    color: #4A4D55;
    text-decoration: none;
    white-space: nowrap;
    padding: 6px 0;
    transition:
      color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      translate var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      outline-offset var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-links a:hover {
      color: #121316;
      text-decoration: underline;
      text-decoration-color: rgba(18, 19, 22, 0.22);
      text-underline-offset: 4px;
    }
  }
  .nav-links a[aria-current] {
    color: #121316;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: #121316;
    text-underline-offset: 6px;
  }
  /* Nav Toggle Button */
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-left: auto;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgba(18, 19, 22, 0.22);
    border-radius: 9999px;
    background: transparent;
    color: #121316;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      border-color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      background-color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      scale var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      outline-offset var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
  }
  .nav-toggle:active:not(:disabled) {
    scale: 0.97;
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-toggle:hover {
      border-color: #121316;
      background: rgba(18, 19, 22, 0.05);
    }
  }
  .nav-toggle-icon {
    position: relative;
    width: 14px;
    height: 10px;
    flex: none;
  }
  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.15s cubic-bezier(0.16, 1, 0.3, 1),
      top 0.15s cubic-bezier(0.16, 1, 0.3, 1),
      bottom 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-toggle-icon::before {
    top: 0;
  }
  .nav-toggle-icon::after {
    bottom: 0;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-icon::before {
    top: 4px;
    transform: rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-icon::after {
    bottom: 4px;
    transform: rotate(-45deg);
  }

  /* Nav Actions (Desktop) */
  .nav-actions {
    display: none;
  }

  .brand-tag {
    margin-left: 10px;
    padding: 2px 10px;
    border: 1px solid currentColor;
    border-radius: 9999px;
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.7;
    vertical-align: middle;
  }

  .nav-cta-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #4A4D55;
    text-decoration: none;
    white-space: nowrap;
    padding: 6px 12px;
    border-radius: 0;
    transition:
      color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      background-color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      outline-offset var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-cta-link:hover {
      color: #121316;
      background: rgba(18, 19, 22, 0.05);
      text-decoration: none;
    }
  }

  .nav-cta-link.is-active,
  .nav-cta-link[aria-current="page"] {
    color: #121316;
    font-weight: 600;
    background: transparent;
  }

  /* Registration not open yet — honest, quiet label instead of a live CTA */
  .nav-cta-link.is-pre-open,
  .nav-cta-link.is-pre-open:hover {
    color: #62666E;
    font-weight: 600;
    background: transparent;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.5;
    border-radius: 9999px;
    padding: 0 18px;
    min-height: 44px;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      box-shadow var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      border-color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      outline-offset var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      scale var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
    touch-action: manipulation;
    box-sizing: border-box;
  }
  .btn:active:not(:disabled):not([aria-disabled="true"]) {
    scale: 0.975;
  }

  .btn-secondary {
    background: #121316;
    color: #F9F8F4;
    border: 1px solid #121316;
  }

  /* Primary CTA: fern pill with ink text (AGENTS.md §4), sits beside the dark status pill at the same size. */
  .btn-primary {
    background: #03B800;
    color: #121316;
    border: 1px solid #03B800;
  }
  /* Not open (yet) / full / closed: same pill, quiet outline instead of a live CTA */
  .btn-primary.is-pre-open {
    background: transparent;
    color: #4A4D55;
    border-color: #8A8D93;
  }
  :global(html.dark) .btn-primary.is-pre-open,
  :global(html[data-theme="dark"]) .btn-primary.is-pre-open {
    color: #C3C4C7;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .btn-secondary.is-active,
  .btn-secondary[aria-current="page"] {
    background: #03B800;
    color: #121316;
    border-color: #03B800;
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-secondary:hover {
      border-color: #121316;
      background: #2A2D33;
      color: #F9F8F4;
      text-decoration: none;
    }
    .btn-primary:hover {
      background: #029E00;
      border-color: #029E00;
      color: #121316;
      text-decoration: none;
    }
    .btn-primary.is-pre-open:hover {
      background: rgba(18, 19, 22, 0.05);
      color: #121316;
      border-color: #121316;
    }
    :global(html.dark) .btn-primary.is-pre-open:hover,
    :global(html[data-theme="dark"]) .btn-primary.is-pre-open:hover {
      background: rgba(255, 255, 255, 0.08);
      color: #F5F4EF;
      border-color: rgba(255, 255, 255, 0.55);
    }
    .btn-secondary.is-active:hover {
      background: #029E00;
      color: #121316;
      border-color: #029E00;
    }
  }

  .nav-cta {
    font-size: 0.9375rem;
  }

  /* Mobile Responsive — full-screen overlay menu (<900px so tablet portrait never overflows).
     Big stacked type up top, camp info pinned to the bottom.
     The panel wipes in as one piece; items appear with it, no stagger. */
  @media (max-width: 899px) {
    .nav-actions {
      display: none;
    }
    /* Brand + menu button stay above the overlay so the bar stays usable. */
    .brand,
    .nav-mobile-controls {
      position: relative;
      z-index: 70;
    }
    .nav-links {
      position: fixed;
      /* Longhand offsets: `inset` is unsupported before Safari 14.1 (iOS <= 14.4 in-app WebViews). */
      top: 0;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 60;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      box-sizing: border-box;
      max-width: 100vw;
      margin: 0;
      padding: 96px 28px calc(20px + env(safe-area-inset-bottom));
      background: #F9F8F4;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      transform: translateX(102%);
      visibility: hidden;
      pointer-events: none;
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.45s;
    }
    @keyframes nav-drawer-item-in {
      from {
        opacity: 0.65;
        translate: 10px 0;
      }
      to {
        opacity: 1;
        translate: 0 0;
      }
    }
    .nav-links.is-open {
      display: flex;
      transform: none;
      visibility: visible;
      pointer-events: auto;
      transition: transform 0.36s var(--ease-out, cubic-bezier(.2, .8, .2, 1));
    }
    .nav-links.is-open > a,
    .nav-links.is-open > .theme-toggle-drawer,
    .nav-links.is-open > .nav-overlay-footer {
      animation: nav-drawer-item-in var(--dur-base, .26s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
    }
    /* The desktop disclosure dissolves in the drawer: its anchors render as plain drawer rows. */
    .nav-group,
    .nav-group__panel {
      display: contents;
    }
    .nav-group__btn {
      display: none;
    }
    .nav-links.is-open > .nav-group a {
      animation: nav-drawer-item-in var(--dur-base, .26s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
    }
    /* Section links: editorial Table-of-Contents rows with mono chapter index */
    .nav-links a.nav-sec {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: baseline;
      column-gap: 10px;
      min-height: 0;
      padding: 8px 0;
      font-size: clamp(1.45rem, 6.2vw, 2.15rem);
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: 0;
      color: #121316;
      border-bottom: 1px solid rgba(18, 19, 22, 0.08);
    }
    @media (hover: hover) and (pointer: fine) {
      .nav-links a.nav-sec:hover {
        color: #1A5FE0;
        text-decoration: none;
        translate: 3px 0;
      }
    }
    .nav-links a {
      justify-content: flex-start;
      min-height: 48px;
      font-size: 1rem;
      border-bottom: 1px solid rgba(18, 19, 22, 0.10);
    }
    .nav-links a[aria-current] {
      text-decoration: none;
      font-weight: 600;
    }
    /* Section links sit static; only the panel itself animates. */
    .nav-mobile-divider {
      display: block;
      height: 1px;
      background: rgba(18, 19, 22, 0.10);
      margin: 6px 0;
    }
    .nav-mobile-item {
      font-weight: 600;
      color: #121316 !important;
    }
    .nav-mobile-item.is-active {
      color: #121316 !important;
    }
    .nav-mobile-item.is-pre-open {
      color: #62666E !important;
    }
    /* Overlay footer: camp info pinned to the bottom. */
    .nav-overlay-footer {
      margin-top: auto;
      padding-top: 24px;
    }
    .nav-overlay-label {
      margin: 0 0 8px;
      font-family: 'IBM Plex Sans Thai', system-ui, -apple-system, sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0;
      color: #121316;
    }
    .nav-overlay-text {
      margin: 0;
      font-size: 0.9375rem;
      line-height: 1.75;
      color: #4A4D55;
    }
    .nav-overlay-copy {
      margin: 14px 0 0;
      font-size: 0.8125rem;
      color: #62666E;
    }
  }

  /* Theme Toggle Button (Desktop & Mobile) */
  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    border: 1px solid rgba(18, 19, 22, 0.18);
    background: transparent;
    color: #121316;
    cursor: pointer;
    flex: none;
    padding: 0;
    transition:
      scale var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      border-color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      background-color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      outline-offset var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
    touch-action: manipulation;
  }
  .theme-toggle-btn svg {
    transition:
      rotate var(--dur-base, .26s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
  }
  @media (hover: hover) and (pointer: fine) {
