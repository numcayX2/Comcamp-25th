    margin-left: auto;
  }

  /* Enlarged text (150–200%): the brand word gives way (ellipsis) so the quick action and the
     menu button always stay on screen. The link keeps its aria-label. */
  @media (max-width: 899px) {
    .brand {
      flex: 0 1 auto;
      min-width: 0;
    }
    /* Only the word gives way: the logo plate (inside <picture>) and the Staff tag keep their size. */
    .brand > picture,
    .brand-tag {
      flex: none;
    }
    .brand-word {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      /* .brand sets line-height: 1, so the clip box would cut the "p" descender; pad it out
         and pull the margin back so the bar height does not change. */
      padding-block: 0.25em;
      margin-block: -0.25em;
    }
    .nav-mobile-controls {
      flex: none;
    }
  }

  /* Mobile registration action (replaces the old bottom sticky bar).
     Square like .nav-toggle beside it; fern fill only when it actually does something. */
  .nav-quick-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid transparent;
    border-radius: 9999px;
    background: #03B800;
    color: #121316;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      background-color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      border-color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      scale var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
      outline-offset var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
  }
  .nav-quick-cta:active:not(:disabled):not([aria-disabled="true"]) { scale: 0.975; }
  @media (hover: hover) and (pointer: fine) {
    .nav-quick-cta:hover:not(:disabled) { background: var(--fern-600, #029E00); }
  }
  .nav-quick-cta:focus-visible { outline: 2px solid var(--color-tech, var(--blue-600, #1A5FE0)); outline-offset: 2px; }
  /* Links and toggles share the blue focus ring (AGENTS §11.3) instead of the browser default. */
  .site-nav a:focus-visible,
  .site-nav button:focus-visible {
    outline: 2px solid var(--color-tech, #1A5FE0);
    outline-offset: 2px;
  }
  /* Pre-open / closed: informational, not a dead green button */
  .nav-quick-cta:disabled {
    background: transparent;
    border-color: rgba(18, 19, 22, 0.14);
    color: #4A4D55;
    cursor: default;
  }
  :global(html.dark) .nav-quick-cta:disabled,
  :global(html[data-theme="dark"]) .nav-quick-cta:disabled {
    border-color: rgba(255, 255, 255, 0.2);
    color: #C3C4C7;
  }
  /* Narrow phones: logo-only brand so the action + menu button never get pushed off-screen
     (/admin also carries the Staff tag, so it needs the room up to 419px).
     The link keeps its aria-label ("ComCamp #25 · กลับขึ้นด้านบน"). */
  @media (max-width: 399px) {
