  /* Desktop "เกี่ยวกับค่าย" disclosure: click/tap to open (no hover-open), panel drops below the trigger. */
  @media (min-width: 900px) {
    .nav-group {
      position: relative;
      display: flex;
    }
    .nav-group__btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      min-height: 44px;
      padding: 6px 0;
      border: 0;
      background: transparent;
      font: inherit;
      font-size: 0.9375rem;
      color: #4A4D55;
      white-space: nowrap;
      cursor: pointer;
      transition: color var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
    }
    .nav-group__chev {
      flex: none;
      transition: rotate var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
    }
    .nav-group__btn[aria-expanded="true"] .nav-group__chev {
      rotate: 180deg;
    }
    @media (hover: hover) and (pointer: fine) {
      .nav-group__btn:hover {
        color: #121316;
      }
    }
    .nav-group__btn[aria-expanded="true"],
    .nav-group:has(a[aria-current]) .nav-group__btn {
      color: #121316;
    }
    /* The section in view (scroll-spy) is hidden in the closed panel, so the trigger carries it. */
    .nav-group:has(a[aria-current]) .nav-group__btn span {
      font-weight: 600;
      text-decoration: underline;
      text-decoration-color: #121316;
      text-underline-offset: 6px;
    }
    .nav-group__panel {
      position: absolute;
      top: calc(100% + 8px);
      left: -14px;
      z-index: 80;
      display: flex;
      flex-direction: column;
      min-width: 13rem;
      padding: 8px;
      background: var(--surface, #FFFFFF);
      border-radius: var(--r-card, 24px);
      box-shadow: var(--shadow-float,
        0 2px 6px rgba(18, 19, 22, 0.04),
        0 18px 36px -16px rgba(18, 19, 22, 0.12),
        0 0 0 1px rgba(18, 19, 22, 0.07));
      opacity: 0;
      translate: 0 -4px;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
        translate var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
        visibility 0s linear var(--dur-fast, .16s);
    }
    .nav-group__btn[aria-expanded="true"] + .nav-group__panel {
      opacity: 1;
      translate: 0 0;
      visibility: visible;
      pointer-events: auto;
      transition:
        opacity var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1)),
        translate var(--dur-fast, .16s) var(--ease-out, cubic-bezier(.2, .8, .2, 1));
    }
    /* No-JS fallback: before the script binds the disclosure, hover or keyboard focus opens it. */
    .nav-group:not([data-cc-group-bound="true"]):hover .nav-group__panel,
    .nav-group:not([data-cc-group-bound="true"]):focus-within .nav-group__panel {
      opacity: 1;
      translate: 0 0;
      visibility: visible;
      pointer-events: auto;
    }
    .nav-links .nav-group__panel a.nav-sec {
      min-height: 44px;
      padding: 8px 14px;
      font-size: 0.9375rem;
    }
  }

  /* Compact desktop tier (900px–1119px): keeps 6 numbered links + CTAs on one row without wrap or collision */
  @media (min-width: 900px) and (max-width: 1119px) {
    .nav-inner {
      gap: 10px;
    }
    .brand {
      gap: 8px;
      font-size: 0.9375rem;
    }
    .brand-logo {
      width: 38px;
      height: 27px;
    }
    .brand .font-mono {
      font-size: 0.875rem;
    }
    .nav-links {
      gap: 10px;
    }
    .nav-links a {
      font-size: 0.8125rem;
    }
    .nav-actions {
      gap: 6px;
      margin-left: 4px;
    }
    .nav-cta {
      font-size: 0.8125rem;
      padding: 0 12px;
      min-height: 44px;
    }
    .theme-toggle-btn {
      width: 38px;
      height: 38px;
    }
    .nav-group__btn {
      font-size: 0.8125rem;
    }
  }

  /* Mid desktop tier (1120px–1259px) */
  @media (min-width: 1120px) and (max-width: 1259px) {
    .nav-inner {
      gap: 12px;
    }
    .nav-links {
      gap: 14px;
    }
    .nav-links a {
      font-size: 0.875rem;
    }
    .nav-group__btn {
      font-size: 0.875rem;
    }
    .nav-actions {
      margin-left: 8px;
    }
    .nav-cta {
      font-size: 0.875rem;
      padding: 0 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav,
    .nav-inner,
    .brand,
    .brand-logo,
    .nav-links,
    .nav-links > *,
    .nav-links a,
    .nav-toggle,
    .nav-quick-cta,
    .btn,
    .theme-toggle-btn,
    .theme-toggle-btn svg,
    .theme-toggle-drawer,
    .theme-drawer-badge,
    .nav-toggle-icon::before,
    .nav-toggle-icon::after {
      transition: none !important;
      animation: none !important;
      translate: none !important;
      scale: none !important;
      rotate: none !important;
    }
    .nav-links,
    .nav-links > *,
    .nav-links.is-open > * {
      opacity: 1 !important;
      transform: none !important;
    }
    .nav-group__chev,
    .nav-group__panel {
      transition: none !important;
      translate: none !important;
    }
  }
</style>

<script>
  import { fetchSharedPublicSettings } from '../lib/public-settings-cache';
  import {
    MAX_CAPACITY,
    REGISTRATION_CLOSE_AT,
    REGISTRATION_OPEN_AT,
    formatBangkokTime,
    formatThaiDateDot,
    formatThaiDateNoYear,
    formatThaiDateShort,
  } from '../lib/camp-facts';

  // Window/document listeners bound for the current page; aborted when ClientRouter swaps it out
  // (the nav element is re-rendered per page, so each page binds a fresh set).
  let navAbort: AbortController | null = null;
  const navSignal = () => (navAbort ??= new AbortController()).signal;
  document.addEventListener('astro:before-swap', () => {
    navAbort?.abort();
    navAbort = null;
  });

  function initSiteNav() {
    const nav = document.querySelector<HTMLElement>('.site-nav');
    const toggle = document.querySelector<HTMLButtonElement>('.site-nav .nav-toggle');
    const menu = document.getElementById('site-menu');

    if (toggle && menu) {
      const wide = window.matchMedia('(min-width: 900px)');
      const syncInert = (open: boolean) => {
        menu.inert = !open && !wide.matches;
      };
      syncInert(toggle.getAttribute('aria-expanded') === 'true');

      if (toggle.dataset.ccNavBound !== 'true') {
        toggle.dataset.ccNavBound = 'true';

        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          menu.classList.toggle('is-open', open);
          syncInert(open);
          document.body.style.overflow = open && !wide.matches ? 'hidden' : '';
        };

        // Capture phase + stopImmediatePropagation prevents duplicate listener in main.js on HomePage
        toggle.addEventListener(
          'click',
          (e) => {
            e.stopPropagation();
            e.stopImmediatePropagation();
            const isOpen = toggle.getAttribute('aria-expanded') === 'true';
            setOpen(!isOpen);
          },
          { capture: true }
        );

        menu.addEventListener('click', (e) => {
          const target = e.target as HTMLElement | null;
          if (target?.closest('a')) {
            setOpen(false);
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        }, { signal: navSignal() });

        const onWide = () => {
          if (wide.matches) {
            setOpen(false);
            menu.inert = false;
          } else {
            syncInert(toggle.getAttribute('aria-expanded') === 'true');
          }
        };
        if (wide.addEventListener) {
          wide.addEventListener('change', onWide, { signal: navSignal() });
        } else if ('addListener' in wide) {
          (wide as any).addListener(onWide);
        }
      }
    }

    // Desktop "เกี่ยวกับค่าย" disclosure (WAI-ARIA disclosure pattern). In the mobile drawer the
    // trigger is display:none and the links render flat, so none of this runs there.
    const group = document.querySelector<HTMLElement>('.site-nav [data-nav-group]');
    const groupBtn = group?.querySelector<HTMLButtonElement>('.nav-group__btn');
    const panel = group?.querySelector<HTMLElement>('.nav-group__panel');
    if (group && groupBtn && panel && group.dataset.ccGroupBound !== 'true') {
      group.dataset.ccGroupBound = 'true';
      const links = () => Array.from(panel.querySelectorAll<HTMLAnchorElement>('a'));
      const isOpen = () => groupBtn.getAttribute('aria-expanded') === 'true';
      const setGroup = (open: boolean) => groupBtn.setAttribute('aria-expanded', open ? 'true' : 'false');

      groupBtn.addEventListener('click', () => setGroup(!isOpen()));
      groupBtn.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        setGroup(true);
        const list = links();
        (e.key === 'ArrowDown' ? list[0] : list[list.length - 1])?.focus();
      });
      panel.addEventListener('keydown', (e) => {
        const list = links();
        const i = list.indexOf(document.activeElement as HTMLAnchorElement);
        if (i < 0) return;
        const next =
          e.key === 'ArrowDown' ? (i + 1) % list.length
          : e.key === 'ArrowUp' ? (i - 1 + list.length) % list.length
          : e.key === 'Home' ? 0
          : e.key === 'End' ? list.length - 1
          : -1;
        if (next < 0) return;
        e.preventDefault();
        list[next].focus();
      });
      panel.addEventListener('click', (e) => {
        if ((e.target as HTMLElement | null)?.closest('a')) setGroup(false);
      });
      group.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) {
          e.stopPropagation();
          setGroup(false);
          groupBtn.focus();
        }
      });
      // Tabbing out closes it; a click on the panel's padding (relatedTarget null) does not.
      group.addEventListener('focusout', (e) => {
        const to = e.relatedTarget as Node | null;
        if (to && !group.contains(to)) setGroup(false);
      });
      document.addEventListener('pointerdown', (e) => {
        if (isOpen() && !group.contains(e.target as Node)) setGroup(false);
      }, { signal: navSignal() });
      window.matchMedia('(min-width: 900px)').addEventListener?.('change', () => setGroup(false), { signal: navSignal() });
    }

    if (nav && nav.dataset.ccScrollBound !== 'true') {
      nav.dataset.ccScrollBound = 'true';
      const onScroll = () => {
        nav.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true, signal: navSignal() });
    }
  }

  initSiteNav();
  document.addEventListener('astro:page-load', initSiteNav);

  type RegistrationState = 'PRE_OPEN' | 'OPEN' | 'ALMOST_FULL' | 'FULL' | 'CLOSED';

  interface NavSettings {
    serverTime?: string;
    registrationOpenAt?: string;
    registrationCloseAt?: string;
    isOpen?: boolean;
    currentCount?: number;
    maxCapacity?: number;
  }

  const DEFAULT_OPEN_AT = Date.parse(REGISTRATION_OPEN_AT);
  const DEFAULT_CLOSE_AT = Date.parse(REGISTRATION_CLOSE_AT);

  function labelForState(
    state: RegistrationState,
    seatsLeft: number,
    openAt: number = DEFAULT_OPEN_AT,
    style: 'wide' | 'compact' = 'wide',
  ): { label: string; href: string; muted: boolean } {
    switch (state) {
      case 'OPEN':
        return { label: 'สมัครค่าย', href: '/register', muted: false };
      case 'ALMOST_FULL':
        return { label: `สมัครค่าย (เหลือ ${seatsLeft})`, href: '/register', muted: false };
      case 'FULL':
        return { label: 'ที่นั่งเต็มแล้ว', href: '/status', muted: true };
      case 'CLOSED':
        return { label: 'ปิดรับสมัครแล้ว', href: '/status', muted: true };
      default:
        // {t} marks the opening time (09:00 Asia/Bangkok); it is rendered in a mono span. Compact = desktop pill.
        return {
          label: style === 'compact'
            ? `ลงทะเบียน ${formatThaiDateNoYear(openAt)} {t} น.`
            : `ลงทะเบียนวันที่ ${formatThaiDateShort(openAt)} ({t} น.)`,
          href: '/register',
          muted: true,
        };
    }
  }

  function setNavLabel(el: HTMLElement, tpl: string, time: string) {
    const i = tpl.indexOf('{t}');
    const plain = tpl.replace('{t}', time);
    if (i < 0) {
      if (el.textContent !== plain || el.children.length) el.textContent = plain;
      return;
    }
    if (el.textContent === plain && el.querySelector('[data-nav-open-time]')) return;
    el.textContent = '';
    el.append(tpl.slice(0, i));
    const m = document.createElement('span');
    m.className = 'font-mono tabular-nums';
    m.setAttribute('data-nav-open-time', '');
    m.textContent = time;
    el.append(m, tpl.slice(i + 3));
  }

  function applyNavRegisterLabel(state: RegistrationState, seatsLeft: number, openAt: number = DEFAULT_OPEN_AT) {
    const time = formatBangkokTime(openAt);
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-register]').forEach((link) => {
      const text = link.querySelector<HTMLElement>('[data-nav-register-label]');
      const style = text?.dataset.navLabelStyle === 'compact' ? 'compact' : 'wide';
      const { label, href, muted } = labelForState(state, seatsLeft, openAt, style);
      if (text) setNavLabel(text, label, time);
      link.setAttribute('href', href);
      link.classList.toggle('is-pre-open', muted);
    });
  }

  function applyNavDrawerMeta(openAt: number, maxCapacity: number) {
    const dot = formatThaiDateDot(openAt);
    const cap = String(maxCapacity);
    document.querySelectorAll<HTMLElement>('[data-nav-open-dot]').forEach((el) => {
      el.textContent = dot;
    });
    document.querySelectorAll<HTMLElement>('[data-nav-max-cap]').forEach((el) => {
      el.textContent = cap;
    });
  }

  function applyNavStatusVisibility(state: RegistrationState) {
    // Nobody can have applied before opening, so the status check has nothing to look up.
    // Keep the link visible on the status page itself so the current-page nav item never vanishes.
    const hide = state === 'PRE_OPEN';
    document.querySelectorAll<HTMLElement>('[data-nav-status]').forEach((link) => {
      if (link.classList.contains('is-active')) return;
      link.style.display = hide ? 'none' : '';
    });
  }

  function resolveState(settings: NavSettings): RegistrationState {
    const parsedOpenAt = settings.registrationOpenAt ? new Date(settings.registrationOpenAt).getTime() : DEFAULT_OPEN_AT;
    const openAt = Number.isFinite(parsedOpenAt) ? parsedOpenAt : DEFAULT_OPEN_AT;
    const parsedCloseAt = settings.registrationCloseAt ? new Date(settings.registrationCloseAt).getTime() : DEFAULT_CLOSE_AT;
    const closeAt = Number.isFinite(parsedCloseAt) ? parsedCloseAt : DEFAULT_CLOSE_AT;
    const serverEpoch = settings.serverTime ? new Date(settings.serverTime).getTime() : Number.NaN;
    const offset = Number.isFinite(serverEpoch) ? serverEpoch - Date.now() : 0;
    const now = Date.now() + offset;
    const max = typeof settings.maxCapacity === 'number' && settings.maxCapacity > 0 ? settings.maxCapacity : MAX_CAPACITY;
    const count = typeof settings.currentCount === 'number' ? settings.currentCount : 0;
    const seatsLeft = Math.max(0, max - count);

    if (now < openAt && !settings.isOpen) return 'PRE_OPEN';
    if (Number.isFinite(closeAt) && now >= closeAt) return 'CLOSED';
    if (seatsLeft <= 0) return 'FULL';
    if (!settings.isOpen) return 'CLOSED';
    if (seatsLeft <= 5) return 'ALMOST_FULL';
    return 'OPEN';
  }

  async function initNavRegisterState() {
    if (!document.querySelector('[data-nav-register]')) return;

    const base =
      import.meta.env.PUBLIC_API_URL ||
      (typeof window !== 'undefined' && (window as any).__CC25_API_BASE_URL__) ||
      'http://localhost:8000/api';

    try {
      const settings = (await fetchSharedPublicSettings(base, { timeoutMs: 4000 })) as NavSettings;
      const parsedOpenAt = settings.registrationOpenAt ? new Date(settings.registrationOpenAt).getTime() : DEFAULT_OPEN_AT;
      const openAt = Number.isFinite(parsedOpenAt) ? parsedOpenAt : DEFAULT_OPEN_AT;
      const state = resolveState(settings);
      const max = typeof settings.maxCapacity === 'number' && settings.maxCapacity > 0 ? settings.maxCapacity : MAX_CAPACITY;
      const count = typeof settings.currentCount === 'number' ? settings.currentCount : 0;
      applyNavRegisterLabel(state, Math.max(0, max - count), openAt);
      applyNavDrawerMeta(openAt, max);
      applyNavStatusVisibility(state);
    } catch {
      // Fail closed when unreachable: PRE_OPEN before openAt, CLOSED after openAt.
      const fallbackState: RegistrationState = Date.now() < DEFAULT_OPEN_AT ? 'PRE_OPEN' : 'CLOSED';
      applyNavRegisterLabel(fallbackState, 0, DEFAULT_OPEN_AT);
      applyNavDrawerMeta(DEFAULT_OPEN_AT, MAX_CAPACITY);
      applyNavStatusVisibility(fallbackState);
    }
  }

  initNavRegisterState();
  document.addEventListener('astro:page-load', initNavRegisterState);

  function initThemeToggle() {
    const btns = document.querySelectorAll<HTMLElement>('.theme-toggle-btn, .theme-toggle-drawer');
    if (!btns.length) return;

    const isCurrentDark = () => document.documentElement.classList.contains('dark');

    const updateUI = (isDark: boolean) => {
      btns.forEach((btn) => {
        btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
        btn.setAttribute(
          'title',
          isDark ? 'เปลี่ยนเป็นโหมดสว่าง (Light Mode)' : 'เปลี่ยนเป็นโหมดมืด (Dark Mode)'
        );
        const drawerState = btn.querySelector('.theme-drawer-state');
        if (drawerState) {
          drawerState.textContent = isDark ? 'โหมดมืด' : 'โหมดสว่าง';
        }
      });
    };

    updateUI(isCurrentDark());

    btns.forEach((btn) => {
      if (btn.dataset.themeBound === 'true') return;
      btn.dataset.themeBound = 'true';

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const nextDark = !isCurrentDark();
        if (nextDark) {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
          try { localStorage.setItem('comcamp-theme', 'dark'); } catch (err) {}
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
          try { localStorage.setItem('comcamp-theme', 'light'); } catch (err) {}
        }
        updateUI(nextDark);
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { dark: nextDark } }));
      });
    });

    if (!(window as any).__CC25_THEME_LISTENER_ATTACHED__) {
      (window as any).__CC25_THEME_LISTENER_ATTACHED__ = true;
      window.addEventListener('theme-changed', () => {
        updateUI(isCurrentDark());
      });
    }
  }

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
