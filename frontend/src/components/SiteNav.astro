    }

    :global(html.dark) .nav-mobile-divider,
    :global(html[data-theme="dark"]) .nav-mobile-divider {
      background: rgba(255, 255, 255, 0.1);
    }

    :global(html.dark) .nav-mobile-item,
    :global(html[data-theme="dark"]) .nav-mobile-item {
      color: #F5F4EF !important;
    }

    :global(html.dark) .theme-toggle-drawer,
    :global(html[data-theme="dark"]) .theme-toggle-drawer {
      border-bottom-color: rgba(255, 255, 255, 0.08);
      color: #F5F4EF;
    }

    :global(html.dark) .theme-drawer-badge,
    :global(html[data-theme="dark"]) .theme-drawer-badge {
      border-color: rgba(255, 255, 255, 0.22);
      background: rgba(255, 255, 255, 0.08);
      color: #F5F4EF;
    }
  }

  @media (min-width: 900px) {
    .nav-mobile-controls {
      display: none !important;
    }

    .theme-toggle-drawer {
      display: none !important;
    }
    .nav-links {
      display: flex;
    }

    .nav-toggle {
      display: none;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-left: 12px;
      flex: none;
    }

    .nav-mobile-divider,
    .nav-mobile-item,
    .nav-overlay-footer {
      display: none !important;
    }
  }

  /* Compact desktop tier (900px–1119px): keeps 6 numbered links + CTAs on one row without wrap or collision */
  @media (min-width: 900px) and (max-width: 1119px) {
    .nav-inner {
      gap: 10px;
    }
    .brand {
      gap: 8px;
      font-size: 0.9375rem;
    }
    .brand-logo {
      width: 34px;
      height: 24px;
    }
    .brand .font-mono {
      font-size: 0.875rem;
    }
    .nav-links {
      gap: 10px;
    }
    .nav-links a {
      font-size: 0.8125rem;
    }
    .nav-actions {
      gap: 6px;
      margin-left: 4px;
    }
    .nav-cta {
      font-size: 0.8125rem;
      padding: 0 12px;
      min-height: 44px;
    }
    .theme-toggle-btn {
      width: 38px;
      height: 38px;
    }
  }

  /* Mid desktop tier (1120px–1259px) */
  @media (min-width: 1120px) and (max-width: 1259px) {
    .nav-inner {
      gap: 12px;
    }
    .nav-links {
      gap: 14px;
    }
    .nav-links a {
      font-size: 0.875rem;
    }
    .nav-actions {
      margin-left: 8px;
    }
    .nav-cta {
      font-size: 0.875rem;
      padding: 0 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav,
    .nav-inner,
    .nav-links,
    .nav-links > *,
    .nav-links a,
    .btn,
    .nav-toggle-icon::before,
    .nav-toggle-icon::after {
      transition: none !important;
    }
    .nav-links,
    .nav-links > *,
    .nav-links.is-open > * {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { fetchSharedPublicSettings } from '../lib/public-settings-cache';

  function initSiteNav() {
    const nav = document.querySelector<HTMLElement>('.site-nav');
    const toggle = document.querySelector<HTMLButtonElement>('.site-nav .nav-toggle');
    const menu = document.getElementById('site-menu');

    if (toggle && menu) {
      const wide = window.matchMedia('(min-width: 900px)');
      const syncInert = (open: boolean) => {
        menu.inert = !open && !wide.matches;
      };
      syncInert(toggle.getAttribute('aria-expanded') === 'true');

      if (toggle.dataset.ccNavBound !== 'true') {
        toggle.dataset.ccNavBound = 'true';

        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          menu.classList.toggle('is-open', open);
          syncInert(open);
          document.body.style.overflow = open && !wide.matches ? 'hidden' : '';
        };

        // Capture phase + stopImmediatePropagation prevents duplicate listener in main.js on HomePage
        toggle.addEventListener(
          'click',
          (e) => {
            e.stopPropagation();
            e.stopImmediatePropagation();
            const isOpen = toggle.getAttribute('aria-expanded') === 'true';
            setOpen(!isOpen);
          },
          { capture: true }
        );

        menu.addEventListener('click', (e) => {
          const target = e.target as HTMLElement | null;
          if (target?.closest('a')) {
            setOpen(false);
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });

        const onWide = () => {
          if (wide.matches) {
            setOpen(false);
            menu.inert = false;
          } else {
            syncInert(toggle.getAttribute('aria-expanded') === 'true');
          }
        };
        if (wide.addEventListener) {
          wide.addEventListener('change', onWide);
        } else if ('addListener' in wide) {
          (wide as any).addListener(onWide);
        }
      }
    }

    if (nav && nav.dataset.ccScrollBound !== 'true') {
      nav.dataset.ccScrollBound = 'true';
      const onScroll = () => {
        nav.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }

  initSiteNav();
  document.addEventListener('astro:page-load', initSiteNav);

  type RegistrationState = 'PRE_OPEN' | 'OPEN' | 'ALMOST_FULL' | 'FULL' | 'CLOSED';

  interface NavSettings {
    serverTime?: string;
    registrationOpenAt?: string;
    registrationCloseAt?: string;
    isOpen?: boolean;
    currentCount?: number;
    maxCapacity?: number;
  }

  const DEFAULT_OPEN_AT = new Date('2026-11-19T09:00:00+07:00').getTime();
  const DEFAULT_CLOSE_AT = new Date('2026-12-18T23:59:59+07:00').getTime();

  const THAI_MONTHS_SHORT = [
    'ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.',
    'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.',
  ];

  function getBangkokDateParts(epochMs: number): { day: number; month: number; beYear2: string; hour: number; minute: number } {
    const safeMs = Number.isFinite(epochMs) ? epochMs : DEFAULT_OPEN_AT;
    const d = new Date(safeMs);
    try {
      const fmt = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Bangkok',
        year: 'numeric',
        month: 'numeric',
        day: 'numeric',
        hour: 'numeric',
        minute: 'numeric',
        hourCycle: 'h23',
      });
      const parts = fmt.formatToParts(d);
      const map: Record<string, number> = {};
      for (const part of parts) {
        if (part.type === 'year' || part.type === 'month' || part.type === 'day' || part.type === 'hour' || part.type === 'minute') {
          map[part.type] = Number(part.value);
        }
      }
      if (map.year && map.month && map.day) {
        const beYear = map.year + 543;
        return {
          day: map.day,
          month: map.month,
          beYear2: String(beYear % 100).padStart(2, '0'),
          hour: (map.hour || 0) % 24,
          minute: map.minute || 0,
        };
      }
    } catch {
      // Fall back to fixed UTC+7 arithmetic if Intl.DateTimeFormat fails.
    }
    const bkk = new Date(d.getTime() + 7 * 60 * 60 * 1000);
    const beYear = bkk.getUTCFullYear() + 543;
    return {
      day: bkk.getUTCDate(),
      month: bkk.getUTCMonth() + 1,
      beYear2: String(beYear % 100).padStart(2, '0'),
      hour: bkk.getUTCHours(),
      minute: bkk.getUTCMinutes(),
    };
  }

  function formatNavOpenNoYear(epochMs: number): string {
    const p = getBangkokDateParts(epochMs);
    return `${p.day} ${THAI_MONTHS_SHORT[p.month - 1]}`;
  }

  function formatNavOpenTime(epochMs: number): string {
    const p = getBangkokDateParts(epochMs);
    return `${String(p.hour).padStart(2, '0')}:${String(p.minute).padStart(2, '0')}`;
  }

  function formatNavOpenShort(epochMs: number): string {
    const p = getBangkokDateParts(epochMs);
    return `${p.day} ${THAI_MONTHS_SHORT[p.month - 1]} ${p.beYear2}`;
  }

  function formatNavOpenDot(epochMs: number): string {
    const p = getBangkokDateParts(epochMs);
    return `${String(p.day).padStart(2, '0')}.${String(p.month).padStart(2, '0')}.${p.beYear2}`;
  }

  function labelForState(
    state: RegistrationState,
    seatsLeft: number,
    openAt: number = DEFAULT_OPEN_AT,
    style: 'wide' | 'compact' = 'wide',
  ): { label: string; href: string; muted: boolean } {
    switch (state) {
      case 'OPEN':
        return { label: 'สมัครค่าย', href: '/register', muted: false };
      case 'ALMOST_FULL':
        return { label: `สมัครค่าย (เหลือ ${seatsLeft})`, href: '/register', muted: false };
      case 'FULL':
        return { label: 'ที่นั่งเต็มแล้ว', href: '/status', muted: true };
      case 'CLOSED':
        return { label: 'ปิดรับสมัครแล้ว', href: '/status', muted: true };
      default:
        // {t} marks the opening time (09:00 Asia/Bangkok); it is rendered in a mono span. Compact = desktop pill.
        return {
          label: style === 'compact'
            ? `ลงทะเบียน ${formatNavOpenNoYear(openAt)} {t} น.`
            : `ลงทะเบียนวันที่ ${formatNavOpenShort(openAt)} ({t} น.)`,
          href: '/register',
          muted: true,
        };
    }
  }

  function setNavLabel(el: HTMLElement, tpl: string, time: string) {
    const i = tpl.indexOf('{t}');
    const plain = tpl.replace('{t}', time);
    if (i < 0) {
      if (el.textContent !== plain || el.children.length) el.textContent = plain;
      return;
    }
    if (el.textContent === plain && el.querySelector('[data-nav-open-time]')) return;
    el.textContent = '';
    el.append(tpl.slice(0, i));
    const m = document.createElement('span');
    m.className = 'font-mono tabular-nums';
    m.setAttribute('data-nav-open-time', '');
    m.textContent = time;
    el.append(m, tpl.slice(i + 3));
  }

  function applyNavRegisterLabel(state: RegistrationState, seatsLeft: number, openAt: number = DEFAULT_OPEN_AT) {
    const time = formatNavOpenTime(openAt);
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-register]').forEach((link) => {
      const text = link.querySelector<HTMLElement>('[data-nav-register-label]');
      const style = text?.dataset.navLabelStyle === 'compact' ? 'compact' : 'wide';
      const { label, href, muted } = labelForState(state, seatsLeft, openAt, style);
      if (text) setNavLabel(text, label, time);
      link.setAttribute('href', href);
      link.classList.toggle('is-pre-open', muted);
    });
  }

  function applyNavDrawerMeta(openAt: number, maxCapacity: number) {
    const dot = formatNavOpenDot(openAt);
    const cap = String(maxCapacity);
    document.querySelectorAll<HTMLElement>('[data-nav-open-dot]').forEach((el) => {
      el.textContent = dot;
    });
    document.querySelectorAll<HTMLElement>('[data-nav-max-cap]').forEach((el) => {
      el.textContent = cap;
    });
  }

  function applyNavStatusVisibility(state: RegistrationState) {
    // Nobody can have applied before opening, so the status check has nothing to look up.
    // Keep the link visible on the status page itself so the current-page nav item never vanishes.
    const hide = state === 'PRE_OPEN';
    document.querySelectorAll<HTMLElement>('[data-nav-status]').forEach((link) => {
      if (link.classList.contains('is-active')) return;
      link.style.display = hide ? 'none' : '';
    });
  }

  function resolveState(settings: NavSettings): RegistrationState {
    const parsedOpenAt = settings.registrationOpenAt ? new Date(settings.registrationOpenAt).getTime() : DEFAULT_OPEN_AT;
    const openAt = Number.isFinite(parsedOpenAt) ? parsedOpenAt : DEFAULT_OPEN_AT;
    const parsedCloseAt = settings.registrationCloseAt ? new Date(settings.registrationCloseAt).getTime() : DEFAULT_CLOSE_AT;
    const closeAt = Number.isFinite(parsedCloseAt) ? parsedCloseAt : DEFAULT_CLOSE_AT;
    const serverEpoch = settings.serverTime ? new Date(settings.serverTime).getTime() : Number.NaN;
    const offset = Number.isFinite(serverEpoch) ? serverEpoch - Date.now() : 0;
    const now = Date.now() + offset;
    const max = typeof settings.maxCapacity === 'number' && settings.maxCapacity > 0 ? settings.maxCapacity : 40;
    const count = typeof settings.currentCount === 'number' ? settings.currentCount : 0;
    const seatsLeft = Math.max(0, max - count);

    if (now < openAt && !settings.isOpen) return 'PRE_OPEN';
    if (Number.isFinite(closeAt) && now >= closeAt) return 'CLOSED';
    if (seatsLeft <= 0) return 'FULL';
    if (!settings.isOpen) return 'CLOSED';
    if (seatsLeft <= 5) return 'ALMOST_FULL';
    return 'OPEN';
  }

  async function initNavRegisterState() {
    if (!document.querySelector('[data-nav-register]')) return;

    const base =
      import.meta.env.PUBLIC_API_URL ||
      (typeof window !== 'undefined' && (window as any).__CC25_API_BASE_URL__) ||
      'http://localhost:8000/api';

    try {
      const settings = (await fetchSharedPublicSettings(base, { timeoutMs: 4000 })) as NavSettings;
      const parsedOpenAt = settings.registrationOpenAt ? new Date(settings.registrationOpenAt).getTime() : DEFAULT_OPEN_AT;
      const openAt = Number.isFinite(parsedOpenAt) ? parsedOpenAt : DEFAULT_OPEN_AT;
      const state = resolveState(settings);
      const max = typeof settings.maxCapacity === 'number' && settings.maxCapacity > 0 ? settings.maxCapacity : 40;
      const count = typeof settings.currentCount === 'number' ? settings.currentCount : 0;
      applyNavRegisterLabel(state, Math.max(0, max - count), openAt);
      applyNavDrawerMeta(openAt, max);
      applyNavStatusVisibility(state);
    } catch {
      // Fail closed when unreachable: PRE_OPEN before openAt, CLOSED after openAt.
      const fallbackState: RegistrationState = Date.now() < DEFAULT_OPEN_AT ? 'PRE_OPEN' : 'CLOSED';
      applyNavRegisterLabel(fallbackState, 0, DEFAULT_OPEN_AT);
      applyNavDrawerMeta(DEFAULT_OPEN_AT, 40);
      applyNavStatusVisibility(fallbackState);
    }
  }

  initNavRegisterState();
  document.addEventListener('astro:page-load', initNavRegisterState);

  function initThemeToggle() {
    const btns = document.querySelectorAll<HTMLElement>('.theme-toggle-btn, .theme-toggle-drawer');
    if (!btns.length) return;

    const isCurrentDark = () => document.documentElement.classList.contains('dark');

    const updateUI = (isDark: boolean) => {
      btns.forEach((btn) => {
        btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
        btn.setAttribute(
          'title',
          isDark ? 'เปลี่ยนเป็นโหมดสว่าง (Light Mode)' : 'เปลี่ยนเป็นโหมดมืด (Dark Mode)'
        );
        const drawerState = btn.querySelector('.theme-drawer-state');
        if (drawerState) {
          drawerState.textContent = isDark ? 'โหมดมืด' : 'โหมดสว่าง';
        }
      });
    };

    updateUI(isCurrentDark());

    btns.forEach((btn) => {
      if (btn.dataset.themeBound === 'true') return;
      btn.dataset.themeBound = 'true';

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const nextDark = !isCurrentDark();
        if (nextDark) {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
          try { localStorage.setItem('comcamp-theme', 'dark'); } catch (err) {}
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
          try { localStorage.setItem('comcamp-theme', 'light'); } catch (err) {}
        }
        updateUI(nextDark);
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { dark: nextDark } }));
      });
    });

    if (!(window as any).__CC25_THEME_LISTENER_ATTACHED__) {
      (window as any).__CC25_THEME_LISTENER_ATTACHED__ = true;
      window.addEventListener('theme-changed', () => {
        updateUI(isCurrentDark());
      });
    }
  }

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
