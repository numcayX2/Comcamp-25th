---
interface Props {
  active?: 'home' | 'register' | 'status' | 'admin';
  isHome?: boolean;
}

const { active = 'home', isHome = false } = Astro.props;
const isAdmin = active === 'admin';
// Staff work on one page: the camp's marketing anchors, the sign-up CTA and the status lookup are noise there.
const navLinks = isAdmin ? [] : [
  { n: '02', href: isHome ? '#experience' : '/#experience', label: 'กิจกรรม' },
  { n: '03', href: isHome ? '#essentials' : '/#essentials', label: 'ข้อมูล' },
  { n: '04', href: isHome ? '#journey' : '/#journey', label: 'เส้นทาง' },
  { n: '05', href: isHome ? '#timeline' : '/#timeline', label: 'ไทม์ไลน์' },
  { n: '06', href: isHome ? '#faq' : '/#faq', label: 'FAQ' },
  { n: '07', href: isHome ? '#gallery' : '/#gallery', label: 'แกลเลอรี' },
];
---

<a class="skip-link" href="#main">ข้ามไปยังเนื้อหาหลัก</a>

<header class:list={['site-nav', (isHome || active === 'home') && 'is-home']}>
  <div class="wrap nav-inner">
    <!-- Brand Link -->
    <a
      class="brand"
      href={isHome ? '#main' : '/'}
      aria-label="ComCamp #25 · กลับขึ้นด้านบน"
    >
      <picture>
        <source srcset="/assets/logo/comcamp25-logo-sm.webp" type="image/webp" />
        <img
          class="brand-logo"
          src="/assets/logo/comcamp25-logo-sm.png"
          alt=""
          width="420"
          height="297"
          decoding="async"
        />
      </picture>
      <span class="brand-word">ComCamp <span class="font-mono tabular-nums">#25</span></span>
      {isAdmin && <span class="brand-tag">Staff</span>}
    </a>

    <!-- Navigation Links -->
    <nav class="nav-links" id="site-menu" aria-label="ส่วนต่าง ๆ ของหน้า">
      {navLinks.map((link) => (
        <a href={link.href}><span class="nav-num" aria-hidden="true">{link.n}</span>{link.label}</a>
      ))}

      <!-- Mobile-only drawer items -->
      {isAdmin ? (
        <a href="/" class="nav-mobile-item">← กลับหน้าเว็บไซต์</a>
      ) : (
        <>
          <div class="nav-mobile-divider" aria-hidden="true"></div>
          <a
            href="/register"
            data-nav-register
            data-register-link={isHome ? '' : undefined}
            class:list={['nav-mobile-item', active === 'register' && 'is-active']}
            aria-current={active === 'register' ? 'page' : undefined}
          >
            <span data-nav-register-label>เปิดรับ 16 พ.ย. 69</span>
          </a>
          <a
            data-nav-status
            href="/status"
            class:list={['nav-mobile-item', active === 'status' && 'is-active']}
            aria-current={active === 'status' ? 'page' : undefined}
          >
            ตรวจสอบสถานะ
          </a>
        </>
      )}

      <!-- Mobile Theme Toggle row in drawer -->
      <button
        class="nav-mobile-item theme-toggle-drawer"
        type="button"
        aria-label="เปลี่ยนโหมดการแสดงผล (Light / Dark Mode)"
      >
        <span class="theme-drawer-text">โหมดการแสดงผล</span>
        <span class="theme-drawer-badge">
          <span class="theme-drawer-state">Light Mode</span>
          <svg class="theme-icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2"></path>
            <path d="M12 20v2"></path>
            <path d="m4.93 4.93 1.41 1.41"></path>
            <path d="m17.66 17.66 1.41 1.41"></path>
            <path d="M2 12h2"></path>
            <path d="M20 12h2"></path>
            <path d="m6.34 17.66-1.41 1.41"></path>
            <path d="m19.07 4.93-1.41 1.41"></path>
          </svg>
          <svg class="theme-icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </span>
      </button>
      {!isAdmin && (
        <div class="nav-overlay-footer" aria-label="ข้อมูลค่าย">
          <p class="nav-overlay-label">[ ข้อมูลค่าย ]</p>
          <p class="nav-overlay-text">คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้</p>
          <p class="nav-overlay-text">เปิดรับ <span class="font-mono tabular-nums">16.11.69 · 30</span> ที่นั่ง</p>
          <p class="nav-overlay-copy">© 2569 ComCamp #25 · CS MJU</p>
        </div>
      )}
    </nav>

    {/* Mobile Controls: registration action (home) + menu toggle.
        Theme switching lives in the drawer (.theme-toggle-drawer).
        #sticky-cta / #sticky-mini are driven by public/theme/main.js — keep the ids. */}
    <div class="nav-mobile-controls">
      {isHome && (
        <>
          <button
            id="sticky-cta"
            class="nav-quick-cta"
            type="button"
            disabled
            aria-disabled="true"
            aria-describedby="sticky-mini"
          >16 พ.ย. 69</button>
          <span id="sticky-mini" class="sr-only">กำลังโหลดสถานะ</span>
        </>
      )}

      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu"
        aria-label="เมนูนำทาง"
      >
        <span class="nav-toggle-label">เมนู</span>
        <span class="nav-toggle-icon" aria-hidden="true"></span>
      </button>
    </div>

    <!-- Right-Side Action Area (Desktop >=900px) -->
    <div class="nav-actions">
      {isAdmin ? (
        <a class="btn btn-secondary nav-cta" href="/">← กลับหน้าเว็บไซต์</a>
      ) : (
        <>
          <a
            data-nav-register
            data-register-link={isHome ? '' : undefined}
            class:list={['btn btn-primary nav-cta', active === 'register' && 'is-active']}
            href="/register"
            aria-current={active === 'register' ? 'page' : undefined}
          >
            <span data-nav-register-label>เปิดรับ 16 พ.ย. 69</span>
          </a>
          <a
            data-nav-status
            class:list={['btn btn-secondary nav-cta', active === 'status' && 'is-active']}
            href="/status"
            aria-current={active === 'status' ? 'page' : undefined}
          >
            ตรวจสอบสถานะ
          </a>
        </>
      )}

      <!-- Desktop Theme Toggle Button -->
      <button
        class="theme-toggle-btn theme-toggle-btn--desktop"
        type="button"
        aria-label="สลับโหมดสว่าง/มืด (Light / Dark Mode)"
        title="สลับโหมดสว่าง/มืด"
      >
        <svg class="theme-icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg class="theme-icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  /* Accessibility Skip Link */
  .skip-link {
    position: fixed;
    left: 16px;
    top: 10px;
    z-index: 200;
    padding: 10px 18px;
    border-radius: 9999px;
    background: #121316;
    color: #F9F8F4;
    font-family: 'IBM Plex Sans Thai', system-ui, -apple-system, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-220%);
    transition: transform 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .skip-link:focus {
    transform: none;
    outline: 2px solid #1A5FE0;
    outline-offset: 2px;
  }
  /* Nav archetype: editorial masthead — a flat full-width bar with a hairline
     bottom rule once scrolled. No floating pill, no glass, no shadow. */
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    max-width: 100%;
    overflow-x: clip;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.12s linear;
    font-family: 'IBM Plex Sans Thai', system-ui, -apple-system, sans-serif;
  }
  .site-nav.is-scrolled {
    background: var(--canvas-0);
    border-bottom-color: rgba(18, 19, 22, 0.14);
  }
  .site-nav.is-home {
    position: fixed !important;
    top: 0;
    left: 0;
    right: 0;
    width: 100%;
    z-index: 100;
    pointer-events: none;
  }
  .site-nav.is-home .nav-inner {
    pointer-events: auto;
  }
  .site-nav.is-hidden {
    transform: translateY(-100%);
    pointer-events: none;
  }
  .wrap {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
  }
  @media (min-width: 900px) {
    .wrap {
      width: min(1120px, calc(100% - 48px));
    }
    .site-nav.is-home .wrap {
      width: min(1240px, calc(100% - 48px));
    }
  }
  /* Bar content row — plain flex. The hairline lives on the header so it can
     span the full viewport width. */
  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 64px;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  /* Brand Link */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1;
    color: #121316;
    text-decoration: none;
    white-space: nowrap;
    padding: 6px 0;
    flex: none;
  }
  .brand:hover {
    color: #121316;
    text-decoration: none;
  }
  .brand .font-mono {
    color: #4A4D55;
    font-size: 0.9375rem;
  }
  .brand-logo {
    width: 42px;
    height: 30px;
    object-fit: contain;
    flex: none;
  }
  .font-mono {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-weight: 500;
  }
  .tabular-nums {
    font-variant-numeric: tabular-nums;
  }
  /* Nav Links */
  .nav-links {
    display: none;
    align-items: center;
    gap: 20px;
    margin-left: auto;
  }
  .nav-num {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #62666E;
    margin-right: 6px;
  }
  .nav-links a {
    display: inline-flex;
    align-items: center;
    font-size: 0.9375rem;
    color: #4A4D55;
    text-decoration: none;
    white-space: nowrap;
    padding: 6px 0;
    transition: color 0.15s ease;
  }
  .nav-links a:hover {
    color: #121316;
    text-decoration: underline;
    text-decoration-color: rgba(18, 19, 22, 0.22);
    text-underline-offset: 4px;
  }
  .nav-links a[aria-current] {
    color: #121316;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: #121316;
    text-underline-offset: 6px;
  }
  .nav-links a[aria-current] .nav-num {
    color: #1A5FE0;
  }
  /* Nav Toggle Button */
  .nav-toggle {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-left: auto;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid rgba(18, 19, 22, 0.22);
    border-radius: 9999px;
    background: transparent;
    color: #121316;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
  }
  .nav-toggle:hover {
    border-color: #121316;
  }
  .nav-toggle-icon {
    position: relative;
    width: 14px;
    height: 10px;
    flex: none;
  }
  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    border-radius: 2px;
    background: currentColor;
    transition:
      transform 0.15s cubic-bezier(0.16, 1, 0.3, 1),
      top 0.15s cubic-bezier(0.16, 1, 0.3, 1),
      bottom 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-toggle-icon::before {
    top: 0;
  }
  .nav-toggle-icon::after {
    bottom: 0;
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-icon::before {
    top: 4px;
    transform: rotate(45deg);
  }
  .nav-toggle[aria-expanded="true"] .nav-toggle-icon::after {
    bottom: 4px;
    transform: rotate(-45deg);
  }

  /* Nav Actions (Desktop) */
  .nav-actions {
    display: none;
  }

  .brand-tag {
    margin-left: 10px;
    padding: 2px 10px;
    border: 1px solid currentColor;
    border-radius: 9999px;
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.7;
    vertical-align: middle;
  }

  .nav-cta-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #4A4D55;
    text-decoration: none;
    white-space: nowrap;
    padding: 6px 12px;
    border-radius: 0;
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-cta-link:hover {
    color: #121316;
    background: rgba(18, 19, 22, 0.05);
    text-decoration: none;
  }

  .nav-cta-link.is-active,
  .nav-cta-link[aria-current="page"] {
    color: #121316;
    font-weight: 600;
    background: transparent;
  }

  /* Registration not open yet — honest, quiet label instead of a live CTA */
  .nav-cta-link.is-pre-open,
  .nav-cta-link.is-pre-open:hover {
    color: #62666E;
    font-weight: 600;
    background: transparent;
  }

  /* Buttons */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 0;
    cursor: pointer;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.5;
    border-radius: 9999px;
    padding: 0 18px;
    min-height: 44px;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background 0.18s ease,
      transform 0.18s ease,
      box-shadow 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease;
    touch-action: manipulation;
    box-sizing: border-box;
  }

  .btn-secondary {
    background: #121316;
    color: #F9F8F4;
    border: 1px solid #121316;
  }
  .btn-secondary:hover {
    border-color: #121316;
    background: #2A2D33;
    color: #F9F8F4;
    text-decoration: none;
  }

  /* Primary CTA: fern pill with ink text (AGENTS.md §4), sits beside the dark status pill at the same size. */
  .btn-primary {
    background: #03B800;
    color: #121316;
    border: 1px solid #03B800;
  }
  .btn-primary:hover {
    background: #029E00;
    border-color: #029E00;
    color: #121316;
    text-decoration: none;
  }
  .btn-primary:active {
    transform: translateY(1px);
  }
  /* Not open (yet) / full / closed: same pill, quiet outline instead of a live CTA */
  .btn-primary.is-pre-open,
  .btn-primary.is-pre-open:hover {
    background: transparent;
    color: #4A4D55;
    border-color: #8A8D93;
  }
  :global(html.dark) .btn-primary.is-pre-open,
  :global(html[data-theme="dark"]) .btn-primary.is-pre-open {
    color: #C3C4C7;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .btn-secondary:active {
    transform: translateY(1px);
  }

  .btn-secondary.is-active,
  .btn-secondary[aria-current="page"] {
    background: #03B800;
    color: #121316;
    border-color: #03B800;
  }

  .btn-secondary.is-active:hover {
    background: #029E00;
    color: #121316;
    border-color: #029E00;
  }

  .nav-cta {
    font-size: 0.9375rem;
  }

  /* Mobile Responsive — full-screen overlay menu (<900px so tablet portrait never overflows).
     Big stacked type up top, camp info pinned to the bottom.
     The panel wipes in as one piece; items appear with it, no stagger. */
  @media (max-width: 899px) {
    .nav-actions {
      display: none;
    }
    /* Brand + menu button stay above the overlay so the bar stays usable. */
    .brand,
    .nav-mobile-controls {
      position: relative;
      z-index: 70;
    }
    .nav-links {
      position: fixed;
      inset: 0;
      z-index: 60;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      box-sizing: border-box;
      max-width: 100vw;
      margin: 0;
      padding: 96px 28px calc(20px + env(safe-area-inset-bottom));
      background: #F9F8F4;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      transform: translateX(102%);
      visibility: hidden;
      pointer-events: none;
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.45s;
    }
    .nav-links.is-open {
      display: flex;
      transform: none;
      visibility: visible;
      pointer-events: auto;
      transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
    /* Section links: editorial Table-of-Contents rows with mono chapter index */
    .nav-links a:has(.nav-num) {
      display: grid;
      grid-template-columns: 32px minmax(0, 1fr);
      align-items: baseline;
      column-gap: 10px;
      min-height: 0;
      padding: 8px 0;
      font-size: clamp(1.45rem, 6.2vw, 2.15rem);
      font-weight: 700;
      line-height: 1.3;
      letter-spacing: 0;
      color: #121316;
      border-bottom: 1px solid rgba(18, 19, 22, 0.08);
    }
    .nav-links a:has(.nav-num) .nav-num {
      display: inline-block;
      margin: 0;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      color: #62666E;
    }
    .nav-links a:has(.nav-num):hover {
      color: #1A5FE0;
      text-decoration: none;
    }
    .nav-links a {
      justify-content: flex-start;
      min-height: 48px;
      font-size: 1rem;
      border-bottom: 1px solid rgba(18, 19, 22, 0.10);
    }
    .nav-links a[aria-current] {
      text-decoration: none;
      font-weight: 600;
    }
    /* Section links sit static; only the panel itself animates. */
    .nav-mobile-divider {
      display: block;
      height: 1px;
      background: rgba(18, 19, 22, 0.10);
      margin: 6px 0;
    }
    .nav-mobile-item {
      font-weight: 600;
      color: #121316 !important;
    }
    .nav-mobile-item.is-active {
      color: #121316 !important;
    }
    .nav-mobile-item.is-pre-open {
      color: #62666E !important;
    }
    /* Overlay footer: camp info pinned to the bottom. */
    .nav-overlay-footer {
      margin-top: auto;
      padding-top: 24px;
    }
    .nav-overlay-label {
      margin: 0 0 8px;
      font-family: 'IBM Plex Sans Thai', system-ui, -apple-system, sans-serif;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0;
      color: #121316;
    }
    .nav-overlay-text {
      margin: 0;
      font-size: 0.9375rem;
      line-height: 1.75;
      color: #4A4D55;
    }
    .nav-overlay-copy {
      margin: 14px 0 0;
      font-size: 0.8125rem;
      color: #62666E;
    }
  }

  /* Theme Toggle Button (Desktop & Mobile) */
  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    border: 1px solid rgba(18, 19, 22, 0.18);
    background: transparent;
    color: #121316;
    cursor: pointer;
    flex: none;
    padding: 0;
    transition: transform 0.18s ease, border-color 0.18s ease, background-color 0.18s ease;
    touch-action: manipulation;
  }
  .theme-toggle-btn:hover {
    border-color: #121316;
    background: rgba(18, 19, 22, 0.05);
    transform: scale(1.04);
  }

  .theme-toggle-btn:active {
    transform: scale(0.96);
  }

  .theme-toggle-btn:focus-visible {
    outline: 2px solid #1A5FE0;
    outline-offset: 2px;
  }

  .theme-icon-sun {
    display: none;
    color: #B45309;
  }

  .theme-icon-moon {
    display: block;
    color: #4A4D55;
  }

  /* When dark mode is active on html root */
  :global(html.dark) .theme-icon-sun,
  :global(html[data-theme="dark"]) .theme-icon-sun {
    display: block !important;
    color: #F59E0B;
  }

  :global(html.dark) .theme-icon-moon,
  :global(html[data-theme="dark"]) .theme-icon-moon {
    display: none !important;
  }

  :global(html.dark) .theme-toggle-btn,
  :global(html[data-theme="dark"]) .theme-toggle-btn {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.2);
    color: #F5F4EF;
  }
  :global(html.dark) .theme-toggle-btn:hover,
  :global(html[data-theme="dark"]) .theme-toggle-btn:hover {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.08);
  }

  /* Mobile Controls Area */
  .nav-mobile-controls {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  /* Mobile registration action (replaces the old bottom sticky bar).
     Square like .nav-toggle beside it; fern fill only when it actually does something. */
  .nav-quick-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid transparent;
    border-radius: 9999px;
    background: #03B800;
    color: #121316;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color 0.18s ease;
  }
  .nav-quick-cta:hover:not(:disabled) { background: #029E00; }
  .nav-quick-cta:focus-visible { outline: 2px solid #1A5FE0; outline-offset: 2px; }
  /* Links and toggles share the blue focus ring (AGENTS §11.3) instead of the browser default. */
  .site-nav a:focus-visible,
  .site-nav button:focus-visible {
    outline: 2px solid var(--color-tech, #1A5FE0);
    outline-offset: 2px;
  }
  /* Pre-open / closed: informational, not a dead green button */
  .nav-quick-cta:disabled {
    background: transparent;
    border-color: rgba(18, 19, 22, 0.14);
    color: #4A4D55;
    cursor: default;
  }
  :global(html.dark) .nav-quick-cta:disabled,
  :global(html[data-theme="dark"]) .nav-quick-cta:disabled {
    border-color: rgba(255, 255, 255, 0.2);
    color: #C3C4C7;
  }
  /* Narrow phones: logo-only brand so the action + menu button never get pushed off-screen.
     The link keeps its aria-label ("ComCamp #25 · กลับขึ้นด้านบน"). */
  @media (max-width: 399px) {
    .site-nav.is-home .brand-word { display: none; }
  }

  .theme-toggle-drawer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 48px;
    padding: 0 4px;
    background: transparent;
    border: 0;
    border-bottom: 1px solid rgba(18, 19, 22, 0.10);
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: #121316;
    cursor: pointer;
    text-align: left;
  }

  .theme-drawer-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 9999px;
    border: 1px solid rgba(18, 19, 22, 0.14);
    font-size: 0.75rem;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-weight: 500;
    background: rgba(18, 19, 22, 0.04);
  }

  /* Dark Mode Navbar Overrides */
  :global(html.dark) .site-nav.is-scrolled,
  :global(html[data-theme="dark"]) .site-nav.is-scrolled {
    background: #1A1D22;
    border-bottom-color: rgba(255, 255, 255, 0.14);
  }

  :global(html.dark) .brand,
  :global(html[data-theme="dark"]) .brand {
    color: #F5F4EF;
  }

  :global(html.dark) .brand .font-mono,
  :global(html[data-theme="dark"]) .brand .font-mono {
    color: #9A9CA1;
  }

  :global(html.dark) .nav-links a,
  :global(html[data-theme="dark"]) .nav-links a {
    color: #9A9CA1;
  }

  :global(html.dark) .nav-links a:hover,
  :global(html[data-theme="dark"]) .nav-links a:hover {
    color: #F5F4EF;
    text-decoration-color: rgba(255, 255, 255, 0.35);
  }

  :global(html.dark) .nav-links a[aria-current],
  :global(html[data-theme="dark"]) .nav-links a[aria-current] {
    color: #F5F4EF;
    text-decoration-color: #F5F4EF;
  }
  :global(html.dark) .nav-num,
  :global(html[data-theme="dark"]) .nav-num {
    color: #9A9CA1;
  }
  :global(html.dark) .nav-links a[aria-current] .nav-num,
  :global(html[data-theme="dark"]) .nav-links a[aria-current] .nav-num {
    color: #7FA8FF;
  }

  :global(html.dark) .nav-cta-link,
  :global(html[data-theme="dark"]) .nav-cta-link {
    color: #C3C4C7;
  }

  :global(html.dark) .nav-cta-link:hover,
  :global(html[data-theme="dark"]) .nav-cta-link:hover {
    color: #F5F4EF;
    background: rgba(255, 255, 255, 0.08);
  }

  :global(html.dark) .nav-toggle,
  :global(html[data-theme="dark"]) .nav-toggle {
    color: #F5F4EF;
    border-color: rgba(255, 255, 255, 0.2);
  }

  :global(html.dark) .btn-secondary,
  :global(html[data-theme="dark"]) .btn-secondary {
    background: #F5F4EF;
    color: #121316;
    border-color: #F5F4EF;
  }
  :global(html.dark) .btn-secondary:hover,
  :global(html[data-theme="dark"]) .btn-secondary:hover {
    background: #FFFFFF;
    color: #121316;
    border-color: #FFFFFF;
  }

  @media (max-width: 899px) {
    .theme-toggle-btn--desktop {
      display: none !important;
    }

    :global(html.dark) .nav-links,
    :global(html[data-theme="dark"]) .nav-links {
      background: #1A1D22;
      border-color: rgba(255, 255, 255, 0.14);
      box-shadow: none;
    }
    :global(html.dark) .nav-links a:has(.nav-num),
    :global(html[data-theme="dark"]) .nav-links a:has(.nav-num) {
      color: #F5F4EF;
      border-bottom-color: rgba(255, 255, 255, 0.08);
    }
    :global(html.dark) .nav-links a:has(.nav-num):hover,
    :global(html[data-theme="dark"]) .nav-links a:has(.nav-num):hover {
      color: #337AFF;
    }
    :global(html.dark) .nav-overlay-label,
    :global(html[data-theme="dark"]) .nav-overlay-label {
      color: #F5F4EF;
    }
    :global(html.dark) .nav-overlay-text,
    :global(html[data-theme="dark"]) .nav-overlay-text {
      color: #C3C4C7;
    }
    :global(html.dark) .nav-overlay-copy,
    :global(html[data-theme="dark"]) .nav-overlay-copy {
      color: #9A9CA1;
    }

    :global(html.dark) .nav-mobile-divider,
    :global(html[data-theme="dark"]) .nav-mobile-divider {
      background: rgba(255, 255, 255, 0.1);
    }

    :global(html.dark) .nav-mobile-item,
    :global(html[data-theme="dark"]) .nav-mobile-item {
      color: #F5F4EF !important;
    }

    :global(html.dark) .theme-toggle-drawer,
    :global(html[data-theme="dark"]) .theme-toggle-drawer {
      border-bottom-color: rgba(255, 255, 255, 0.08);
      color: #F5F4EF;
    }

    :global(html.dark) .theme-drawer-badge,
    :global(html[data-theme="dark"]) .theme-drawer-badge {
      border-color: rgba(255, 255, 255, 0.22);
      background: rgba(255, 255, 255, 0.08);
      color: #F5F4EF;
    }
  }

  @media (min-width: 900px) {
    .nav-mobile-controls {
      display: none !important;
    }

    .theme-toggle-drawer {
      display: none !important;
    }
    .nav-links {
      display: flex;
    }

    .nav-toggle {
      display: none;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-left: 12px;
      flex: none;
    }

    .nav-mobile-divider,
    .nav-mobile-item,
    .nav-overlay-footer {
      display: none !important;
    }
  }

  /* Compact desktop tier (900px–1119px): keeps 6 numbered links + CTAs on one row without wrap or collision */
  @media (min-width: 900px) and (max-width: 1119px) {
    .nav-inner {
      gap: 10px;
    }
    .brand {
      gap: 8px;
      font-size: 0.9375rem;
    }
    .brand-logo {
      width: 34px;
      height: 24px;
    }
    .brand .font-mono {
      font-size: 0.875rem;
    }
    .nav-links {
      gap: 10px;
    }
    .nav-links a {
      font-size: 0.8125rem;
    }
    .nav-num {
      font-size: 0.625rem;
      margin-right: 4px;
    }
    .nav-actions {
      gap: 6px;
      margin-left: 4px;
    }
    .nav-cta {
      font-size: 0.8125rem;
      padding: 0 12px;
      min-height: 44px;
    }
    .theme-toggle-btn {
      width: 38px;
      height: 38px;
    }
  }

  /* Mid desktop tier (1120px–1259px) */
  @media (min-width: 1120px) and (max-width: 1259px) {
    .nav-inner {
      gap: 12px;
    }
    .nav-links {
      gap: 14px;
    }
    .nav-links a {
      font-size: 0.875rem;
    }
    .nav-num {
      margin-right: 5px;
    }
    .nav-actions {
      margin-left: 8px;
    }
    .nav-cta {
      font-size: 0.875rem;
      padding: 0 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav,
    .nav-inner,
    .nav-links,
    .nav-links > *,
    .nav-links a,
    .btn,
    .nav-toggle-icon::before,
    .nav-toggle-icon::after {
      transition: none !important;
    }
    .nav-links,
    .nav-links > *,
    .nav-links.is-open > * {
      opacity: 1 !important;
      transform: none !important;
    }
  }
</style>

<script>
  import { fetchSharedPublicSettings } from '../lib/public-settings-cache';

  function initSiteNav() {
    const nav = document.querySelector<HTMLElement>('.site-nav');
    const toggle = document.querySelector<HTMLButtonElement>('.site-nav .nav-toggle');
    const menu = document.getElementById('site-menu');

    if (toggle && menu) {
      const syncInert = (open: boolean) => {
        menu.inert = !open && window.innerWidth < 768;
      };
      syncInert(toggle.getAttribute('aria-expanded') === 'true');

      if (toggle.dataset.ccNavBound !== 'true') {
        toggle.dataset.ccNavBound = 'true';

        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          menu.classList.toggle('is-open', open);
          syncInert(open);
          document.body.style.overflow = open && window.innerWidth < 768 ? 'hidden' : '';
        };

        // Capture phase + stopImmediatePropagation prevents duplicate listener in main.js on HomePage
        toggle.addEventListener(
          'click',
          (e) => {
            e.stopPropagation();
            e.stopImmediatePropagation();
            const isOpen = toggle.getAttribute('aria-expanded') === 'true';
            setOpen(!isOpen);
          },
          { capture: true }
        );

        menu.addEventListener('click', (e) => {
          const target = e.target as HTMLElement | null;
          if (target?.closest('a')) {
            setOpen(false);
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });

        const wide = window.matchMedia('(min-width: 900px)');
        const onWide = () => {
          if (wide.matches) {
            setOpen(false);
            menu.inert = false;
          } else {
            syncInert(toggle.getAttribute('aria-expanded') === 'true');
          }
        };
        if (wide.addEventListener) {
          wide.addEventListener('change', onWide);
        } else if ('addListener' in wide) {
          (wide as any).addListener(onWide);
        }
      }
    }

    if (nav && nav.dataset.ccScrollBound !== 'true') {
      nav.dataset.ccScrollBound = 'true';
      const onScroll = () => {
        nav.classList.toggle('is-scrolled', window.scrollY > 8);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }

  initSiteNav();
  document.addEventListener('astro:page-load', initSiteNav);

  type RegistrationState = 'PRE_OPEN' | 'OPEN' | 'ALMOST_FULL' | 'FULL' | 'CLOSED';

  interface NavSettings {
    serverTime?: string;
    registrationOpenAt?: string;
    isOpen?: boolean;
    currentCount?: number;
    maxCapacity?: number;
  }

  const DEFAULT_OPEN_AT = new Date('2026-11-16T00:00:00+07:00').getTime();

  function labelForState(state: RegistrationState, seatsLeft: number): { label: string; href: string; muted: boolean } {
    switch (state) {
      case 'OPEN':
        return { label: 'สมัครค่าย', href: '/register', muted: false };
      case 'ALMOST_FULL':
        return { label: `สมัครค่าย (เหลือ ${seatsLeft})`, href: '/register', muted: false };
      case 'FULL':
        return { label: 'ที่นั่งเต็มแล้ว', href: '/status', muted: true };
      case 'CLOSED':
        return { label: 'ปิดรับสมัครแล้ว', href: '/status', muted: true };
      default:
        return { label: 'เปิดรับ 16 พ.ย. 69', href: '/register', muted: true };
    }
  }

  function applyNavRegisterLabel(state: RegistrationState, seatsLeft: number) {
    const { label, href, muted } = labelForState(state, seatsLeft);
    document.querySelectorAll<HTMLAnchorElement>('[data-nav-register]').forEach((link) => {
      const text = link.querySelector('[data-nav-register-label]');
      if (text) text.textContent = label;
      link.setAttribute('href', href);
      link.classList.toggle('is-pre-open', muted);
    });
  }

  function applyNavStatusVisibility(state: RegistrationState) {
    // Nobody can have applied before opening, so the status check has nothing to look up.
    // Keep the link visible on the status page itself so the current-page nav item never vanishes.
    const hide = state === 'PRE_OPEN';
    document.querySelectorAll<HTMLElement>('[data-nav-status]').forEach((link) => {
      if (link.classList.contains('is-active')) return;
      link.style.display = hide ? 'none' : '';
    });
  }

  function resolveState(settings: NavSettings): RegistrationState {
    const openAt = settings.registrationOpenAt ? new Date(settings.registrationOpenAt).getTime() : DEFAULT_OPEN_AT;
    const serverEpoch = settings.serverTime ? new Date(settings.serverTime).getTime() : Number.NaN;
    const offset = Number.isFinite(serverEpoch) ? serverEpoch - Date.now() : 0;
    const now = Date.now() + offset;
    const max = typeof settings.maxCapacity === 'number' && settings.maxCapacity > 0 ? settings.maxCapacity : 30;
    const count = typeof settings.currentCount === 'number' ? settings.currentCount : 0;
    const seatsLeft = Math.max(0, max - count);

    if (now < openAt && !settings.isOpen) return 'PRE_OPEN';
    if (seatsLeft <= 0) return 'FULL';
    if (!settings.isOpen) return 'CLOSED';
    if (seatsLeft <= 5) return 'ALMOST_FULL';
    return 'OPEN';
  }

  async function initNavRegisterState() {
    if (!document.querySelector('[data-nav-register]')) return;

    const base =
      import.meta.env.PUBLIC_API_URL ||
      (typeof window !== 'undefined' && (window as any).__CC25_API_BASE_URL__) ||
      'http://localhost:8000/api';

    try {
      const settings = (await fetchSharedPublicSettings(base, { timeoutMs: 4000 })) as NavSettings;
      const state = resolveState(settings);
      const max = typeof settings.maxCapacity === 'number' && settings.maxCapacity > 0 ? settings.maxCapacity : 30;
      const count = typeof settings.currentCount === 'number' ? settings.currentCount : 0;
      applyNavRegisterLabel(state, Math.max(0, max - count));
      applyNavStatusVisibility(state);
    } catch {
      // Backend unreachable or slow: the server-rendered pre-open label stays as-is.
      applyNavRegisterLabel('PRE_OPEN', 0);
      applyNavStatusVisibility('PRE_OPEN');
    }
  }

  initNavRegisterState();
  document.addEventListener('astro:page-load', initNavRegisterState);

  function initThemeToggle() {
    const btns = document.querySelectorAll<HTMLElement>('.theme-toggle-btn, .theme-toggle-drawer');
    if (!btns.length) return;

    const isCurrentDark = () => document.documentElement.classList.contains('dark');

    const updateUI = (isDark: boolean) => {
      btns.forEach((btn) => {
        btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
        btn.setAttribute(
          'title',
          isDark ? 'เปลี่ยนเป็นโหมดสว่าง (Light Mode)' : 'เปลี่ยนเป็นโหมดมืด (Dark Mode)'
        );
        const drawerState = btn.querySelector('.theme-drawer-state');
        if (drawerState) {
          drawerState.textContent = isDark ? 'Dark Mode' : 'Light Mode';
        }
      });
    };

    updateUI(isCurrentDark());

    btns.forEach((btn) => {
      if (btn.dataset.themeBound === 'true') return;
      btn.dataset.themeBound = 'true';

      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const nextDark = !isCurrentDark();
        if (nextDark) {
          document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', 'dark');
          try { localStorage.setItem('comcamp-theme', 'dark'); } catch (err) {}
        } else {
          document.documentElement.classList.remove('dark');
          document.documentElement.setAttribute('data-theme', 'light');
          try { localStorage.setItem('comcamp-theme', 'light'); } catch (err) {}
        }
        updateUI(nextDark);
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: { dark: nextDark } }));
      });
    });

    if (!(window as any).__CC25_THEME_LISTENER_ATTACHED__) {
      (window as any).__CC25_THEME_LISTENER_ATTACHED__ = true;
      window.addEventListener('theme-changed', () => {
        updateUI(isCurrentDark());
      });
    }
  }

  initThemeToggle();
  document.addEventListener('astro:page-load', initThemeToggle);
</script>
