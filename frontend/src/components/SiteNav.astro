  }

  /* Mobile Controls Area */
  .nav-mobile-controls {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  /* Mobile registration action (replaces the old bottom sticky bar).
     Square like .nav-toggle beside it; fern fill only when it actually does something. */
  .nav-quick-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid transparent;
