<script>
  import { API_BASE } from '../lib/api';
  import { fetchSharedPublicSettings } from '../lib/public-settings-cache';
  import { formatBangkokTime, formatThaiDateFull } from '../lib/camp-facts';
  import {
    createLiquidGlassFilter,
    detectLiquidGlassMode,
    generateDisplacementMapUrl,
    updateLiquidGlassScale,
    type LiquidGlassFilterNodes,
  } from '../lib/liquid-glass';

  function formatGuideDateTime(iso: string): string {
    return `${formatThaiDateFull(iso)} เวลา ${formatBangkokTime(iso)} น.`;
  }

  async function syncGuidePublicSettings() {
    const openEls = document.querySelectorAll<HTMLElement>('[data-guide-date="open"]');
    const closeEls = document.querySelectorAll<HTMLElement>('[data-guide-date="close"]');
    if (!openEls.length && !closeEls.length) return;

    try {
      const settings = await fetchSharedPublicSettings(API_BASE, { timeoutMs: 4000 });

      if (settings.registrationOpenAt && Number.isFinite(Date.parse(settings.registrationOpenAt))) {
        const text = formatGuideDateTime(settings.registrationOpenAt);
        openEls.forEach((el) => {
          el.textContent = text;
        });
      }

      if (settings.registrationCloseAt && Number.isFinite(Date.parse(settings.registrationCloseAt))) {
        const text = formatGuideDateTime(settings.registrationCloseAt);
        closeEls.forEach((el) => {
          el.textContent = text;
        });
      }

      if (typeof settings.maxCapacity === 'number' && Number.isFinite(settings.maxCapacity) && settings.maxCapacity > 0) {
        const capText = String(settings.maxCapacity);
        document.querySelectorAll<HTMLElement>('[data-guide-seats]').forEach((el) => {
          el.textContent = capText;
        });
      }

      if (settings.campFee !== null && settings.campFee !== undefined && settings.campFee !== '') {
        const feeNum = typeof settings.campFee === 'number' ? settings.campFee : Number(settings.campFee);
        if (Number.isFinite(feeNum) && feeNum >= 0) {
          const feeText = feeNum.toLocaleString('en-US', { maximumFractionDigits: 2 });
          document.querySelectorAll<HTMLElement>('[data-guide-fee]').forEach((el) => {
            el.textContent = feeText;
          });
        }
      }
    } catch {
      /* Keep server-rendered fallback values when settings cannot be reached. */
    }
  }

  syncGuidePublicSettings();
  document.addEventListener('astro:page-load', syncGuidePublicSettings);

  // ClientRouter keeps window/document alive across pages: listeners bound for one visit to
  // /guide are dropped when the page is swapped out, instead of piling up on every visit.
  let tocAbort: AbortController | null = null;
  document.addEventListener('astro:before-swap', () => {
    tocAbort?.abort();
    tocAbort = null;
  });

  /* Table of contents: scroll-spy (aria-current), a sliding marker behind the active link and a
     reading-progress rail on desktop; on mobile the active chip is kept in view in its scroller.
     Enhance-only: without this script the ToC is the plain link list. */
  function initGuideToc() {
    const toc = document.getElementById('guide-toc');
    if (!toc || toc.dataset.spyBound === 'true') return;
    const track = toc.querySelector<HTMLElement>('.gd-toc__track');
    const list = toc.querySelector<HTMLElement>('.gd-toc__list');
    const content = document.querySelector<HTMLElement>('.gd-content');
    const rail = toc.querySelector<HTMLElement>('.gd-toc__rail');
    if (!track || !list || !content) return;
    const items = Array.from(toc.querySelectorAll<HTMLAnchorElement>('.gd-toc__link'))
      .map((link) => ({ link, sec: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
      .filter((it): it is { link: HTMLAnchorElement; sec: HTMLElement } => it.sec !== null);
    if (!items.length) return;
    toc.dataset.spyBound = 'true';
    tocAbort?.abort();
    const ac = new AbortController();
    tocAbort = ac;
    const { signal } = ac;

    const wide = window.matchMedia('(min-width: 900px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Glass mode is worked out once and again only when one of these settings changes; paint()
    // runs every spring frame and must not rebuild media queries or re-test CSS support each time.
    const glassPrefs = [
      '(prefers-reduced-transparency: reduce)',
      '(prefers-contrast: more)',
      '(forced-colors: active)',
    ].map((q) => window.matchMedia(q));
    let glassMode = detectLiquidGlassMode();
    let current: HTMLAnchorElement | null = null;
    let lockUntil = 0;
    let lockTimer = 0;
    let tick = 0;

    // The marker and the rail end ride one critically damped spring (damping ratio 1, response
    // 0.35 s). A new target while it is still moving keeps the current position AND velocity, so
    // scrolling fast through several sections reads as one glide instead of restarting each step.
    const RESPONSE_S = 0.35;
    const STIFFNESS = (2 * Math.PI / RESPONSE_S) ** 2;
    const DAMPING = (4 * Math.PI) / RESPONSE_S;
    const SUBSTEP = 1 / 240;
    const MAX_DT = 0.05;
    const springY = { x: 0, v: 0, to: 0 };
    const springH = { x: 0, v: 0, to: 0 };
    let railTop = 0;
    let railHeight = 0;
    let markerWidth = 0;
    let placed = false;
    let frame = 0;
    let lastFrame = 0;
    let layoutRaf = 0;

    // Aceternity Liquid Glass marker:
    // - Chromium ('refract'): Snell's-law squircle-dome displacement map (pre-decoded PNG blob URL)
    //   + RGB chromatic-aberration SVG filter applied via `backdrop-filter: url(#id)`. The interior
    //   plateau stays optically flat so active Thai text stays razor-sharp, while the curved 11px
    //   bevel bends light & swells smoothly as the spring glides over neighbouring links.
    // - Safari / Firefox ('simple'): Aceternity frosted glass fallback behind text.
    // - Reduced transparency / high contrast / forced colors ('opaque'): solid pill behind text.
    // At rest the bend is 0, so the active label inside the pill is as sharp as plain text; the rim
    // bends only while the pill glides (AGENTS.md §0.2 /guide). Reduced motion keeps it at 0.
    const marker = toc.querySelector<HTMLElement>('.gd-toc__marker');
    const filterHost = toc.querySelector<HTMLElement>('.gd-toc__filter-host');
    const GLASS_RADIUS = 999;
    const GLASS_BEVEL = 11;
    const GLASS_SCALE_REST = 0;
    const GLASS_SCALE_MAX = 48;
    const GLASS_ABERRATION_REST = 0;
    const GLASS_ABERRATION_MAX = 5;
    const GLASS_FROST = 0;
    const GLASS_SPEED_SATURATE = 320; // px/s spring speed that reaches full Aceternity 48px refraction

    interface CachedMap {
      url: string;
      isBlob: boolean;
    }
    const glassMaps = new Map<string, CachedMap>();
    let activeFilter: LiquidGlassFilterNodes | null = null;
    let glassKey = '';
    let pendingGlassKey = '';
    let glassBuildSeq = 0;
    let glassFilterCounter = 0;
    let lastMapWidth = 0;
    let glassResizeTimer = 0;
    let lastGlassH = '';
    let lastGlassScale = '';
    let lastMarkerY = '';
    let lastMarkerH = '';
    let lastProgress = '';

    const revokeGlassMaps = () => {
      for (const entry of glassMaps.values()) {
        if (entry.isBlob) URL.revokeObjectURL(entry.url);
      }
      glassMaps.clear();
    };

    const getGlassDynamics = (): { scale: number; aberration: number } => {
      if (reduceMotion.matches) {
        return { scale: GLASS_SCALE_REST, aberration: GLASS_ABERRATION_REST };
      }
      const speed = Math.abs(springY.v) + Math.abs(springH.v);
      const boost = Math.min(1, speed / GLASS_SPEED_SATURATE);
      return {
        scale: GLASS_SCALE_REST + (GLASS_SCALE_MAX - GLASS_SCALE_REST) * boost,
        aberration: GLASS_ABERRATION_REST + (GLASS_ABERRATION_MAX - GLASS_ABERRATION_REST) * boost,
      };
    };

    const resetGlassBend = () => {
      if (!activeFilter) return;
      const restingKey = `${GLASS_SCALE_REST.toFixed(2)}:${GLASS_ABERRATION_REST.toFixed(2)}`;
      if (lastGlassScale === restingKey) return;
      updateLiquidGlassScale(activeFilter, GLASS_SCALE_REST, GLASS_ABERRATION_REST);
      lastGlassScale = restingKey;
    };

    const teardownGlassFilter = () => {
      glassBuildSeq += 1;
      pendingGlassKey = '';
      glassKey = '';
      activeFilter = null;
      lastGlassH = '';
      lastGlassScale = '';
      filterHost?.replaceChildren();
      marker?.style.removeProperty('--gd-glass-filter');
    };

    const mountLiquidGlass = (w: number, h: number, mapUrl: string) => {
      if (!marker || !filterHost) return;
      // Fresh ID per rebuild because Chromium caches SVG filter output by ID.
      glassFilterCounter += 1;
      const id = `lg-toc-${w}x${h}-${glassFilterCounter.toString(36)}`;
      const { scale, aberration } = getGlassDynamics();
      const nodes = createLiquidGlassFilter({
        id,
        mapUrl,
        width: w,
        height: Math.max(1, springH.x || h),
        scale,
        maxScale: GLASS_SCALE_MAX,
        aberration,
        maxAberration: GLASS_ABERRATION_MAX,
        frost: GLASS_FROST,
      });
      filterHost.replaceChildren(nodes.svg);
      activeFilter = nodes;
      glassKey = `${w}x${h}`;
      lastGlassH = Math.max(1, springH.x || h).toFixed(2);
      lastGlassScale = `${scale.toFixed(2)}:${aberration.toFixed(2)}`;
      marker.style.setProperty('--gd-glass-filter', `url(#${id})`);
      if (toc.dataset.glass !== 'refract') toc.dataset.glass = 'refract';
    };

    const applyGlassMap = (w: number, h: number) => {
      if (!marker || !filterHost || w <= 0 || h <= 0) return;
      const key = `${w}x${h}`;
      if (key === glassKey || key === pendingGlassKey) return;

      // Width changed (viewport resize): drop maps from the previous width so memory stays tiny.
      if (w !== lastMapWidth) {
        revokeGlassMaps();
        lastMapWidth = w;
      }

      const cached = glassMaps.get(key);
      if (cached) {
        pendingGlassKey = '';
        mountLiquidGlass(w, h, cached.url);
        return;
      }

      const seq = ++glassBuildSeq;
      pendingGlassKey = key;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);

      generateDisplacementMapUrl({
        width: w,
        height: h,
        radius: Math.min(GLASS_RADIUS, w / 2, h / 2),
        bevelDepth: Math.min(GLASS_BEVEL, Math.min(w, h) / 2),
        dpr,
      })
        .then((entry) => {
          if (signal.aborted || seq !== glassBuildSeq || !wide.matches || glassMode !== 'refract') {
            if (entry.isBlob) URL.revokeObjectURL(entry.url);
            return;
          }
          pendingGlassKey = '';
          const existing = glassMaps.get(key);
          if (existing && existing.isBlob) URL.revokeObjectURL(existing.url);
          glassMaps.set(key, entry);
          mountLiquidGlass(w, h, entry.url);
        })
        .catch(() => {
          if (seq === glassBuildSeq) pendingGlassKey = '';
        });
    };

    const paintGlass = (deferWidthRedraw = false) => {
      if (!marker) return;
      if (!wide.matches) {
        if (toc.dataset.glass) delete toc.dataset.glass;
        return;
      }

      const mode = glassMode;
      if (mode === 'opaque') {
        teardownGlassFilter();
        if (toc.dataset.glass !== 'opaque') toc.dataset.glass = 'opaque';
        return;
      }
      if (mode === 'simple' || !filterHost) {
        teardownGlassFilter();
        if (toc.dataset.glass !== 'simple') toc.dataset.glass = 'simple';
        return;
      }

      const w = markerWidth;
      const h = Math.round(springH.to);
      if (w <= 0 || h <= 0) return;

      // Keep the frosted pill visible for the few ms while the first PNG displacement map decodes.
      if (!activeFilter && toc.dataset.glass !== 'simple') {
        toc.dataset.glass = 'simple';
      }

      const key = `${w}x${h}`;
      if (key !== glassKey && key !== pendingGlassKey) {
        if (deferWidthRedraw && glassKey && w !== lastMapWidth) {
          // While resizing the window, keep the active filter and rebuild once resize settles.
          window.clearTimeout(glassResizeTimer);
          glassResizeTimer = window.setTimeout(() => {
            glassResizeTimer = 0;
            if (signal.aborted || !wide.matches || glassMode !== 'refract') return;
            applyGlassMap(markerWidth, Math.round(springH.to));
          }, 120);
        } else {
          window.clearTimeout(glassResizeTimer);
          glassResizeTimer = 0;
          applyGlassMap(w, h);
        }
      }
      if (!activeFilter) return;

      // Stretch feImage height cleanly while springH interpolates between 1-line and 2-line items.
      const hStr = Math.max(1, springH.x).toFixed(2);
      if (hStr !== lastGlassH) {
        activeFilter.image.setAttribute('height', hStr);
        lastGlassH = hStr;
      }

      // Live Snell's-law refraction + RGB aberration: crisp resting rim, stronger bend while gliding.
      const { scale, aberration } = getGlassDynamics();
      const scaleKey = `${scale.toFixed(2)}:${aberration.toFixed(2)}`;
      if (scaleKey !== lastGlassScale) {
        updateLiquidGlassScale(activeFilter, scale, aberration);
        lastGlassScale = scaleKey;
      }
      if (toc.dataset.glass !== 'refract') toc.dataset.glass = 'refract';
    };

    // Cached layout metrics for every ToC link (measured outside the spring rAF loop to avoid
    // read-after-write layout thrashing). Preserves `zoom` so unchanged links skip style writes.
    const LENS_ZOOM = 0.06;
    interface LinkMetric {
      link: HTMLAnchorElement;
      top: number;
      height: number;
      mid: number;
      zoom: string;
    }
    const linkMetrics: LinkMetric[] = items.map(({ link }) => ({ link, top: 0, height: 0, mid: 0, zoom: '' }));
    const metricByLink = new Map<HTMLAnchorElement, LinkMetric>(linkMetrics.map((m) => [m.link, m]));

    const measureToc = () => {
      railTop = rail?.offsetTop ?? 0;
      railHeight = rail?.offsetHeight ?? 0;
      markerWidth = wide.matches ? (marker?.offsetWidth || list.offsetWidth) : 0;
      for (const box of linkMetrics) {
        box.top = box.link.offsetTop;
        box.height = box.link.offsetHeight;
        box.mid = box.top + box.height / 2;
      }
    };

    // Lens zoom: a label grows as the glass passes over it, up to LENS_ZOOM when the pill is centred
    // on it, so the highlighted title reads as magnified and the next one swells as the pill arrives.
    // Driven by the same spring, written as --gd-lens per link; guide.css scales the label with it.
    const paintLens = (on: boolean) => {
      const centre = springY.x + springH.x / 2;
      for (const box of linkMetrics) {
        const t = on && springH.x > 0 ? Math.max(0, 1 - Math.abs(box.mid - centre) / springH.x) : 0;
        const zoom = (1 + LENS_ZOOM * t * t * (3 - 2 * t)).toFixed(4);
        if (zoom === box.zoom) continue;
        box.zoom = zoom;
        box.link.style.setProperty('--gd-lens', zoom);
      }
    };

    const paint = (deferWidthRedraw = false) => {
      const yStr = `${springY.x.toFixed(2)}px`;
      const hStr = `${springH.x.toFixed(2)}px`;
      if (yStr !== lastMarkerY) {
        track.style.setProperty('--gd-marker-y', yStr);
        lastMarkerY = yStr;
      }
      if (hStr !== lastMarkerH) {
        track.style.setProperty('--gd-marker-h', hStr);
        lastMarkerH = hStr;
      }
      // The rail fills down to the dot beside the marker, so the line always ends at the dot.
      if (railHeight > 0) {
        const dot = springY.x + springH.x / 2 - railTop;
        const progressStr = Math.min(1, Math.max(0, dot / railHeight)).toFixed(4);
        if (progressStr !== lastProgress) {
          track.style.setProperty('--gd-progress', progressStr);
          lastProgress = progressStr;
        }
      }
      // Reduced motion: the marker is placed without gliding, so the active label shows magnified at once.
      paintLens(wide.matches);
      paintGlass(deferWidthRedraw);
    };

    const step = (now: number) => {
      // Clamp dt to 50ms so returning from a background tab or a slow frame never overshoots or stalls,
      // and treat a non-positive first-frame delta as one 120Hz step so motion begins without a 1-frame hitch.
      const rawDt = lastFrame > 0 ? (now - lastFrame) / 1000 : 1 / 120;
      const dt = rawDt <= 0 ? 1 / 120 : Math.min(MAX_DT, rawDt);
      lastFrame = now;
      // Fixed 1/240s sub-steps keep symplectic integration stable across 60Hz/120Hz displays.
      for (let left = dt; left > 0; left -= SUBSTEP) {
        const h = Math.min(SUBSTEP, left);
        for (const s of [springY, springH]) {
          s.v += (-STIFFNESS * (s.x - s.to) - DAMPING * s.v) * h;
          s.x += s.v * h;
        }
      }
      // Sub-pixel remainders are invisible; settle tightly to zero velocity (crisp scale = 0, zero idle CPU).
      const settled = [springY, springH].every((s) => Math.abs(s.x - s.to) < 0.15 && Math.abs(s.v) < 1.2);
      if (settled) {
        for (const s of [springY, springH]) {
          s.x = s.to;
          s.v = 0;
        }
      }
      paint();
      frame = settled ? 0 : requestAnimationFrame(step);
    };

    // `instant` places without motion: first appearance, layout changes and reduced motion.
    const placeMarker = (instant = false, remeasure = false, deferWidthRedraw = false) => {
      if (!current) {
        placed = false;
        cancelAnimationFrame(frame);
        frame = 0;
        lastFrame = 0;
        if (lastProgress !== '0') {
          track.style.setProperty('--gd-progress', '0');
          lastProgress = '0';
        }
        paintLens(false);
        resetGlassBend();
        return;
      }
      if (remeasure || (wide.matches && markerWidth === 0)) {
        measureToc();
      }
      const box = metricByLink.get(current);
      if (!box) return;
      springY.to = box.top;
      springH.to = box.height;
      if (instant || !placed || reduceMotion.matches || !wide.matches) {
        for (const s of [springY, springH]) {
          s.x = s.to;
          s.v = 0;
        }
        cancelAnimationFrame(frame);
        frame = 0;
        lastFrame = 0;
        placed = true;
        paint(deferWidthRedraw);
        return;
      }
      if (!frame) {
        lastFrame = 0;
        frame = requestAnimationFrame(step);
      }
    };

    const setActive = (link: HTMLAnchorElement | null) => {
      if (link === current) return;
      current?.removeAttribute('aria-current');
      current = link;
      if (!link) {
        toc.removeAttribute('data-spy');
        placeMarker();
        return;
      }
      link.setAttribute('aria-current', 'true');
      // Shown first, so the glass can measure the marker on its first placement.
      const firstReveal = !toc.hasAttribute('data-spy');
      if (firstReveal) toc.setAttribute('data-spy', '');
      placeMarker(false, firstReveal);
      // Mobile: the chips scroll sideways; bring the active one into view without moving the page.
      if (!wide.matches && list.scrollWidth > list.clientWidth) {
        const left = link.offsetLeft - (list.clientWidth - link.offsetWidth) / 2;
        list.scrollTo({ left: Math.max(0, left), behavior: reduceMotion.matches ? 'auto' : 'smooth' });
      }
    };

    const update = () => {
      tick = 0;
      if (lockUntil) {
        if (performance.now() < lockUntil) return;
        lockUntil = 0;
      }
      const probe = Math.max(120, Math.round(window.innerHeight * 0.3));
      const box = content.getBoundingClientRect();
      const atEnd = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
      let active: HTMLAnchorElement | null = null;
      for (const it of items) {
        if (it.sec.getBoundingClientRect().top <= probe) active = it.link;
      }
      if (atEnd && box.bottom <= window.innerHeight + 2) active = items[items.length - 1].link;
      setActive(active);
    };
    const request = () => {
      if (!tick) tick = requestAnimationFrame(update);
    };

    // Mobile chip row: fade the edge that has more chips behind it, so the row reads as scrollable.
    const markEdges = () => {
      const max = list.scrollWidth - list.clientWidth;
      list.toggleAttribute('data-more-start', !wide.matches && list.scrollLeft > 2);
      list.toggleAttribute('data-more-end', !wide.matches && max - list.scrollLeft > 2);
    };

    const scheduleRelayout = (deferWidthRedraw = true) => {
      if (layoutRaf) return;
      layoutRaf = requestAnimationFrame(() => {
        layoutRaf = 0;
        if (signal.aborted) return;
        measureToc();
        placeMarker(true, false, deferWidthRedraw);
        markEdges();
        request();
      });
    };

    // Re-measure ToC links when the sidebar resizes and re-check scroll-spy when FAQ accordions
    // or live settings change the reading column height.
    let resizeObserver: ResizeObserver | null = null;
    if (typeof ResizeObserver !== 'undefined') {
      let lastListW = -1;
      let lastListH = -1;
      let lastContentH = -1;
      resizeObserver = new ResizeObserver((entries) => {
        if (signal.aborted) return;
        let listChanged = false;
        let contentChanged = false;
        for (const entry of entries) {
          const { width: w, height: h } = entry.contentRect;
          if (entry.target === list) {
            if (lastListW < 0) {
              lastListW = w;
              lastListH = h;
            } else if (Math.abs(w - lastListW) > 0.5 || Math.abs(h - lastListH) > 0.5) {
              lastListW = w;
              lastListH = h;
              listChanged = true;
            }
          } else if (entry.target === content) {
            if (lastContentH < 0) {
              lastContentH = h;
            } else if (Math.abs(h - lastContentH) > 1) {
              lastContentH = h;
              contentChanged = true;
            }
          }
        }
        if (listChanged) scheduleRelayout(true);
        else if (contentChanged) request();
      });
      resizeObserver.observe(list);
      resizeObserver.observe(content);
    }

    signal.addEventListener('abort', () => {
      cancelAnimationFrame(frame);
      cancelAnimationFrame(tick);
      cancelAnimationFrame(layoutRaf);
      window.clearTimeout(lockTimer);
      window.clearTimeout(glassResizeTimer);
      resizeObserver?.disconnect();
      frame = 0;
      tick = 0;
      layoutRaf = 0;
      lockTimer = 0;
      glassResizeTimer = 0;
      teardownGlassFilter();
      revokeGlassMaps();
      delete toc.dataset.glass;
      delete toc.dataset.spyBound;
    });

    // A ToC click marks its target right away and holds it while the smooth scroll passes the
    // sections in between, so the marker travels once instead of stepping through each one.
    list.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement | null)?.closest<HTMLAnchorElement>('.gd-toc__link');
      if (!link) return;
      const holdMs = reduceMotion.matches ? 150 : 1200;
      lockUntil = performance.now() + holdMs;
      setActive(link);
      // Browsers without `scrollend` (older Safari) re-check once the lock has run out.
      window.clearTimeout(lockTimer);
      lockTimer = window.setTimeout(() => {
        lockTimer = 0;
        if (signal.aborted) return;
        lockUntil = 0;
        request();
      }, holdMs + 50);
    }, { signal });
    // The reader takes over mid-scroll (wheel, finger, scroll keys): drop the hold at once so the
    // marker follows what they do instead of staying parked on the clicked target.
    const release = () => {
      if (!lockUntil) return;
      lockUntil = 0;
      window.clearTimeout(lockTimer);
      lockTimer = 0;
      request();
    };
    window.addEventListener('wheel', release, { passive: true, signal });
    // A touch listener on the document is also what lets iOS / in-app WebViews show :active
    // press states on touch-down instead of skipping them.
    document.addEventListener('touchstart', release, { passive: true, signal });
    window.addEventListener('keydown', (e) => {
      if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(e.key)) release();
    }, { signal });
    window.addEventListener('scrollend', () => {
      if (lockUntil) {
        lockUntil = 0;
        window.clearTimeout(lockTimer);
        lockTimer = 0;
      }
      request();
    }, { signal });
    window.addEventListener('scroll', request, { passive: true, signal });

    list.addEventListener('scroll', markEdges, { passive: true, signal });
    window.addEventListener('resize', () => scheduleRelayout(true), { signal });
    wide.addEventListener?.('change', () => scheduleRelayout(false), { signal });
    reduceMotion.addEventListener?.('change', () => placeMarker(true), { signal });
    for (const mq of glassPrefs) {
      mq.addEventListener?.('change', () => {
        glassMode = detectLiquidGlassMode();
        paintGlass(false);
      }, { signal });
    }
    document.fonts?.ready.then(() => {
      if (signal.aborted) return;
      scheduleRelayout(false);
    });
    measureToc();
    markEdges();
    update();
  }

  initGuideToc();
  document.addEventListener('astro:page-load', initGuideToc);
</script>
