---
import '../styles/fonts.css';
import SiteNav from './SiteNav.astro';
import HeroSection from './HeroSection.astro';
import BackToTop from './BackToTop.astro';
import { FB_URL, PAYMENT_WINDOW_DAYS, PROJECT_ADVISOR, STAFF_CONTACTS } from './register/model';
import thai400 from '@fontsource/ibm-plex-sans-thai/files/ibm-plex-sans-thai-thai-400-normal.woff2?url';
import thai700 from '@fontsource/ibm-plex-sans-thai/files/ibm-plex-sans-thai-thai-700-normal.woff2?url';
import mono500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import mono600 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';
import grotesk700 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import IdCard from '@lucide/astro/icons/id-card';
import Shirt from '@lucide/astro/icons/shirt';
import Smartphone from '@lucide/astro/icons/smartphone';
import Phone from '@lucide/astro/icons/phone';
import MessageCircle from '@lucide/astro/icons/message-circle';
import ScanLine from '@lucide/astro/icons/scan-line';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import {
  CAMP_FEE,
  CAMP_FEE_TEXT,
  MAX_CAPACITY,
  REGISTRATION_CLOSE_AT,
  REGISTRATION_OPEN_AT,
  formatBangkokTime,
  formatThaiDateDot,
  formatThaiDateFull,
  formatThaiDateShort,
} from '../lib/camp-facts';
const rawGalleryBase = import.meta.env.PUBLIC_GALLERY_BASE_URL || 'https://comcamp25-gallery.sokulshop5.workers.dev/';
const galleryBaseUrl = rawGalleryBase.endsWith('/') ? rawGalleryBase : `${rawGalleryBase}/`;
const apiBaseUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000/api';
// Cloudflare caches /theme/* for 4 hours: a content hash in the query string makes each deploy's
// theme files load at once, while unchanged files keep their cached copy.
const themeAsset = (file: string) =>
  `/theme/${file}?v=${createHash('sha256').update(readFileSync(join(process.cwd(), 'public/theme', file))).digest('hex').slice(0, 10)}`;
// Server-rendered fallbacks; main.js replaces them with GET /api/settings/public values.
const campDefaults = { openAt: REGISTRATION_OPEN_AT, closeAt: REGISTRATION_CLOSE_AT, maxCapacity: MAX_CAPACITY, campFee: CAMP_FEE };
const openShort = formatThaiDateShort(REGISTRATION_OPEN_AT);
const openTime = formatBangkokTime(REGISTRATION_OPEN_AT);
const closeFull = formatThaiDateFull(REGISTRATION_CLOSE_AT);
// Absolute origin for canonical / og:url / og:image. Injected at build time from FRONTEND_URL (see docker-compose.prod.yml);
// when unset (local dev) the absolute-URL tags are omitted instead of guessing a domain.
const siteUrl = (import.meta.env.PUBLIC_SITE_URL || '').replace(/\/+$/, '');
const ogImage = siteUrl ? `${siteUrl}/assets/og-cover.jpg` : '';
---
<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>ComCamp #25 — ค่ายยุวชนคอมพิวเตอร์ ครั้งที่ 25 · CS MJU</title>
<meta name="description" content="ComCamp #25 ค่าย Microcontroller (ESP8266 & Arduino UNO R3) with IoT & AI Dashboard สำหรับ ม.4–ม.6 หรือ ปวช. สาขาวิชาวิทยาการคอมพิวเตอร์ มหาวิทยาลัยแม่โจ้">
<meta property="og:type" content="website">
<meta property="og:locale" content="th_TH">
<meta property="og:title" content="ComCamp #25 — ค่ายยุวชนคอมพิวเตอร์ ครั้งที่ 25 · CS MJU">
<meta property="og:description" content="ComCamp #25 ค่าย Microcontroller (ESP8266 & Arduino UNO R3) with IoT & AI Dashboard สำหรับ ม.4–ม.6 หรือ ปวช. สาขาวิชาวิทยาการคอมพิวเตอร์ มหาวิทยาลัยแม่โจ้">
<meta name="theme-color" content="#F9F8F4">
<meta property="og:site_name" content="ComCamp #25">
{siteUrl && <link rel="canonical" href={`${siteUrl}/`}>}
{siteUrl && <meta property="og:url" content={`${siteUrl}/`}>}
{ogImage && <meta property="og:image" content={ogImage}>}
{ogImage && <meta property="og:image:width" content="1200">}
{ogImage && <meta property="og:image:height" content="630">}
{ogImage && <meta property="og:image:alt" content="ComCamp #25 ค่ายยุวชนคอมพิวเตอร์ ครั้งที่ 25 บอร์ด Arduino UNO R3 และ ESP8266">}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'}>
{ogImage && <meta name="twitter:image" content={ogImage}>}
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href={galleryBaseUrl} crossorigin>
<link rel="preload" href={thai700} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={thai400} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={mono500} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={mono600} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={grotesk700} as="font" type="font/woff2" crossorigin>
<script is:inline>
  (function() {
    try {
      var stored = localStorage.getItem('comcamp-theme');
      var isDark = stored ? stored === 'dark' : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (isDark) {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      }
      /* Pre-paint veil bypass: zero flash on repeat visits, anchor jumps, reduced-motion, or Save-Data */
      var skipVeil = Boolean(location.hash) ||
        sessionStorage.getItem('cc25-veil-seen') === '1' ||
        (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) ||
        Boolean(navigator.connection && navigator.connection.saveData);
      if (skipVeil) {
        document.documentElement.classList.add('veil-skip');
      }
      document.documentElement.setAttribute('data-home-page', '1');
    } catch (e) {}
  })();
</script>
<style is:global>
  html.veil-skip #veil{display:none!important}
  /* Before /api/settings/public answers, keep register links' space (no hero layout shift when
     they appear); once the server says not open, remove them from the layout. */
  html[data-home-page="1"]:not([data-reg-open]) [data-register-link]{visibility:hidden!important}
  html[data-home-page="1"][data-reg-open="false"] [data-register-link]{display:none!important}
</style>
<link rel="stylesheet" href={themeAsset('styles.css')}>
<link rel="stylesheet" href={themeAsset('page.css')}>
<link rel="stylesheet" href={themeAsset('editorial.css')}>
<noscript><style>.veil{display:none!important}</style></noscript>
<script is:inline define:vars={{ galleryBaseUrl, apiBaseUrl, campDefaults }}>
  window.__CC25_GALLERY_BASE_URL__ = galleryBaseUrl;
  window.__CC25_API_BASE_URL__ = apiBaseUrl;
  window.__CC25_DEFAULTS__ = campDefaults;
</script>
</head>
<body>
  <!-- Intro veil: editorial preloader, performance-tuned (~480ms–820ms non-blocking lift). Home only. -->
  <div class="veil" id="veil" aria-hidden="true">
    <div class="veil-top">
      <span class="veil-brand">ComCamp <span class="veil-mono">#25</span></span>
      <span class="veil-ed">ครั้งที่ <span class="veil-mono">25</span></span>
    </div>
    <div class="veil-center">
      <p class="veil-kicker">สาขาวิชาวิทยาการคอมพิวเตอร์ · มหาวิทยาลัยแม่โจ้</p>
      <p class="veil-display"><span class="vl"><i>Comcamp</i></span><span class="vl"><i class="ol">25th</i></span></p>
      <p class="veil-thai">ค่ายยุวชนคอมพิวเตอร์ <span class="nowrap">ครั้งที่ <span class="veil-mono">25</span></span></p>
      <p class="veil-sub"><span class="nowrap">ลงทะเบียนวันที่ <span class="veil-mono" data-open-date-dot>{formatThaiDateDot(REGISTRATION_OPEN_AT)}</span></span> · สมัครผ่านเว็บไซต์ค่าย</p>
    </div>
    <span class="veil-ghost veil-mono">25</span>
    <div class="veil-foot">
      <div class="veil-row">
        <span>กำลังเตรียมหน้าเว็บ</span>
        <span class="veil-count veil-mono"><span data-veil-num>00</span> / 100</span>
      </div>
      <span class="veil-rule"><i></i></span>
    </div>
  </div>
  <script is:inline>
    (function () {
      /* Landing page opens at the top when no hash is targeted */
      try { history.scrollRestoration = 'manual'; } catch (e) {}
      function topNow() { window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); }
      if (!location.hash) {
        topNow();
        document.addEventListener('DOMContentLoaded', topNow, { once: true });
      }
      var veil = document.getElementById('veil');
      if (!veil) return;
      if (document.documentElement.classList.contains('veil-skip')) {
        veil.hidden = true;
        return;
      }
      try { sessionStorage.setItem('cc25-veil-seen', '1'); } catch (e) {}

      var num = veil.querySelector('[data-veil-num]');
      var bar = veil.querySelector('.veil-rule i');
      var domReady = document.readyState !== 'loading';
      if (!domReady) {
        document.addEventListener('DOMContentLoaded', function () { domReady = true; }, { once: true });
      }

      /* Short, smooth editorial curtain (min 480ms, max 820ms) so LCP & mobile 4G interaction stay fast */
      var MIN_MS = 480;
      var MAX_MS = 820;
      var t0 = performance.now();
      var finished = false;
      document.body.style.overflow = 'hidden';

      function finish() {
        if (finished) return;
        finished = true;
        if (num) num.textContent = '100';
        if (bar) bar.style.transform = 'scaleX(1)';
        veil.classList.add('is-done');
        document.body.style.overflow = '';
        setTimeout(function () { veil.hidden = true; }, 680);
      }

      function tick(now) {
        var elapsed = now - t0;
        var raw = Math.min(1, elapsed / (domReady ? MIN_MS : MAX_MS));
        var eased = 1 - Math.pow(1 - raw, 3);
        var cap = (!domReady && elapsed < MAX_MS) ? Math.min(0.92, eased) : eased;
        var v = Math.round(cap * 100);
        if (num) num.textContent = (v < 10 ? '0' : '') + v;
        if (bar) bar.style.transform = 'scaleX(' + cap.toFixed(3) + ')';

        if ((domReady && elapsed >= MIN_MS) || elapsed >= MAX_MS) {
          finish();
          return;
        }
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    })();
  </script>
  <SiteNav active="home" isHome={true} />

  <main id="main">
    <!-- Section 01: Hero — 3D Hardware Stage (Arduino UNO R3 & ESP8266) -->
    <HeroSection titleStyle="pixel" registerHref="/register" statusHref="/status" />

    <!-- Section 02: Curriculum (merged "what you build" + "4 steps over 3 days") — central spine -->
    <section id="experience" class="ed-sec ed-sec--curriculum" aria-labelledby="experience-title">
      <p class="ed-index"><span class="ed-index__no">02</span><span class="ed-index__label">หลักสูตร</span></p>
      <div class="wrap">
        <header class="section-head">
          <h2 id="experience-title" class="section-title">หลักสูตร <span class="font-mono tabular-nums">4</span> ขั้นตอน ตลอด <span class="font-mono tabular-nums">3</span> วัน <span class="font-mono tabular-nums">2</span> คืน</h2>
          <p class="body">เรียนรู้จากการลงมือปฏิบัติจริงพร้อมชุดบอร์ดประจำตัว ตั้งแต่จำลองวงจร ต่อฮาร์ดแวร์ระดับไมโครคอนโทรลเลอร์ ไปจนถึงสร้างเว็บที่สั่งงานผ่านสมาร์ตโฟนได้โดยตรง</p>
        </header>

        <div id="journey" class="ed-anchor"></div>
        <div class="journey journey--spine" role="list">
          <div role="listitem" class="step">
            <div class="step-aside">
              <div class="step-big-num" aria-hidden="true">01</div>
              <div class="day th-label">วันที่ <span class="font-mono tabular-nums">1</span></div>
            </div>
            <span class="step-node" aria-hidden="true"></span>
            <div class="step-content">
              <div class="step-num th-label">ขั้นที่ <span class="font-mono tabular-nums">1</span> · รับรู้และจำลอง</div>
              <h3>ปูพื้นฐานและจำลองวงจร</h3>
              <p>ทำความเข้าใจแนวคิด Input → Process → Output แล้วจำลองวงจรไฟกระพริบกับเซนเซอร์วัดแสง LDR บนคอมพิวเตอร์ก่อนต่อของจริงเพื่อป้องกันการลัดวงจร ไม่มีพื้นฐานก็เริ่มได้</p>
              <p class="step-spec"><span class="step-spec__key th-label">เครื่องมือ</span><span class="step-spec__val">Autodesk Tinkercad Circuits</span></p>
            </div>
          </div>
          <div role="listitem" class="step">
            <div class="step-aside">
              <div class="step-big-num" aria-hidden="true">02</div>
              <div class="day th-label">วันที่ <span class="font-mono tabular-nums">1</span></div>
            </div>
            <span class="step-node" aria-hidden="true"></span>
            <div class="step-content">
              <div class="step-num th-label">ขั้นที่ <span class="font-mono tabular-nums">2</span> · ควบคุมด้วยวงจรจริง</div>
              <h3>ต่อวงจรจริงและอ่านค่าเซนเซอร์</h3>
              <p>ประกอบวงจรบน Breadboard อัปโหลดโค้ดภาษา C/C++ สั่งเซนเซอร์วัดระยะ และขับเสียงเตือนด้วย Active Buzzer</p>
              <p class="step-spec"><span class="step-spec__key th-label">บอร์ดและเซนเซอร์</span><span class="step-spec__val">Arduino UNO R3 / HC-SR04 Ultrasonic</span></p>
            </div>
          </div>
          <div role="listitem" class="step">
            <div class="step-aside">
              <div class="step-big-num" aria-hidden="true">03</div>
              <div class="day th-label">วันที่ <span class="font-mono tabular-nums">2</span></div>
            </div>
            <span class="step-node" aria-hidden="true"></span>
            <div class="step-content">
              <div class="step-num th-label">ขั้นที่ <span class="font-mono tabular-nums">3</span> · IoT ไร้สาย</div>
              <h3>ปล่อย Wi-Fi จากบอร์ดและสั่งงานผ่านเว็บ</h3>
              <p>ตั้งค่าบอร์ดในโหมด Access Point ให้สมาร์ตโฟนเชื่อมต่อได้โดยตรงไม่ต้องพึ่งเราเตอร์ สร้าง Embedded Web Server บนชิป และใช้ AI ช่วยขึ้นโครงหน้า Mobile Dashboard เพื่อกดสั่งงานฮาร์ดแวร์ผ่านเครือข่ายท้องถิ่น</p>
              <p class="step-spec"><span class="step-spec__key th-label">การเชื่อมต่อ</span><span class="step-spec__val">ESP8266 / SoftAP / 192.168.4.1</span></p>
            </div>
          </div>
          <div role="listitem" class="step">
            <div class="step-aside">
              <div class="step-big-num" aria-hidden="true">04</div>
              <div class="day th-label">วันที่ <span class="font-mono tabular-nums">2–3</span></div>
            </div>
            <span class="step-node" aria-hidden="true"></span>
            <div class="step-content">
              <div class="step-num th-label">ขั้นที่ <span class="font-mono tabular-nums">4</span> · ต้นแบบและนำเสนอ</div>
              <h3>พัฒนาโปรเจกต์และนำเสนอ</h3>
              <p>รวมทีมพัฒนาต้นแบบตามโจทย์ท้าทาย แล้วสาธิตผลงานสดบนเวที<span class="ed-nw">ทีมละ <span class="font-mono tabular-nums">3</span> นาที</span></p>
              <p class="step-spec"><span class="step-spec__key th-label">รูปแบบ</span><span class="step-spec__val">Hackathon / Live Demo</span></p>
            </div>
          </div>
        </div>
        <p class="ed-journey-signoff"><span class="step-node step-node--end" aria-hidden="true"></span><span class="ed-signoff-note">ผู้เข้าร่วมทุกคนได้รับเกียรติบัตรจากสาขาวิชาวิทยาการคอมพิวเตอร์ มหาวิทยาลัยแม่โจ้</span></p>
      </div>
    </section>

    <!-- Section 03: Camp Essentials — split masthead with stat stack + raised bento mosaic -->
    <section id="essentials" class="ed-sec ed-sec--essentials" aria-labelledby="essentials-title">
      <p class="ed-index"><span class="ed-index__no">03</span><span class="ed-index__label">ข้อมูลก่อนสมัคร</span></p>
      <div class="wrap">
        <div class="ess-head">
          <div class="section-head">
            <h2 id="essentials-title" class="section-title">ข้อมูลที่ควรรู้ก่อนสมัคร</h2>
            <p class="body">สรุปคุณสมบัติ อุปกรณ์ จำนวนที่นั่ง สถานที่ และค่าใช้จ่าย เพื่อให้ตัดสินใจและเตรียมตัวได้ครบในหน้าเดียว</p>
            <p class="ed-aside-meta">ข้อมูลสำคัญสำหรับผู้สมัครและผู้ปกครอง</p>
          </div>
          <dl class="ed-metrics" aria-label="สรุปภาพรวมค่าย">
            <div class="ed-metric">
              <dt class="ed-metric__label th-label">ระยะเวลา</dt>
              <dd class="ed-metric__val"><span class="font-mono tabular-nums">3</span> วัน <span class="font-mono tabular-nums">2</span> คืน (<span class="font-mono tabular-nums">5–7</span> ก.พ. <span class="font-mono tabular-nums">70</span>)</dd>
            </div>
            <div class="ed-metric">
              <dt class="ed-metric__label th-label">ระดับชั้น</dt>
              <dd class="ed-metric__val">ม.<span class="font-mono tabular-nums">4–6</span> หรือ ปวช.<span class="font-mono tabular-nums">1–3</span></dd>
            </div>
            <div class="ed-metric">
              <dt class="ed-metric__label th-label">ลงทะเบียน</dt>
              <dd class="ed-metric__val"><span class="tabular-nums" data-open-date-short>{openShort}</span> (<span class="font-mono tabular-nums" data-open-time>{openTime}</span> น.) – <span class="tabular-nums" data-close-date-full>{closeFull}</span> · ปิดรับทันทีเมื่อที่นั่งเต็ม</dd>
            </div>
          </dl>
        </div>
        <div class="ed-main">

          <div class="bento" role="list">
            <div role="listitem" class="card ed-cell--split">
              <h3>คุณสมบัติผู้สมัคร</h3>
              <p>ม.<span class="font-mono tabular-nums">4</span>–ม.<span class="font-mono tabular-nums">6</span> หรือ ปวช.<span class="font-mono tabular-nums">1</span>–ปวช.<span class="font-mono tabular-nums">3</span> ทุกสายการเรียน ไม่จำเป็นต้องมีพื้นฐานด้านการเขียนโปรแกรมหรือวงจรไฟฟ้ามาก่อน</p>
            </div>

            <div role="listitem" class="card ed-cell--split">
              <h3>อุปกรณ์การเรียนและฝึกปฏิบัติ</h3>
              <p>จัดเตรียมชุดบอร์ด <span class="font-mono tabular-nums">Arduino UNO R3</span> และ <span class="font-mono tabular-nums">ESP8266</span> พร้อมเซนเซอร์ให้ฝึกปฏิบัติจริงและจำลองวงจร Tinkercad ตลอดค่าย (ส่วนเสื้อค่าย กระเป๋า เอกสารอบรม และเกียรติบัตรรับกลับบ้าน)</p>
            </div>

            <div role="listitem" class="card ed-cell--split">
              <h3>คอมพิวเตอร์ห้องปฏิบัติการ</h3>
              <p>จัดเตรียมห้องปฏิบัติการคอมพิวเตอร์พร้อมเครื่อง PC สำหรับผู้เข้าร่วมทุกคน ไม่บังคับนำโน้ตบุ๊กส่วนตัวมา</p>
            </div>

            <div role="listitem" class="card ed-cell--split">
              <h3>สถานที่จัดกิจกรรมและที่พัก</h3>
