---
import '../styles/fonts.css';
import SiteNav from './SiteNav.astro';
import HeroSection from './HeroSection.astro';
import BackToTop from './BackToTop.astro';
import { FB_URL } from './register/model';
import thai400 from '@fontsource/ibm-plex-sans-thai/files/ibm-plex-sans-thai-thai-400-normal.woff2?url';
import thai700 from '@fontsource/ibm-plex-sans-thai/files/ibm-plex-sans-thai-thai-700-normal.woff2?url';
import mono500 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url';
import mono600 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';
import grotesk700 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
const rawGalleryBase = import.meta.env.PUBLIC_GALLERY_BASE_URL || 'https://comcamp25-gallery.sokulshop5.workers.dev/';
const galleryBaseUrl = rawGalleryBase.endsWith('/') ? rawGalleryBase : `${rawGalleryBase}/`;
const apiBaseUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000/api';
---
<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>ComCamp #25 — ค่ายยุวชนคอมพิวเตอร์ ครั้งที่ 25 · CS MJU</title>
<meta name="description" content="ComCamp #25 ค่าย Microcontroller (ESP8266 & Arduino UNO R3) with IoT & AI Dashboard สำหรับ ม.4–ม.6 และ ปวช. สาขาวิชาวิทยาการคอมพิวเตอร์ มหาวิทยาลัยแม่โจ้">
<meta name="theme-color" content="#F9F8F4">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
<link rel="preconnect" href={galleryBaseUrl} crossorigin>
<link rel="preload" href={thai700} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={thai400} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={mono500} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={mono600} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={grotesk700} as="font" type="font/woff2" crossorigin>
<script is:inline>
  (function() {
    try {
      var stored = localStorage.getItem('comcamp-theme');
      var isDark = stored ? stored === 'dark' : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
      if (isDark) {
        document.documentElement.classList.add('dark');
        document.documentElement.setAttribute('data-theme', 'dark');
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.setAttribute('data-theme', 'light');
      }
      /* Pre-paint veil bypass: zero flash on repeat visits, anchor jumps, reduced-motion, or Save-Data */
      var skipVeil = Boolean(location.hash) ||
        sessionStorage.getItem('cc25-veil-seen') === '1' ||
        (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) ||
        Boolean(navigator.connection && navigator.connection.saveData);
      if (skipVeil) {
        document.documentElement.classList.add('veil-skip');
      }
      document.documentElement.setAttribute('data-home-page', '1');
    } catch (e) {}
  })();
</script>
<style is:global>
  html.veil-skip #veil{display:none!important}
  html[data-home-page="1"]:not([data-reg-open="true"]) [data-register-link]{display:none!important}
</style>
<link rel="stylesheet" href="/theme/styles.css">
<link rel="stylesheet" href="/theme/page.css">
<link rel="stylesheet" href="/theme/editorial.css">
<noscript><style>.veil{display:none!important}</style></noscript>
<script is:inline define:vars={{ galleryBaseUrl, apiBaseUrl }}>
  window.__CC25_GALLERY_BASE_URL__ = galleryBaseUrl;
  window.__CC25_API_BASE_URL__ = apiBaseUrl;
</script>
</head>
<body>
  <!-- Intro veil: editorial preloader, performance-tuned (~480ms–820ms non-blocking lift). Home only. -->
  <div class="veil" id="veil" aria-hidden="true">
    <div class="veil-top">
      <span class="veil-brand">ComCamp <span class="veil-mono">#25</span></span>
      <span class="veil-ed veil-mono">25TH EDITION</span>
    </div>
    <div class="veil-center">
      <p class="veil-kicker veil-mono">COMPUTER SCIENCE · MAEJO UNIVERSITY</p>
      <p class="veil-display"><span class="vl"><i>Comcamp</i></span><span class="vl"><i class="ol">25th</i></span></p>
      <p class="veil-thai">ค่ายยุวชนคอมพิวเตอร์ <span class="nowrap">ครั้งที่ <span class="veil-mono">25</span></span></p>
      <p class="veil-sub"><span class="nowrap">เปิดรับ <span class="veil-mono">16.11.69</span></span> · สมัครผ่านเว็บไซต์ค่าย</p>
    </div>
    <span class="veil-ghost veil-mono">25</span>
    <div class="veil-foot">
      <div class="veil-row">
        <span>กำลังเตรียมหน้าเว็บ</span>
        <span class="veil-count veil-mono"><span data-veil-num>00</span> / 100</span>
      </div>
      <span class="veil-rule"><i></i></span>
    </div>
  </div>
  <script is:inline>
    (function () {
      /* Landing page opens at the top when no hash is targeted */
      try { history.scrollRestoration = 'manual'; } catch (e) {}
      function topNow() { window.scrollTo({ top: 0, left: 0, behavior: 'instant' }); }
      if (!location.hash) {
        topNow();
        document.addEventListener('DOMContentLoaded', topNow, { once: true });
      }
      var veil = document.getElementById('veil');
      if (!veil) return;
      if (document.documentElement.classList.contains('veil-skip')) {
        veil.hidden = true;
        return;
      }
      try { sessionStorage.setItem('cc25-veil-seen', '1'); } catch (e) {}

      var num = veil.querySelector('[data-veil-num]');
      var bar = veil.querySelector('.veil-rule i');
      var domReady = document.readyState !== 'loading';
      if (!domReady) {
        document.addEventListener('DOMContentLoaded', function () { domReady = true; }, { once: true });
      }

      /* Short, smooth editorial curtain (min 480ms, max 820ms) so LCP & mobile 4G interaction stay fast */
      var MIN_MS = 480;
      var MAX_MS = 820;
      var t0 = performance.now();
      var finished = false;
      document.body.style.overflow = 'hidden';

      function finish() {
        if (finished) return;
        finished = true;
        if (num) num.textContent = '100';
        if (bar) bar.style.transform = 'scaleX(1)';
        veil.classList.add('is-done');
        document.body.style.overflow = '';
        setTimeout(function () { veil.hidden = true; }, 680);
      }

      function tick(now) {
        var elapsed = now - t0;
        var raw = Math.min(1, elapsed / (domReady ? MIN_MS : MAX_MS));
        var eased = 1 - Math.pow(1 - raw, 3);
        var cap = (!domReady && elapsed < MAX_MS) ? Math.min(0.92, eased) : eased;
        var v = Math.round(cap * 100);
        if (num) num.textContent = (v < 10 ? '0' : '') + v;
        if (bar) bar.style.transform = 'scaleX(' + cap.toFixed(3) + ')';

        if ((domReady && elapsed >= MIN_MS) || elapsed >= MAX_MS) {
          finish();
          return;
        }
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    })();
  </script>
  <SiteNav active="home" isHome={true} />

  <main id="main">
    <!-- Section 01: Hero — 3D Hardware Stage (Arduino UNO R3 & ESP8266) -->
    <HeroSection titleStyle="pixel" registerHref="/register" statusHref="/status" />

    <!-- Section 02: What you'll actually do — editorial chapter list -->
    <section id="experience" class="ed-sec" aria-labelledby="experience-title">
      <div class="wrap exp">
        <header class="exp-intro">
          <p class="ed-index"><span class="ed-index__no">02</span><span class="ed-index__label">ประสบการณ์ในค่าย · <span class="ed-en">LAB 01–04</span></span></p>
          <h2 id="experience-title" class="exp-title">สิ่งที่จะได้ทำจริงในค่าย</h2>
          <p class="exp-lead">เรียนรู้จากการลงมือปฏิบัติจริง ตั้งแต่การต่อวงจรและควบคุมฮาร์ดแวร์ระดับไมโครคอนโทรลเลอร์ ไปจนถึงการสร้างเว็บอินเทอร์เฟซที่สั่งงานผ่านสมาร์ตโฟนได้โดยตรง</p>
          <p class="ed-aside-meta"><span class="ed-en">HANDS-ON CURRICULUM</span> · เน้นปฏิบัติจริงทุกหัวข้อพร้อมชุดบอร์ดประจำตัว</p>
        </header>

        <ol class="exp-list">
          <li class="exp-item">
            <span class="exp-num" aria-hidden="true">01</span>
            <div class="exp-body">
              <h3 class="exp-item-title">ปล่อยสัญญาณ Wi-Fi จากบอร์ด</h3>
              <p class="exp-item-text">ทดลองตั้งค่า ESP8266 ในโหมด Access Point (AP Mode) เพื่อให้สมาร์ตโฟนเกาะสัญญาณและส่งคำสั่งควบคุมอุปกรณ์ได้โดยตรงไม่ต้องพึ่งเราเตอร์</p>
              <p class="exp-spec"><span class="exp-key">MODE</span><span class="exp-val">SoftAP / 192.168.4.1</span></p>
            </div>
          </li>

          <li class="exp-item">
            <span class="exp-num" aria-hidden="true">02</span>
            <div class="exp-body">
              <h3 class="exp-item-title">ประกอบวงจรและอ่านค่าเซนเซอร์</h3>
              <p class="exp-item-text">ต่อวงจรจริงบน Breadboard ร่วมกับเซนเซอร์ Ultrasonic HC-SR04, LDR วัดแสง และ Active Buzzer เพื่อเข้าใจกระบวนการ Input, Process และ Output</p>
              <p class="exp-spec"><span class="exp-key">I/O</span><span class="exp-val">HC-SR04 / LDR / Buzzer</span></p>
            </div>
          </li>

          <li class="exp-item">
            <span class="exp-num" aria-hidden="true">03</span>
            <div class="exp-body">
              <h3 class="exp-item-title">ควบคุมฮาร์ดแวร์ผ่านหน้าเว็บ</h3>
              <p class="exp-item-text">เขียนโปรแกรมสร้าง Embedded Web Server บนตัวชิป และเปิดหน้า Mobile Dashboard เพื่อกดสวิตช์สั่งงานฮาร์ดแวร์ผ่านเครือข่ายท้องถิ่นทันที</p>
              <p class="exp-spec"><span class="exp-key">PROTOCOL</span><span class="exp-val">HTTP Server / Local LAN</span></p>
            </div>
          </li>

          <li class="exp-item">
            <span class="exp-num" aria-hidden="true">04</span>
            <div class="exp-body">
              <h3 class="exp-item-title">เริ่มต้นง่ายแม้ไม่มีพื้นฐาน</h3>
              <p class="exp-item-text">ฝึกจำลองการต่อวงจรบน Autodesk Tinkercad Circuits เพื่อป้องกันการลัดวงจร และเรียนรู้วิธีใช้ AI ช่วยขึ้นโครงสร้าง Web Interface อย่างเป็นระบบ</p>
              <p class="exp-spec"><span class="exp-key">TOOLING</span><span class="exp-val">Tinkercad / Code Assist</span></p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- Section 03: Camp Essentials -->
    <section id="essentials" class="ed-sec ed-sec--alt" aria-labelledby="essentials-title">
      <div class="wrap">
        <div class="section-head">
          <p class="ed-index"><span class="ed-index__no">03</span><span class="ed-index__label">ข้อมูลก่อนสมัคร · <span class="ed-en">ESSENTIALS</span></span></p>
          <h2 id="essentials-title" class="section-title">ข้อมูลที่ควรรู้ก่อนสมัคร</h2>
          <p class="body">สรุปคุณสมบัติ อุปกรณ์ จำนวนที่นั่ง สถานที่ และค่าใช้จ่าย เพื่อให้ตัดสินใจและเตรียมตัวได้ครบในหน้าเดียว</p>
          <p class="ed-aside-meta"><span class="ed-en">SPECIFICATION</span> · ข้อมูลสำคัญสำหรับผู้สมัครและผู้ปกครอง</p>
        </div>
        <div class="ed-main">
          <dl class="ed-metrics" aria-label="สรุปภาพรวมค่าย">
            <div class="ed-metric">
              <dt class="ed-metric__label">DURATION</dt>
              <dd class="ed-metric__val"><span class="font-mono tabular-nums">3</span> วัน <span class="font-mono tabular-nums">2</span> คืน</dd>
            </div>
            <div class="ed-metric">
              <dt class="ed-metric__label">TARGET LEVEL</dt>
              <dd class="ed-metric__val">ม.<span class="font-mono tabular-nums">4–6</span> · ปวช.<span class="font-mono tabular-nums">1–3</span></dd>
            </div>
            <div class="ed-metric">
              <dt class="ed-metric__label">OPENING DATE</dt>
              <dd class="ed-metric__val"><span class="font-mono tabular-nums">16</span> พ.ย. <span class="font-mono tabular-nums">69</span> · <span class="font-mono tabular-nums">00:00</span> น.</dd>
            </div>
          </dl>

          <div class="bento" role="list">
            <div role="listitem" class="card ed-cell--split">
              <div class="card-top"><span class="bento-tag">01 · ELIGIBILITY</span></div>
              <h3>คุณสมบัติผู้สมัคร</h3>
              <p>ม.<span class="font-mono tabular-nums">4</span>–ม.<span class="font-mono tabular-nums">6</span> และ ปวช.<span class="font-mono tabular-nums">1</span>–ปวช.<span class="font-mono tabular-nums">3</span> ทุกสายการเรียน ไม่จำเป็นต้องมีพื้นฐานด้านการเขียนโปรแกรมหรือวงจรไฟฟ้ามาก่อน</p>
            </div>

            <div role="listitem" class="card ed-cell--split">
              <div class="card-top"><span class="bento-tag">02 · HARDWARE KIT</span></div>
              <h3>อุปกรณ์การเรียน</h3>
              <p>มอบชุดฮาร์ดแวร์บอร์ดทดลองจริงครบเซต (Arduino UNO R3 + ESP8266 NodeMCU + เซนเซอร์) ให้น้อง ๆ ใช้งานทุกคน</p>
            </div>

            <div role="listitem" class="card ed-cell--split">
              <div class="card-top"><span class="bento-tag">03 · COMPUTER LAB</span></div>
              <h3>คอมพิวเตอร์ห้องปฏิบัติการ</h3>
              <p>จัดเตรียมห้องปฏิบัติการคอมพิวเตอร์พร้อมเครื่อง PC สำหรับผู้เข้าร่วมทุกคน ไม่บังคับนำโน้ตบุ๊กส่วนตัวมา</p>
            </div>

            <div role="listitem" class="card ed-cell--split">
              <div class="card-top"><span class="bento-tag">04 · VENUE</span></div>
              <h3>สถานที่จัดกิจกรรม</h3>
              <p>อาคารเรียนสาขาวิชาวิทยาการคอมพิวเตอร์ คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้ อ.สันทราย จ.เชียงใหม่</p>
            </div>

            <div role="listitem" class="card bento-feature">
              <div class="bento-feature__left">
                <div class="card-top">
                  <span class="bento-tag"><span class="bento-live-dot" aria-hidden="true"></span>05 · SEATS &amp; CAPACITY</span>
                </div>
                <div id="bento-seats-num" class="bento-big">30<small>ที่นั่ง</small></div>
              </div>
              <div class="bento-feature__right">
                <p id="bento-seats-caption">จำนวนจำกัด คัดเลือกตามลำดับการสมัครและยืนยันสิทธิ์แบบ First-Come, First-Served</p>
                <p class="bento-feature__meta">NO ENTRANCE EXAM · FIRST-COME, FIRST-SERVED</p>
              </div>
            </div>

            <div role="listitem" class="card ed-cell--ledger">
              <div class="ed-ledger__info">
                <div class="card-top"><span class="bento-tag">06 · CAMP FEE</span></div>
                <h3>ค่าใช้จ่ายในการเข้าร่วม <span class="ed-ledger__price"><span class="font-mono tabular-nums fee-num">1,000</span> บาท</span></h3>
                <!-- TODO(content): รอประกาศอย่างเป็นทางการ — รายการที่รวมในค่าสมัคร (ที่พัก/อาหาร/ชุดอุปกรณ์) — ยอด 1,000 บาท ยืนยันแล้ว -->
                <p class="todo">รายการที่รวมในค่าสมัครรอประกาศ</p>
              </div>
              <div class="ed-card-action">
                <a class="ed-inline-link ed-inline-link--strong" href="/register" data-register-link>
                  <span>เช็กคุณสมบัติ &amp; สมัครค่าย</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>

          <div class="ed-photo-strip" aria-label="ภาพบรรยากาศการเรียนรู้ในห้องปฏิบัติการ">
            <div class="ed-photo-strip__head">
              <span class="ed-photo-strip__kicker">ARCHIVE · CS LAB MAEJO UNIVERSITY</span>
              <span class="ed-photo-strip__note">ภาพบรรยากาศจริงจากค่าย ComCamp รุ่นที่ผ่านมา</span>
            </div>
            <div class="ed-photo-strip__grid">
              <figure class="ed-photo-card">
                <div class="ed-photo-card__frame">
                  <img
                    src={`${galleryBaseUrl}g04.jpg`}
                    srcset="/assets/gallery/g04-320.webp 320w, /assets/gallery/g04-640.webp 640w"
                    sizes="(min-width: 900px) 260px, (min-width: 640px) 30vw, 88vw"
                    data-fallback="/assets/gallery/g04.jpg"
                    onerror="this.onerror=null;this.removeAttribute('srcset');this.src=this.dataset.fallback;"
                    width="1400"
                    height="933"
                    loading="lazy"
                    decoding="async"
                    alt="ภาพมุมกว้างของนักเรียนค่ายที่นั่งเรียนและฝึกปฏิบัติบนเครื่องคอมพิวเตอร์ในห้องปฏิบัติการ คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้"
                  />
                </div>
                <figcaption class="ed-photo-card__cap"><span class="ed-photo-card__idx">FIG. 01</span>ฝึกปฏิบัติการจริงบนเครื่อง PC · CS Lab MJU</figcaption>
              </figure>
              <figure class="ed-photo-card">
                <div class="ed-photo-card__frame">
                  <img
                    src={`${galleryBaseUrl}g05.jpg`}
                    srcset="/assets/gallery/g05-320.webp 320w, /assets/gallery/g05-640.webp 640w"
                    sizes="(min-width: 900px) 260px, (min-width: 640px) 30vw, 44vw"
                    data-fallback="/assets/gallery/g05.jpg"
                    onerror="this.onerror=null;this.removeAttribute('srcset');this.src=this.dataset.fallback;"
                    width="1400"
                    height="933"
                    loading="lazy"
                    decoding="async"
                    alt="พี่เลี้ยง TA ยืนให้คำแนะนำอย่างใกล้ชิดข้างที่นั่ง ขณะน้องค่ายฝึกเขียนโปรแกรมแบบบล็อกบนหน้าจอคอมพิวเตอร์"
                  />
                </div>
                <figcaption class="ed-photo-card__cap"><span class="ed-photo-card__idx">FIG. 02</span>พี่เลี้ยง TA ดูแลใกล้ชิด · ไม่มีพื้นฐานก็เริ่มได้</figcaption>
              </figure>
              <figure class="ed-photo-card">
                <div class="ed-photo-card__frame">
                  <img
                    src={`${galleryBaseUrl}g34.jpg`}
                    srcset="/assets/gallery/g34-320.webp 320w, /assets/gallery/g34-640.webp 640w"
                    sizes="(min-width: 900px) 260px, (min-width: 640px) 30vw, 44vw"
                    data-fallback="/assets/gallery/g34.jpg"
                    onerror="this.onerror=null;this.removeAttribute('srcset');this.src=this.dataset.fallback;"
                    width="1400"
                    height="933"
                    loading="lazy"
                    decoding="async"
                    alt="นักเรียนและพี่เลี้ยงร่วมกันวิเคราะห์ผลลัพธ์บนหน้าจอคอมพิวเตอร์เป็นทีมในห้องปฏิบัติการ คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้"
                  />
                </div>
                <figcaption class="ed-photo-card__cap"><span class="ed-photo-card__idx">FIG. 03</span>เรียนรู้ร่วมกันเป็นทีม · คณะวิทยาศาสตร์ ม.แม่โจ้</figcaption>
