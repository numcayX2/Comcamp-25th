---
/**
 * HeroSection.astro — ComCamp #25 Hero Section
 *
 * Usage:
 *   <HeroSection />                      → Clean bold sans title (Swiss editorial)
 *   <HeroSection titleStyle="pixel" />   → Pixel / dot-matrix title (Figma draft)
 */
import '@fontsource/space-grotesk/700.css';

interface Props {
  titleStyle?: 'sans' | 'pixel';
  registerHref?: string;
  statusHref?: string;
}

const {
  titleStyle = 'sans',
  registerHref = '/register',
  statusHref = '/status',
} = Astro.props;
---

<section class="hero" id="sec-hero" data-title-style={titleStyle} aria-labelledby="hero-title">
  <div class="hero__grid">
    <div class="hero__copy">
      <picture>
        <source srcset="/assets/logo/comcamp25-logo-sm.webp" type="image/webp" />
        <img
          class="hero__logo"
          src="/assets/logo/comcamp25-logo-sm.png"
          alt="ComCamp 25th"
          width="420"
          height="297"
          fetchpriority="high"
          decoding="async"
        />
      </picture>

      <p class="hero__eyebrow"><span>MAEJO UNIVERSITY</span><i aria-hidden="true"></i></p>

      <h1 class="hero__title" id="hero-title" aria-label="Comcamp 25th">
        <span>Comcamp</span> <span>25th</span>
      </h1>

      <p class="hero__sub">
        3 วัน 2 คืน ลงมือต่อวงจรจริง อ่านค่าเซนเซอร์ Ultrasonic และ LDR แล้วสร้าง Web Dashboard สั่งงานผ่านสมาร์ตโฟน — เริ่มจากศูนย์ได้ มี AI ช่วยขึ้นโครงและดีบักโค้ด
      </p>
      <p class="hero__fee">
        <span class="hero__fee-amount"><span class="font-mono">1,000</span> บาท</span>
        <span class="hero__fee-label">ค่าสมัคร</span>
      </p>

      <div class="hero__actions">
        <a class="hero__cta" id="cta-primary" href={registerHref} data-register-link>
          <span>เปิดรับสมัคร 16 พ.ย.</span>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square">
            <path d="M4 12 12 4M5.5 4H12v6.5" />
          </svg>
        </a>
        <a class="hero__link" id="cta-secondary" href={statusHref}>ตรวจสอบสถานะใบสมัคร →</a>
      </div>

      <p class="hero__proof">
        <span>สาขาวิชาวิทยาการคอมพิวเตอร์ คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้</span>
        <span class="hero__proof-sep" aria-hidden="true"></span>
        <span>ComCamp <span class="font-mono">#25</span> · ครบรอบ 25 ปี</span>
      </p>
    </div>

    <!-- ───────────── RIGHT: 3D hardware stage ───────────── -->
    <div class="hero__stage-wrap">
      <!-- Architectural backdrop (behind the canvas) -->
      <div class="hero__backdrop" aria-hidden="true">
        <span class="bd bd-circle"></span>
        <span class="bd bd-panel"></span>
        <span class="bd bd-hline"></span>
        <span class="bd bd-vline"></span>
        <span class="bd bd-cross"></span>
      </div>

      <div class="hero-stage" id="heroStage" data-state="loading">
        <canvas
          id="heroStageCanvas"
          role="img"
          tabindex="0"
          aria-label="โมเดล 3 มิติของบอร์ด ESP8266 และ Arduino UNO R3 ใช้ปุ่มลูกศรซ้ายขวาเพื่อหมุนดูรอบตัว"
        ></canvas>

        <p class="hero-stage__loading" aria-live="polite">Loading 3D…</p>

        <!-- Fallback slot: shown only if WebGL is unavailable or both .glb files fail. -->
        <p class="hero-stage__fallback">
          <span class="hero-stage__fallback-tag">HARDWARE</span>
          <span class="hero-stage__fallback-name">Arduino UNO R3</span>
          <span class="hero-stage__fallback-plus" aria-hidden="true">+</span>
          <span class="hero-stage__fallback-name">ESP8266 NodeMCU</span>
        </p>
      </div>
    </div>
  </div>

  <!-- Far-right callout badge (desktop only) -->
  <div class="hero__badge" aria-hidden="true">
    <p class="hero__badge-num">25<sup>th</sup></p>
    <p class="hero__badge-label">ANNIVERSARY<br />COMCAMP</p>
  </div>

  <!-- ───────────── Bottom bar ───────────── -->
  <div class="hero__bar">
    <p class="hero__bar-start">
      <i class="hero__dash" aria-hidden="true"></i>
      <span>
        <b>25 YEARS</b>
        <small>OF LEARNING AND INNOVATION</small>
      </span>
    </p>

    <a class="hero__explore" href="#experience" aria-label="Explore — เลื่อนลง">
      <span>Explore</span>
      <i class="hero__explore-line" aria-hidden="true"></i>
    </a>

    <div class="hero__bar-end" aria-hidden="true">
      <i class="hero__rule"></i>
      <i class="hero__tick"></i>
      <span class="hero__slashes"><i></i><i></i><i></i></span>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(SplitText);

  (function loadHeroStage() {
    // The 3D stage (three.js ≈ 600 KB + 933 KB of .glb) is decorative — it
    // must never compete with the headline/CTA for bandwidth. Defer the whole
    // module graph until the page has finished loading and the main thread is idle.
    const start = () => {
      import('../scripts/hero-3d.js').catch((err) => {
        console.warn('[hero] 3D stage failed to load:', err);
        const stage = document.getElementById('heroStage');
        if (stage) stage.dataset.state = 'fallback';
      });
    };

    if (document.readyState === 'complete') {
      start();
      return;
    }
    window.addEventListener('load', () => {
      if ('requestIdleCallback' in window) {
        requestIdleCallback(start, { timeout: 1200 });
      } else {
        setTimeout(start, 200);
      }
    }, { once: true });
  })();

  (function initHeroIntro() {
    const title = document.getElementById('hero-title');
    const sub = document.querySelector<HTMLElement>('.hero__sub');
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const spans = title ? Array.from(title.querySelectorAll('span')) : [];
    const targets = spans.map((el) => el.textContent ?? '');
    const GLYPHS = '01#@$%*+=<>[]/\\ABCDEFGHKMNPQRSTUVWXYZ25';
    const DURATION_MS = 1450;
    const STEP_MS = 38;

    const randomGlyph = () => GLYPHS[(Math.random() * GLYPHS.length) | 0];

    const startScramble = () => {
      if (!title || title.dataset.scrambled === '1' || spans.length === 0) return;
      title.dataset.scrambled = '1';

      const totalChars = targets.reduce((acc, s) => acc + s.length, 0);
      if (totalChars === 0) return;

      const t0 = performance.now();
      let lastTick = 0;

      const frame = (now: number) => {
        const elapsed = now - t0;
        const progress = Math.min(1, elapsed / DURATION_MS);

        if (progress >= 1) {
          spans.forEach((el, i) => {
            el.textContent = targets[i];
          });
          return;
        }

        if (now - lastTick >= STEP_MS) {
          lastTick = now;
          const eased = 1 - Math.pow(1 - progress, 2.2);
          const lockedGlobal = Math.floor(eased * totalChars);

          let offset = 0;
          spans.forEach((el, sIdx) => {
            const target = targets[sIdx];
            let out = '';
            for (let c = 0; c < target.length; c++) {
              const ch = target[c];
              if (ch === ' ') {
                out += ' ';
              } else if (offset + c < lockedGlobal) {
                out += ch;
              } else {
                out += randomGlyph();
              }
            }
            el.textContent = out;
            offset += target.length;
          });
        }

        requestAnimationFrame(frame);
      };

      requestAnimationFrame(frame);
    };

    const startSubtitleReveal = () => {
      if (!sub || sub.dataset.revealed === '1') return;
      sub.dataset.revealed = '1';
      // Split after the web font has swapped, otherwise the measured line breaks
      // would be computed against the fallback font and re-wrap once it loads.
      const ready = document.fonts?.ready ?? Promise.resolve();
      ready.then(() => {
        SplitText.create(sub, {
          type: 'lines',
          mask: 'lines',
          // `auto` would stamp aria-label onto the <p>, which is prohibited on a
          // generic role and fails axe `aria-prohibited-attr`.
          aria: 'none',
          onSplit(self) {
            return gsap.from(self.lines, {
              x: 44,
              opacity: 0,
              duration: 0.72,
              stagger: 0.09,
              ease: 'power3.out',
              clearProps: 'transform,opacity',
            });
          },
        });
      });
    };

    const startAll = (animateSub: boolean) => {
      startScramble();
      if (animateSub) startSubtitleReveal();
    };

    const veil = document.getElementById('veil');
    const veilActive =
      veil &&
      !veil.hidden &&
      !veil.classList.contains('is-done') &&
      !document.documentElement.classList.contains('veil-skip');

    if (!veilActive) {
      // Repeat visit / reduced motion / anchor jump: the veil is already gone,
      // so a subtitle entrance would flash the text from hidden → visible.
      startAll(false);
      return;
    }

    let started = false;
    const trigger = () => {
      if (started) return;
      started = true;
      mo.disconnect();
      setTimeout(() => startAll(true), 120);
    };

    const mo = new MutationObserver(() => {
      if (veil.classList.contains('is-done') || veil.hidden) trigger();
    });
    mo.observe(veil, { attributes: true, attributeFilter: ['class', 'hidden'] });
    setTimeout(trigger, 1000);
  })();
</script>
