---
import '../styles/sponsor.css';
import SponsorInquiryForm from './SponsorInquiryForm';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Copy from '@lucide/astro/icons/copy';
import FileDown from '@lucide/astro/icons/file-down';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import MessageCircle from '@lucide/astro/icons/message-circle';
import Phone from '@lucide/astro/icons/phone';
import {
  MAX_CAPACITY,
  SPONSOR_DECK_PDF,
  SPONSOR_DECK_READY,
  SPONSOR_FORM_FILENAME,
  SPONSOR_FORM_PDF,
} from '../lib/camp-facts';
import { GALLERY_BASE_URL } from '../lib/gallery';
import { PAY_ACCOUNT, PAY_ACCOUNT_DIGITS } from '../lib/payment';
import { FB_URL, PROJECT_ADVISOR, STAFF_CONTACTS } from './register/model';

/* Hands-on lab shots already curated for the home page (#essentials photo strip). */
const PHOTOS = [
  {
    file: 'g05.jpg',
    alt: 'พี่เลี้ยงยืนให้คำแนะนำอย่างใกล้ชิดข้างที่นั่ง ขณะน้องค่ายฝึกเขียนโปรแกรมบนหน้าจอคอมพิวเตอร์',
    caption: 'พี่เลี้ยงดูแลใกล้ชิดระหว่างฝึกปฏิบัติ',
  },
  {
    file: 'g34.jpg',
    alt: 'นักเรียนและพี่เลี้ยงร่วมกันวิเคราะห์ผลลัพธ์บนหน้าจอคอมพิวเตอร์เป็นทีมในห้องปฏิบัติการ คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้',
    caption: 'ทำงานเป็นทีมในแล็บ',
  },
];
---

<article class="sp-page">
  <!-- Masthead: statement left, camp facts ledger right -->
  <header class="sp-hero">
    <div class="sp-hero__main">
      <p class="sp-eyebrow">สนับสนุนค่าย</p>
      <h1 class="sp-title">
        ร่วมสนับสนุนค่ายยุวชนคอมพิวเตอร์ ครั้งที่ <span class="font-mono tabular-nums">25</span>
      </h1>
      <p class="sp-lead">
        ComCamp <span class="font-mono tabular-nums">#25</span> คือค่ายยุวชนคอมพิวเตอร์ของสาขาวิชาวิทยาการคอมพิวเตอร์
        คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้ การสนับสนุนของท่านช่วยให้ค่ายจัดชุดอุปกรณ์ อาหาร และกิจกรรมให้น้อง ๆ
        ได้ครบตลอดค่าย
      </p>
      <div class="sp-hero__actions">
        <a class="sp-btn sp-btn--primary" href="#inquiry">
          <span>แจ้งความประสงค์สนับสนุน</span>
          <ArrowRight class="sp-ico" size={16} stroke-width={1.5} aria-hidden="true" />
        </a>
        <a class="sp-btn sp-btn--secondary" href="#contact">
          <Phone class="sp-ico" size={16} stroke-width={1.5} aria-hidden="true" />
          <span>ติดต่อสตาฟค่าย</span>
        </a>
      </div>
    </div>

    <dl class="sp-gazette" aria-label="ข้อมูลค่ายโดยย่อ">
      <div class="sp-gazette__row">
        <dt class="sp-gazette__key">วันจัดค่าย</dt>
        <dd class="sp-gazette__val">
          <span class="font-mono tabular-nums">5–7</span> ก.พ. <span class="font-mono tabular-nums">2570</span>
        </dd>
      </div>
      <div class="sp-gazette__row">
        <dt class="sp-gazette__key">ผู้เข้าร่วม</dt>
        <dd class="sp-gazette__val"><span class="font-mono tabular-nums" data-sp-seats>{MAX_CAPACITY}</span> คน</dd>
      </div>
      <div class="sp-gazette__row">
        <dt class="sp-gazette__key">ระดับชั้น</dt>
        <dd class="sp-gazette__val">
          ม.<span class="font-mono tabular-nums">4</span>–ม.<span class="font-mono tabular-nums">6</span> / ปวช.<span
            class="font-mono tabular-nums">1</span
          >–<span class="font-mono tabular-nums">3</span>
        </dd>
      </div>
      <div class="sp-gazette__row">
        <dt class="sp-gazette__key">สถานที่</dt>
        <dd class="sp-gazette__val">
          อาคาร <span class="font-mono tabular-nums">60</span> ปี แม่โจ้ ชั้น <span class="font-mono tabular-nums">6</span>
        </dd>
      </div>
    </dl>
  </header>

  <!-- 1. What the camp is, real lab photos, and where sponsorship goes -->
  <section id="about" class="sp-sec" aria-labelledby="sp-about-title">
    <h2 id="sp-about-title" class="sp-h2">รู้จักค่าย ComCamp <span class="font-mono tabular-nums">#25</span></h2>

    <div class="sp-why__grid">
      <div class="sp-why__main">
        <p class="sp-statement">
          ตลอด <span class="font-mono tabular-nums">3</span> วัน <span class="font-mono tabular-nums">2</span> คืน
          น้อง ๆ ได้เรียนงานไมโครคอนโทรลเลอร์ตั้งแต่พื้นฐาน จนสร้างและนำเสนอผลงานของตัวเองได้
        </p>
        <div class="sp-photos">
          {PHOTOS.map((p) => (
            <figure class="sp-photo">
              <img
                src={`${GALLERY_BASE_URL}${p.file}`}
                data-fallback={`/assets/gallery/${p.file}`}
                onerror="this.onerror=null;this.src=this.dataset.fallback;"
                width="1400"
                height="933"
                loading="lazy"
                decoding="async"
                alt={p.alt}
              />
              <figcaption class="sp-photo__cap">{p.caption}</figcaption>
            </figure>
          ))}
        </div>
        <p class="sp-photos__note">ภาพบรรยากาศจริงจากค่าย ComCamp รุ่นที่ผ่านมา</p>
      </div>

      <div class="sp-why__body">
        <p>
          น้อง ๆ เริ่มจากการจำลองวงจรบนคอมพิวเตอร์ ต่อวงจรจริงด้วย <span class="font-mono">Arduino UNO R3</span> และ{' '}
          <span class="font-mono">ESP8266</span> ไปจนถึงการทำ <span class="font-mono">IoT Dashboard</span>{' '}
          และนำเสนอผลงานสดบนเวที
        </p>
        <p>การสนับสนุนของท่านช่วยแบ่งเบาค่าใช้จ่ายในการจัดค่าย เช่น</p>
        <ul class="sp-costs">
          <li>
            <strong>ชุดอุปกรณ์สำหรับน้อง ๆ</strong>
            บอร์ด <span class="font-mono">Arduino UNO R3</span> และ <span class="font-mono">ESP8266</span>{' '}
            พร้อมเซนเซอร์สำหรับฝึกปฏิบัติ
          </li>
          <li>
            <strong>อาหาร</strong>
            อาหารและอาหารว่างตลอดกิจกรรมในค่าย
          </li>
          <li>
            <strong>กิจกรรม</strong>
            การเรียนการสอน การทำโครงงาน และการนำเสนอผลงาน
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. What sponsors receive: the value exchange comes before the ask -->
  <section id="benefits" class="sp-sec sp-sec--awards" aria-labelledby="sp-benefits-title">
    <div class="sp-awards">
      <div class="sp-benefits">
        <div class="sp-benefits__head">
          <h2 id="sp-benefits-title" class="sp-h2">สิ่งที่ผู้สนับสนุนได้รับ</h2>
          <p class="sp-benefits__note">สตาฟค่ายจะยืนยันรายละเอียดกับท่านอีกครั้งตอนติดต่อกลับ</p>
        </div>

        <ul class="sp-benefit-list">
          <li class="sp-benefit">
            <h3 class="sp-benefit__title">ชื่อหรือโลโก้ในแถบ “ขอบคุณผู้สนับสนุน”</h3>
            <p class="sp-benefit__text">
              แสดงบนหน้าแรกของเว็บไซต์ค่าย ในแถบขอบคุณผู้สนับสนุนใต้ส่วนหัวของหน้า
            </p>
            <a class="sp-link" href="/#sponsors" hidden data-sp-sponsors-link>
              <span>ดูแถบขอบคุณผู้สนับสนุนบนหน้าแรก</span>
              <ArrowRight class="sp-ico" size={16} stroke-width={1.5} aria-hidden="true" />
            </a>
          </li>
          <li class="sp-benefit">
            <h3 class="sp-benefit__title">เอกสารลดหย่อนภาษีผ่านคณะวิทยาศาสตร์ (บริจาคเงิน)</h3>
            <p class="sp-benefit__text">
              ทีมงานค่ายส่งข้อมูลการบริจาคเงินให้คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้ ซึ่งเป็นผู้ออกเอกสาร
            </p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. Ordered process 01–03: inquire first, before any bank details -->
  <section id="steps" class="sp-sec" aria-labelledby="sp-steps-title">
    <h2 id="sp-steps-title" class="sp-h2">ขั้นตอนการสนับสนุน</h2>
    <p class="sp-sec__lead">
      แจ้งความประสงค์ก่อน แล้วสตาฟค่ายจะประสานงานกับท่านให้ครบทุกขั้นตอน
    </p>

    <ol class="sp-steps">
      <li class="sp-step">
        <span class="sp-step__no font-mono tabular-nums" aria-hidden="true">01</span>
        <div class="sp-step__body">
          <h3 class="sp-step__title">แจ้งความประสงค์</h3>
          <p class="sp-step__text">
            กรอกแบบฟอร์มท้ายหน้านี้ หรือโทรหาสตาฟค่าย หากบริจาคเงิน จะแนบแบบฟอร์มบริจาคเงินที่กรอกและลงนามแล้วมาด้วยก็ได้
          </p>
        </div>
      </li>
      <li class="sp-step">
        <span class="sp-step__no font-mono tabular-nums" aria-hidden="true">02</span>
        <div class="sp-step__body">
          <h3 class="sp-step__title">สตาฟค่ายติดต่อกลับ</h3>
          <p class="sp-step__text">
            สตาฟค่ายติดต่อกลับเพื่อยืนยันรายละเอียด รับแบบฟอร์มบริจาคเงินที่ลงนามแล้วหากท่านยังไม่ได้ส่งมา
            หรือนัดหมายรับสิ่งของ
          </p>
        </div>
      </li>
      <li class="sp-step">
        <span class="sp-step__no font-mono tabular-nums" aria-hidden="true">03</span>
        <div class="sp-step__body">
          <h3 class="sp-step__title">คณะดำเนินเรื่องลดหย่อนภาษี (บริจาคเงิน)</h3>
          <p class="sp-step__text">
            ทีมงานส่งข้อมูลให้คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้ ดำเนินเรื่องลดหย่อนภาษีให้ผู้สนับสนุน
          </p>
        </div>
      </li>
    </ol>
  </section>

  <!-- 4. Ways to support: two paper slips (cash, goods) with the same ledger summary rows -->
  <section id="ways" class="sp-sec" aria-labelledby="sp-ways-title">
    <h2 id="sp-ways-title" class="sp-h2">วิธีสนับสนุน</h2>
    <p class="sp-sec__lead">สนับสนุนได้ทั้งเงินและสิ่งของ ต่างกันที่เรื่องแบบฟอร์มและการลดหย่อนภาษี</p>

    <div class="sp-ways">
      <div class="sp-way sp-way--money">
        <div class="sp-receipt">
          <h3 class="sp-way__title">สนับสนุนด้วยเงิน</h3>
          <p class="sp-way__text">
            โอนเข้าบัญชีของชมรม หรือมอบเงินสดให้สตาฟค่ายโดยตรง ไม่มี QR Code สำหรับการโอน
          </p>

          <p class="sp-account__pre">
            แจ้งความประสงค์หรือติดต่อสตาฟค่ายก่อนโอน และเก็บสลิปไว้ส่งให้สตาฟค่ายตอนติดต่อกลับ
          </p>
          <dl class="sp-ledger">
            <div class="sp-ledger__row">
              <dt>ธนาคาร</dt>
              <dd>{PAY_ACCOUNT.bank}</dd>
            </div>
            <div class="sp-ledger__row">
              <dt>ชื่อบัญชี</dt>
              <dd>{PAY_ACCOUNT.name}</dd>
            </div>
            <div class="sp-ledger__row sp-ledger__row--stack">
              <dt>ผู้ถือบัญชี</dt>
              <dd>{PAY_ACCOUNT.holders}</dd>
            </div>
            <div class="sp-ledger__row sp-ledger__row--total">
              <dt>เลขที่บัญชี</dt>
              <dd class="sp-account__no font-mono tabular-nums">{PAY_ACCOUNT.number}</dd>
            </div>
          </dl>

          <div class="sp-copy-row">
            <button class="sp-copy" type="button" data-sp-copy={PAY_ACCOUNT_DIGITS} aria-describedby="sp-copy-status">
              <Copy class="sp-ico" size={16} stroke-width={1.5} aria-hidden="true" />
              <span>คัดลอกเลขบัญชี</span>
            </button>
            <p id="sp-copy-status" class="sp-copy-status" role="status"></p>
          </div>

          <dl class="sp-ledger">
            <div class="sp-ledger__row">
              <dt>แบบฟอร์มบริจาค</dt>
              <dd>ใช้แบบฟอร์มของคณะ</dd>
            </div>
            <div class="sp-ledger__row">
              <dt>ลดหย่อนภาษี</dt>
              <dd>ได้</dd>
            </div>
          </dl>

          <div class="sp-taxform">
            <a class="sp-btn sp-btn--secondary" href={SPONSOR_FORM_PDF} download={SPONSOR_FORM_FILENAME}>
              <FileDown class="sp-ico" size={16} stroke-width={1.5} aria-hidden="true" />
              <span>แบบฟอร์มบริจาคเงิน</span>
              <span class="sp-btn__meta font-mono">PDF</span>
            </a>
            <p class="sp-taxform__note">
              ช่องเลขประจำตัวผู้เสียภาษี/เลขบัตรประชาชนเว้นว่างไว้ก่อนได้ สตาฟค่ายจะสอบถามตอนติดต่อกลับ
            </p>
            <a class="sp-link" href="#sponsor-upload">
              <span>กรอกแล้ว แนบไฟล์ส่งให้สตาฟค่าย</span>
              <ArrowRight class="sp-ico" size={16} stroke-width={1.5} aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>

      <div class="sp-way sp-way--goods">
        <div class="sp-receipt">
          <h3 class="sp-way__title">สนับสนุนด้วยสิ่งของ</h3>
          <p class="sp-way__text">
            สนับสนุนเป็นอุปกรณ์ ของรางวัล หรืออาหารสำหรับกิจกรรม แจ้งรายการในแบบฟอร์มท้ายหน้านี้
            แล้วสตาฟค่ายจะติดต่อกลับเพื่อนัดหมาย
          </p>

          <p class="sp-receipt__label">ตัวอย่างสิ่งของที่รับ</p>
          <ul class="sp-goods">
            <li>อุปกรณ์อิเล็กทรอนิกส์สำหรับกิจกรรมการเรียน</li>
            <li>ของรางวัลสำหรับกิจกรรมในค่าย</li>
            <li>อาหารและเครื่องดื่มสำหรับผู้เข้าร่วม</li>
          </ul>

          <dl class="sp-ledger">
            <div class="sp-ledger__row">
              <dt>แบบฟอร์มบริจาค</dt>
              <dd>ไม่ต้องใช้</dd>
            </div>
            <div class="sp-ledger__row">
              <dt>ลดหย่อนภาษี</dt>
              <dd>ไม่ได้</dd>
            </div>
          </dl>

          <a class="sp-link sp-receipt__cta" href="#inquiry">
            <span>แจ้งรายการสิ่งของในแบบฟอร์ม</span>
            <ArrowRight class="sp-ico" size={16} stroke-width={1.5} aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Sponsor deck: nothing renders until the real PDF exists -->
  {SPONSOR_DECK_READY && (
    <section id="deck" class="sp-sec" aria-labelledby="sp-deck-title">
      <h2 id="sp-deck-title" class="sp-h2">เอกสารแนะนำผู้สนับสนุน</h2>
      <p class="sp-deck__text">ดาวน์โหลดเอกสารเพื่อดูภาพรวมค่ายและช่องทางการสนับสนุน</p>
      <div class="sp-deck__action">
        <a class="sp-btn sp-btn--secondary" href={SPONSOR_DECK_PDF} download>
          <FileDown class="sp-ico" size={16} stroke-width={1.5} aria-hidden="true" />
          <span>ดาวน์โหลดเอกสาร (PDF)</span>
        </a>
      </div>
    </section>
  )}

  <!-- 6–7. Inquiry form and the staff contact rail -->
  <div class="sp-close">
    <section id="inquiry" class="sp-sec" aria-labelledby="sp-inquiry-title">
      <SponsorInquiryForm client:idle />
    </section>

    <section id="contact" class="sp-sec sp-contact" aria-labelledby="sp-contact-title">
      <h2 id="sp-contact-title" class="sp-h2">ติดต่อสตาฟค่าย</h2>
      <p class="sp-contact__lead">
        สอบถามรายละเอียดก่อนตัดสินใจสนับสนุนได้โดยตรงที่สตาฟค่ายหรือเพจโครงการ
      </p>

      <ul class="sp-contact__list">
        {STAFF_CONTACTS.map((c) => (
          <li>
            <a class="sp-contact__row" href={`tel:${c.tel}`}>
              <Phone class="sp-ico" size={16} stroke-width={1.5} aria-hidden="true" />
              <span class="sp-contact__text">
                <span class="sp-phone font-mono tabular-nums">{c.phone}</span>
                <span class="sp-contact__name">{c.name}</span>
              </span>
            </a>
          </li>
        ))}
        <li>
          <a class="sp-contact__row" href={FB_URL} target="_blank" rel="noopener noreferrer">
            <MessageCircle class="sp-ico" size={16} stroke-width={1.5} aria-hidden="true" />
            <span class="sp-contact__text">
              <span>Facebook เพจโครงการ (<span class="font-mono">CCCSMJU</span>)</span>
            </span>
            <ArrowUpRight class="sp-contact__ext" size={16} stroke-width={1.5} aria-hidden="true" />
          </a>
        </li>
      </ul>

      <p class="sp-advisor">
        <GraduationCap class="sp-ico" size={16} stroke-width={1.5} aria-hidden="true" />
        <span>อาจารย์ที่ปรึกษาโครงการ <strong>{PROJECT_ADVISOR}</strong></span>
      </p>
    </section>
  </div>

  <footer class="sp-foot">
    <nav class="sp-foot__links" aria-label="ลิงก์ท้ายหน้า">
      <a class="sp-link" href="/">กลับหน้าหลัก</a>
      <a class="sp-link" href="/guide">คู่มือผู้สมัคร</a>
    </nav>
  </footer>
</article>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { copyText } from '../lib/payment';
  import { API_BASE, fetchSponsors } from '../lib/api';
  import { fetchSharedPublicSettings } from '../lib/public-settings-cache';

  gsap.registerPlugin(ScrollTrigger);

  /* Soft play-in: blocks rise 20px and fade in, in document order. Enhance-only: the CSS never
     hides anything, blocks already scrolled past are left alone, and only blocks below the fold
     are held at opacity 0 until ScrollTrigger plays them in. Reduced motion = no tweens at all. */
  const REVEAL_SELECTOR = [
    '.sp-hero__main > *',
    '.sp-gazette__row',
    '.sp-sec > .sp-h2',
    '.sp-sec__lead',
    '.sp-statement',
    '.sp-photo',
    '.sp-photos__note',
    '.sp-why__body > *',
    '.sp-benefits__head',
    '.sp-benefit',
    '.sp-step',
    '.sp-receipt',
    '.sp-deck__text',
    '.sp-deck__action',
    '#inquiry',
    '.sp-contact > *',
    '.sp-foot',
  ].join(', ');
  const REVEAL_FROM = { opacity: 0, y: 20 };
  const REVEAL_TO = { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', clearProps: 'opacity,transform' };
  // The two payment slips feed out like a receipt printer: revealed top to bottom while easing down.
  const RECEIPT = '.sp-receipt';
  const PRINT_FROM = { clipPath: 'inset(0% 0% 100% 0%)', y: -14 };
  const PRINT_TO = {
    clipPath: 'inset(0% 0% 0% 0%)',
    y: 0,
    duration: 1.1,
    ease: 'power2.out',
    stagger: 0.18,
    clearProps: 'clipPath,transform',
  };
  const CLEAR_ALL = { clearProps: 'opacity,transform,clipPath' };
  let motionAbort: AbortController | null = null;

  /** Stagger that keeps a long batch from trailing on: at most 0.5s spread in total. */
  function staggerFor(count: number): number {
    return count > 1 ? Math.min(0.07, 0.5 / (count - 1)) : 0;
  }

  function splitReceipts(els: HTMLElement[]): [HTMLElement[], HTMLElement[]] {
    const receipts = els.filter((el) => el.matches(RECEIPT));
    return [receipts, els.filter((el) => !el.matches(RECEIPT))];
  }

  function holdBack(els: HTMLElement[]) {
    const [receipts, blocks] = splitReceipts(els);
    if (blocks.length) gsap.set(blocks, REVEAL_FROM);
    if (receipts.length) gsap.set(receipts, PRINT_FROM);
  }

  function playIn(els: HTMLElement[]) {
    const [receipts, blocks] = splitReceipts(els);
    if (blocks.length) gsap.to(blocks, { ...REVEAL_TO, stagger: staggerFor(blocks.length) });
    if (receipts.length) gsap.to(receipts, PRINT_TO);
  }

  function initSponsorMotion() {
    const page = document.querySelector('.sp-page');
    if (!page || motionAbort) return;
    motionAbort = new AbortController();
    const { signal } = motionAbort;
    const mm = gsap.matchMedia();

    mm.add('(prefers-reduced-motion: no-preference)', (ctx) => {
      const items = Array.from(page.querySelectorAll<HTMLElement>(REVEAL_SELECTOR));
      const viewH = window.innerHeight;
      const inView: HTMLElement[] = [];
      const below: HTMLElement[] = [];
      for (const el of items) {
        const rect = el.getBoundingClientRect();
        if (rect.top >= viewH) below.push(el);
        else if (rect.bottom > 0) inView.push(el);
      }

      if (inView.length) {
        holdBack(inView);
        playIn(inView);
      }
      if (!below.length) return;
      holdBack(below);

      // Blocks that cross the start line together (fast scroll, anchor jumps) play as one
      // staggered batch; once: true so scrolling back up never hides them again.
      ScrollTrigger.batch(below, {
        start: 'top 92%',
        once: true,
        onEnter: (batch) => {
          ctx.add(() => playIn(batch as HTMLElement[]));
        },
      });
      // Web fonts change line wraps, so trigger positions are measured again once they load.
      document.fonts?.ready.then(() => {
        if (!signal.aborted) ScrollTrigger.refresh();
      });
      // Printing must never capture blocks that were still waiting below the fold.
      window.addEventListener(
        'beforeprint',
        () => gsap.set(below, CLEAR_ALL),
        { signal },
      );
    });

    signal.addEventListener('abort', () => mm.revert());
  }

  // ClientRouter keeps window alive across pages: drop triggers/tweens before the next page swaps in.
  document.addEventListener('astro:before-swap', () => {
    motionAbort?.abort();
    motionAbort = null;
  });

  const COPY_OK_MS = 2200;
  const COPY_ERR_MS = 5000;
  const copyTimers = new WeakMap<HTMLElement, number>();

  function initSponsorCopy() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-sp-copy]');
    buttons.forEach((button) => {
      if (button.dataset.spCopyBound === 'true') return;
      button.dataset.spCopyBound = 'true';

      button.addEventListener('click', async () => {
        const statusId = button.getAttribute('aria-describedby');
        const status = statusId ? document.getElementById(statusId) : null;
        const ok = await copyText(button.dataset.spCopy ?? '');
        if (!status) return;
        // Clear first so role="status" announces again on a repeat click.
        window.clearTimeout(copyTimers.get(status));
        status.textContent = '';
        delete status.dataset.state;
        window.requestAnimationFrame(() => {
          status.textContent = ok
            ? 'คัดลอกเลขบัญชีแล้ว'
            : 'คัดลอกอัตโนมัติไม่ได้ กรุณาเลือกเลขบัญชีแล้วคัดลอกเอง';
          status.dataset.state = ok ? 'ok' : 'err';
          copyTimers.set(
            status,
            window.setTimeout(() => {
              status.textContent = '';
              delete status.dataset.state;
            }, ok ? COPY_OK_MS : COPY_ERR_MS),
          );
        });
      });
    });
  }

  /* The home page hides #sponsors while the sponsor list is empty, so this link only
     un-hides once the list endpoint confirms at least one sponsor exists. */
  async function syncSponsorLink() {
    const link = document.querySelector<HTMLElement>('[data-sp-sponsors-link]');
    // The module-load call and the initial astro:page-load both land here; fetch once per page.
    if (!link || link.dataset.spSponsorsChecked === 'true') return;
    link.dataset.spSponsorsChecked = 'true';

    try {
      const sponsors = await fetchSponsors();
      if (sponsors.length > 0) link.removeAttribute('hidden');
    } catch {
      /* List unreachable: keep the link hidden so it never lands on an empty section. */
    }
  }

  async function syncSponsorSettings() {
    const seatEls = document.querySelectorAll<HTMLElement>('[data-sp-seats]');
    // Same once-per-page guard as syncSponsorLink.
    if (!seatEls.length || seatEls[0].dataset.spSeatsSynced === 'true') return;
    seatEls[0].dataset.spSeatsSynced = 'true';

    try {
      const settings = await fetchSharedPublicSettings(API_BASE, { timeoutMs: 4000 });
      if (
        typeof settings.maxCapacity === 'number' &&
        Number.isFinite(settings.maxCapacity) &&
        settings.maxCapacity > 0
      ) {
        const capText = String(settings.maxCapacity);
        seatEls.forEach((el) => {
          el.textContent = capText;
        });
      }
    } catch {
      /* Keep the server-rendered fallback value when settings cannot be reached. */
    }
  }

  initSponsorMotion();
  initSponsorCopy();
  syncSponsorLink();
  syncSponsorSettings();
  document.addEventListener('astro:page-load', initSponsorMotion);
  document.addEventListener('astro:page-load', initSponsorCopy);
  document.addEventListener('astro:page-load', syncSponsorLink);
  document.addEventListener('astro:page-load', syncSponsorSettings);
</script>
