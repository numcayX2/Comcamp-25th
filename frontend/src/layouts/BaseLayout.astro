---
import { ClientRouter } from 'astro:transitions';
import '../styles/fonts.css';
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  description?: string;
  /** The floating back-to-top button collides with pages that own a sticky bottom bar (e.g. /register). */
  backToTop?: boolean;
  /** Extra class on <body> for pages that need to override the shared body defaults. */
  bodyClass?: string;
  /** Browser UI colour on mobile; match whatever sits at the top edge of the page. */
  themeColor?: string;
}

const {
  title = 'ComCamp #25 // ค่ายวิทยาการคอมพิวเตอร์ มหาวิทยาลัยแม่โจ้',
  description = 'เว็บไซต์รับสมัครค่าย ComCamp ครั้งที่ 25 สาขาวิทยาการคอมพิวเตอร์ คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้ (16 พ.ย. 2026)',
  backToTop = true,
  bodyClass,
  themeColor = '#F9F8F4',
} = Astro.props;
---

<!doctype html>
<html lang="th" class="min-h-dvh w-full overflow-x-clip overflow-y-auto scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={themeColor} />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    {/* Anti-FOUC instant inline theme detection & background style */}
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('comcamp-theme');
          var isDark = stored ? stored === 'dark' : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (isDark) {
            document.documentElement.classList.add('dark');
            document.documentElement.setAttribute('data-theme', 'dark');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}

        document.addEventListener('astro:after-swap', function() {
          try {
            var s = localStorage.getItem('comcamp-theme');
            var d = s ? s === 'dark' : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (d) {
              document.documentElement.classList.add('dark');
              document.documentElement.setAttribute('data-theme', 'dark');
            } else {
              document.documentElement.classList.remove('dark');
              document.documentElement.setAttribute('data-theme', 'light');
            }
          } catch (e) {}
        });
      })();

      // Unregister any stale legacy service workers on port 4321
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function(registrations) {
          for (var i = 0; i < registrations.length; i++) {
            registrations[i].unregister();
          }
        });
      }
      if ('caches' in window) {
        caches.keys().then(function(names) {
          for (var i = 0; i < names.length; i++) {
            caches.delete(names[i]);
          }
        });
      }
    </script>
    <style is:inline>
      html, body {
        margin: 0;
        padding: 0;
      }
      html:not(.dark), html:not(.dark) body {
        background-color: #F9F8F4;
        color: #121316;
      }
      html.dark, html.dark body {
        background-color: #111316;
        color: #F5F4EF;
      }
    </style>
    <ClientRouter />
  </head>
  <body class:list={['min-h-dvh w-full overflow-x-clip overflow-y-auto bg-[var(--bg-canvas)] text-[var(--color-ink)] relative select-none scroll-smooth', bodyClass]}>
    <slot />
    {backToTop && <BackToTop />}
  </body>
</html>
