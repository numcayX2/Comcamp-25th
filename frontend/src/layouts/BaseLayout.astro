---
import { ClientRouter } from 'astro:transitions';
import '../styles/fonts.css';
import '../styles/global.css';
import BackToTop from '../components/BackToTop.astro';
import { REGISTRATION_OPEN_AT, formatBangkokTime, formatThaiDateFull } from '../lib/camp-facts';

interface Props {
  title?: string;
  description?: string;
  /** The floating back-to-top button collides with pages that own a sticky bottom bar (e.g. /register). */
  backToTop?: boolean;
  /** Extra class on <body> for pages that need to override the shared body defaults. */
  bodyClass?: string;
  /** Browser UI colour on mobile; match whatever sits at the top edge of the page. */
  themeColor?: string;
  /** Keep the page out of search indexes (e.g. /applicants lists minors' names). */
  noindex?: boolean;
}

const {
  title = 'ComCamp #25 // ค่ายวิทยาการคอมพิวเตอร์ มหาวิทยาลัยแม่โจ้',
  description = `เว็บไซต์รับสมัครค่าย ComCamp ครั้งที่ 25 สาขาวิทยาการคอมพิวเตอร์ คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้ (เปิดรับ ${formatThaiDateFull(REGISTRATION_OPEN_AT)} เวลา ${formatBangkokTime(REGISTRATION_OPEN_AT)} น.)`,
  backToTop = true,
  bodyClass,
  themeColor = '#F9F8F4',
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="th" class="min-h-dvh w-full overflow-x-clip overflow-y-auto scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={themeColor} />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    
    {/* Anti-FOUC instant inline theme detection & background style */}
    <script is:inline>
      (function() {
        function applyTheme(root) {
          if (!root) return;
          try {
            var stored = localStorage.getItem('comcamp-theme');
            var isDark = stored ? stored === 'dark' : (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
            if (isDark) {
              root.classList.add('dark');
              root.setAttribute('data-theme', 'dark');
            } else {
              root.classList.remove('dark');
              root.setAttribute('data-theme', 'light');
            }
          } catch (e) {}
        }

        applyTheme(document.documentElement);

        if (!window.__CC25_BASE_THEME_HOOK__) {
          window.__CC25_BASE_THEME_HOOK__ = true;
          // Apply theme to the incoming document before ClientRouter swaps DOM so Dark Mode
          // navigations never flash light or trigger a canvas background-color transition.
          document.addEventListener('astro:before-swap', function(ev) {
            if (ev && ev.newDocument) {
              applyTheme(ev.newDocument.documentElement);
            }
          });
          document.addEventListener('astro:after-swap', function() {
            applyTheme(document.documentElement);
          });
        }
      })();

      // Unregister any stale legacy service workers on port 4321
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function(registrations) {
          for (var i = 0; i < registrations.length; i++) {
            registrations[i].unregister();
          }
        });
      }
      if ('caches' in window) {
        caches.keys().then(function(names) {
          for (var i = 0; i < names.length; i++) {
            caches.delete(names[i]);
          }
        });
      }
    </script>
    <style is:inline>
      html, body {
        margin: 0;
        padding: 0;
      }
      html:not(.dark), html:not(.dark) body {
        background-color: #F9F8F4;
        color: #121316;
      }
      html.dark, html.dark body {
        background-color: #0B0F19;
        color: #F5F4EF;
      }
    </style>
    <ClientRouter />
  </head>
  <!-- No overflow-y on body: with html as the scroller, a scrolling body would trap position: sticky (site nav, admin toolbar). -->
  <body class:list={['min-h-dvh w-full overflow-x-clip bg-[var(--bg-canvas)] text-[var(--color-ink)] relative scroll-smooth', bodyClass]}>
    <slot />
    {backToTop && <BackToTop />}
  </body>
</html>
