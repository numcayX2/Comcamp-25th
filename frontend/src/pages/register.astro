---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RegisterSection } from '../components/RegisterSection';
---

<!--
  The wizard owns its own chrome (dark sidebar with the back-to-home link, theme toggle and
  stepper), so the shared SiteNav is intentionally not rendered here.
-->
<BaseLayout
  title="สมัครเข้าร่วมค่าย · ComCamp #25"
  description="ฟอร์มสมัครเข้าร่วมค่าย ComCamp ครั้งที่ 25 สาขาวิชาวิทยาการคอมพิวเตอร์ คณะวิทยาศาสตร์ มหาวิทยาลัยแม่โจ้"
  backToTop={false}
  bodyClass="rw-page"
  themeColor="#121316"
>
  <main id="main">
    <RegisterSection client:load />
  </main>
</BaseLayout>
